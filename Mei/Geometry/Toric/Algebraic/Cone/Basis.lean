module

public import Mei.Algebra.PositiveDegrees.Basis
public import Mei.Geometry.Convex.Cone.LatticePoints
public import Mei.LinearAlgebra.Basis.Integral
public import Mathlib.LinearAlgebra.Basis.VectorSpace
public import TauCeti.Geometry.Convex.Cone.Face.Simplicial

/-!
# Lattice points of cones generated by graph basis vectors

The cone generated by `(f(b j), b j)` has exactly the nonnegative integral
combinations of these vectors as lattice points. The retained second coordinate
prevents additional lattice points even when `f` has a kernel or nonprimitive
values. This identifies graph positive degrees with a saturated cone monoid.

The scalars form any linearly ordered field. The source basis images must be
linearly independent over it; they need not span the ambient space. The first
lattice map must be injective.

## References

* `PointedCone.mem_hull_image_iff_linearCombination`
* `Mei.PositiveDegrees.graph`
* `PointedCone.latticePoints_map_prod_id`
-/

public section

noncomputable section

namespace Module.Basis

variable {ι R N M V W : Type*} [Fintype ι] [Field R] [LinearOrder R] [IsStrictOrderedRing R]
  [AddCommGroup N] [AddCommGroup M] [AddCommGroup V] [Module R V] [AddCommGroup W] [Module R W]
  (b : Basis ι ℤ N) {i : N →+ V} (hi : LinearIndependent R fun a => i (b a))

include hi in
/-- The nonnegative basis monoid is precisely the lattice points of the cone
generated by the images of the integral basis vectors. -/
theorem positiveDegrees_monoid_eq_latticePoints_hull :
    b.positiveDegrees.monoid =
      (PointedCone.hull R (Set.range fun a => i (b a))).latticePoints i := by
  classical
  let C := PointedCone.hull R (Set.range fun a => i (b a))
  let L := Fintype.linearCombination R (fun a => i (b a))
  ext n
  rw [b.mem_positiveDegrees_monoid, PointedCone.mem_latticePoints]
  constructor
  · intro hn
    rw [← b.fintypeLinearCombination_repr_cast (R := R) i n, Fintype.linearCombination_apply]
    exact C.sum_mem fun a _ => PointedCone.smul_mem C
      (by exact_mod_cast hn a)
      (PointedCone.subset_hull (Set.mem_range_self a))
  · intro hx a
    rw [← Set.image_univ] at hx
    obtain ⟨c, -, hc, he⟩ := PointedCone.mem_hull_image_iff_linearCombination.mp hx
    have he' : L (fun a => c a) = i n := by
      simpa [L, Fintype.linearCombination_apply, Finsupp.linearCombination_apply,
        Finsupp.sum_fintype] using he
    have hcoords := hi.fintypeLinearCombination_injective
      (he'.trans (b.fintypeLinearCombination_repr_cast (R := R) i n).symm)
    have ha : 0 ≤ (b.repr n a : R) := by
      rw [← congrFun hcoords a]
      exact hc a
    exact_mod_cast ha

variable (j : M →+ W) (hj : Function.Injective j) (f : N →+ M)

include hi hj in
/-- The nonnegative graph monoid is precisely the lattice points of the cone
generated by the graph of an integral basis. The map `f` need not be injective. -/
theorem positiveDegrees_graph_monoid_eq_latticePoints_hull :
    (b.positiveDegrees.graph f).monoid =
      (PointedCone.hull R (Set.range fun a => (j (f (b a)), i (b a)))).latticePoints
        (j.prodMap i) := by
  let L := Fintype.linearCombination R (fun a => i (b a))
  obtain ⟨r, hr⟩ := L.exists_leftInverse_of_injective
    (LinearMap.ker_eq_bot.mpr hi.fintypeLinearCombination_injective)
  let F := (Fintype.linearCombination R (fun a => j (f (b a)))).comp r
  have hF (n : N) : F (i n) = j (f n) := by
    have hrn := LinearMap.congr_fun hr (fun a => (b.repr n a : R))
    rw [LinearMap.comp_apply, b.fintypeLinearCombination_repr_cast (R := R) i n] at hrn
    simp only [F, LinearMap.comp_apply, hrn, LinearMap.id_apply]
    exact b.fintypeLinearCombination_repr_cast (R := R) (j.comp f) n
  have hmap :
      (PointedCone.hull R (Set.range fun a => i (b a))).map
          (F.prod LinearMap.id) =
        PointedCone.hull R (Set.range fun a => (j (f (b a)), i (b a))) := by
    simp [PointedCone.map, Submodule.map_span, ← Set.range_comp, Function.comp_def, hF]
  rw [← hmap, PointedCone.latticePoints_map_prod_id _ i j f F hF hj,
    ← b.positiveDegrees_monoid_eq_latticePoints_hull hi]
  ext ⟨m, n⟩
  simp [Mei.PositiveDegrees.mem_graph_monoid, AddSubmonoid.mem_map, eq_comm]

end Module.Basis
