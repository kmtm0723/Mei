public import Mathlib.Algebra.Algebra.Rat

/-!
# Directed wall spaces for logarithmic vector fields

An integral normal `m` defines the line of formal fields `z^n ∂_m` when it
annihilates the spatial degree `ρ(n)`, and the zero submodule otherwise.
Over a rational coefficient algebra these lines are unchanged by nonzero
integral rescaling. Their logarithmic bracket has the contracted integral
normal, including when that normal is zero.

Restricting these lines to the positive tangent Lie algebra gives
`tropicalVertexWallSpaces`. Thus the formal tropical vertex algebra can supply
labels for directed scattering diagrams even when its action on a coefficient
monoid is not faithful. Zero spatial directions are retained.

The construction uses `LogarithmicVectorField.single_bracket_single` and
Mathlib's singleton-span API. The wall lines and bracket follow Mandel,
*Scattering diagrams, theta functions, and refined tropical curve counts*,
Example 2.1(i), arXiv:1503.06183v5.
-/

public section

noncomputable section

namespace Mei.LogarithmicVectorField

variable {R Γ Λ : Type*} [CommRing R] [AddCommMonoid Γ] [AddCommMonoid Λ]
  (ρ : Γ →+ Λ)

/-- The line of formal logarithmic fields with integral normal `m`, extended
by zero when the normal is not tangent to the spatial degree. -/
def wallSubmodule (n : Γ) (m : Λ →+ ℤ) : Submodule R (LogarithmicVectorField R Γ Λ ρ) :=
  if m (ρ n) = 0 then R ∙ single ρ n ((Int.castAddHom R).comp m) else ⊥

/-- Formal wall lines are determined by integral tangency and the normal generator. -/
theorem wallSubmodule_def (n : Γ) (m : Λ →+ ℤ) :
    wallSubmodule (R := R) ρ n m =
      if m (ρ n) = 0 then R ∙ single ρ n ((Int.castAddHom R).comp m) else ⊥ := (rfl)

/-- A tangent normal gives the line generated by its formal logarithmic field. -/
@[simp]
theorem wallSubmodule_of_tangent (n : Γ) (m : Λ →+ ℤ) (hm : m (ρ n) = 0) :
    wallSubmodule (R := R) ρ n m = R ∙ single ρ n ((Int.castAddHom R).comp m) := by
  simp [wallSubmodule, hm]

/-- A nontangent normal carries no formal wall fields. -/
@[simp]
theorem wallSubmodule_of_nontangent (n : Γ) (m : Λ →+ ℤ) (hm : m (ρ n) ≠ 0) :
    wallSubmodule (R := R) ρ n m = ⊥ := by
  simp [wallSubmodule, hm]

/-- Membership in a tangent wall line is a scalar-multiple equation in formal fields. -/
theorem mem_wallSubmodule_iff (n : Γ) (m : Λ →+ ℤ) (hm : m (ρ n) = 0)
    (x : LogarithmicVectorField R Γ Λ ρ) :
    x ∈ wallSubmodule ρ n m ↔ ∃ r : R, r • single ρ n ((Int.castAddHom R).comp m) = x := by
  rw [wallSubmodule_of_tangent ρ n m hm, Submodule.mem_span_singleton]

/-- Wall fields are homogeneous in their degree. -/
theorem wallSubmodule_le_grade (n : Γ) (m : Λ →+ ℤ) :
    wallSubmodule (R := R) ρ n m ≤ grade ρ n := by
  by_cases hm : m (ρ n) = 0
  · rw [wallSubmodule_of_tangent ρ n m hm, Submodule.span_singleton_le_iff_mem]
    exact (mem_grade_iff ρ n _).mpr ⟨_, rfl⟩
  · rw [wallSubmodule_of_nontangent ρ n m hm]
    exact bot_le

/-- Contracting integral normals gives the character of the formal bracket. -/
theorem single_intCast_bracket_single (n n' : Γ) (m m' : Λ →+ ℤ) :
    ⁅single ρ n ((Int.castAddHom R).comp m), single ρ n' ((Int.castAddHom R).comp m')⁆ =
      single ρ (n + n') ((Int.castAddHom R).comp (wallBracketNormal ρ n n' m m')) := by
  rw [single_bracket_single]
  congr 1
  ext v
  simp

/-- The bracket of two formal wall fields belongs to the line of the
contracted normal, also when this normal vanishes. -/
theorem lie_mem_wallSubmodule {n n' : Γ} {m m' : Λ →+ ℤ}
    {x y : LogarithmicVectorField R Γ Λ ρ}
    (hx : x ∈ wallSubmodule ρ n m) (hy : y ∈ wallSubmodule ρ n' m') :
    ⁅x, y⁆ ∈ wallSubmodule ρ (n + n') (wallBracketNormal ρ n n' m m') := by
  by_cases hm : m (ρ n) = 0
  swap
  · rw [wallSubmodule_of_nontangent ρ n m hm, Submodule.mem_bot] at hx
    simp [hx]
  by_cases hm' : m' (ρ n') = 0
  swap
  · rw [wallSubmodule_of_nontangent ρ n' m' hm', Submodule.mem_bot] at hy
    simp [hy]
  obtain ⟨r, rfl⟩ := (mem_wallSubmodule_iff ρ n m hm x).mp hx
  obtain ⟨s, rfl⟩ := (mem_wallSubmodule_iff ρ n' m' hm' y).mp hy
  have ht : wallBracketNormal ρ n n' m m' (ρ (n + n')) = 0 := by
    simp [hm, hm', mul_comm]
  rw [wallSubmodule_of_tangent ρ _ _ ht, smul_lie, lie_smul,
    single_intCast_bracket_single]
  exact Submodule.smul_mem _ _ (Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _))

variable [Algebra ℚ R]

/-- Nonzero integral rescaling preserves formal wall lines over rational algebras. -/
@[simp]
theorem wallSubmodule_rescale (n : Γ) (m : Λ →+ ℤ) (c : ℤ) (hc : c ≠ 0) :
    wallSubmodule (R := R) ρ n (c • m) = wallSubmodule ρ n m := by
  have ht : (c • m) (ρ n) = 0 ↔ m (ρ n) = 0 := by
    simp [hc]
  by_cases hm : m (ρ n) = 0
  · rw [wallSubmodule_of_tangent ρ n _ (ht.mpr hm), wallSubmodule_of_tangent ρ n m hm]
    have he : (Int.castAddHom R).comp (c • m) = (c : R) • (Int.castAddHom R).comp m := by
      ext v
      simp
    rw [he, map_smul]
    apply Submodule.span_singleton_smul_eq
    have hu : IsUnit (c : ℚ) := isUnit_iff_ne_zero.mpr (by exact_mod_cast hc)
    simpa using hu.map (algebraMap ℚ R)
  · rw [wallSubmodule_of_nontangent ρ n m hm,
      wallSubmodule_of_nontangent ρ n _ (fun h => hm (ht.mp h))]

end Mei.LogarithmicVectorField

namespace Mei

variable {R Γ Λ : Type*} [CommRing R] [Algebra ℚ R]
  [AddCommMonoid Γ] [AddCommMonoid Λ] (d : PositiveDegrees Γ) (ρ : Γ →+ Λ)

/-- Directed wall spaces of the positive tangent logarithmic Lie algebra.
They are the formal integral-normal lines restricted to the positive algebra. -/
def tropicalVertexWallSpaces : DirectedWallSpaces ρ (tropicalVertexGrading (R := R) d ρ) where
  wall n m := (LogarithmicVectorField.wallSubmodule ρ n m).comap
    (tropicalVertexLieAlgebra d ρ).incl.toLinearMap
  wall_le_piece n m := by
    rw [tropicalVertexGrading_def]
    exact Submodule.comap_mono (LogarithmicVectorField.wallSubmodule_le_grade ρ n m)
  zero_normal n := by
    have hzero : LogarithmicVectorField.wallSubmodule (R := R) ρ n 0 = ⊥ := by simp
    rw [hzero]
    exact LinearMap.ker_eq_bot.mpr Subtype.val_injective
  nontangent n m hm := by
    rw [LogarithmicVectorField.wallSubmodule_of_nontangent ρ n m hm]
    exact LinearMap.ker_eq_bot.mpr Subtype.val_injective
  rescale n m c hc := by rw [LogarithmicVectorField.wallSubmodule_rescale ρ n m c hc]
  bracket_mem hx hy := LogarithmicVectorField.lie_mem_wallSubmodule ρ hx hy

/-- Membership in a positive wall space is membership of the underlying formal field. -/
@[simp]
theorem mem_tropicalVertexWallSpaces_iff (n : Γ) (m : Λ →+ ℤ)
    (x : tropicalVertexLieAlgebra (R := R) d ρ) :
    x ∈ (tropicalVertexWallSpaces d ρ).wall n m ↔
      (x : LogarithmicVectorField R Γ Λ ρ) ∈ LogarithmicVectorField.wallSubmodule ρ n m :=
  Iff.rfl

/-- A tangent positive wall space consists exactly of scalar multiples of the
integral-normal generator, with equality in the ambient formal algebra. -/
theorem mem_tropicalVertexWallSpaces_iff_of_tangent (n : Γ) (m : Λ →+ ℤ)
    (hm : m (ρ n) = 0) (x : tropicalVertexLieAlgebra (R := R) d ρ) :
    x ∈ (tropicalVertexWallSpaces d ρ).wall n m ↔
      ∃ r : R, r • LogarithmicVectorField.single ρ n ((Int.castAddHom R).comp m) =
        (x : LogarithmicVectorField R Γ Λ ρ) := by
  rw [mem_tropicalVertexWallSpaces_iff,
    LogarithmicVectorField.mem_wallSubmodule_iff ρ n m hm]

/-- In every nonzero allowed degree, restriction to the positive tangent algebra
retains the entire formal wall line. -/
theorem map_tropicalVertexWallSpaces_wall {n : Γ} (hn : n ∈ d.monoid) (hne : n ≠ 0)
    (m : Λ →+ ℤ) :
    ((tropicalVertexWallSpaces (R := R) d ρ).wall n m).map
      (tropicalVertexLieAlgebra d ρ).incl.toLinearMap =
      LogarithmicVectorField.wallSubmodule ρ n m := by
  apply le_antisymm
  · rintro x ⟨y, hy, rfl⟩
    exact (mem_tropicalVertexWallSpaces_iff d ρ n m y).mp hy
  · intro x hx
    have hpos : x ∈ tropicalVertexLieAlgebra d ρ := by
      by_cases hm : m (ρ n) = 0
      · obtain ⟨r, rfl⟩ := (LogarithmicVectorField.mem_wallSubmodule_iff ρ n m hm x).mp hx
        exact Submodule.smul_mem _ r
          (single_mem_tropicalVertexLieAlgebra d ρ hn hne _ (by simp [hm]))
      · rw [LogarithmicVectorField.wallSubmodule_of_nontangent ρ n m hm,
          Submodule.mem_bot] at hx
        simp [hx]
    exact ⟨⟨x, hpos⟩, (mem_tropicalVertexWallSpaces_iff d ρ n m ⟨x, hpos⟩).mpr hx, rfl⟩

end Mei
