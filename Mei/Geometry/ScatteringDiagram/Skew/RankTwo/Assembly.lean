module

public import Mei.Algebra.Lie.Skew.Factorization.Sorted
public import Mei.Geometry.ScatteringDiagram.Skew.RankTwo.Ordering
public import Mei.Geometry.ScatteringDiagram.Skew.StandardPlane.Order

/-!
# Positive ordering of rank-two products to all orders

Let `x, y` be nonzero allowed degrees of a skew lattice datum `D`, with any value of the pairing
`{x, y}`, including zero. The ordered factorizations of
`Mei.SkewLatticeDatum.exists_isChain_projection_prod_pow_eq` are finite-order statements, with a
list of unit factors chosen separately at every order. Here they are assembled into one
factorization of the completed product.

Index the nonzero allowed degrees of the additive monoid generated by `x` and `y` injectively by
a linearly ordered type `ι`, `i ↦ mᵢ`, such that `i ≤ j` whenever `{mᵢ, mⱼ} > 0`. Then
`{mᵢ, mⱼ} ≥ 0` whenever `i < j`, so every product over `ι` in this order is ordered. Every finite
product of normalized positive factors `Ψ[m]^{sκ(m)}`, `s ∈ ℕ`, at degrees of the monoid equals,
for exactly one family of natural numbers `s'`, the ordered product
`∏ᵢ Ψ[mᵢ]^{s'(i) κ(mᵢ)}` over `ι` (`Mei.SkewLatticeDatum.orderedNormalizedProd`,
`Mei.SkewLatticeDatum.existsUnique_orderedNormalizedProd_eq`). Only finitely many factors are
nonidentity at every order (`hasFiniteSupport_dilogPow`), and the truncation of the product at
order `k` is the finite ordered product of its factors of degree at most `k`
(`projection_orderedNormalizedProd`). These truncations are ordered factorizations by
normalized positive factors at every finite order, compatible under truncation.

Such an indexing exists for every value of the pairing:

* if `{x, y} > 0`, the plane degrees `(a, b) ↦ a x + b y` in the angular order of the standard
  plane (`existsUnique_orderedNormalizedProd_planeDegree_eq`); if `{x, y} < 0`, exchange `x`
  and `y`;
* if `{x, y} = 0`, every injective indexing in every linear order, since the form vanishes on
  the monoid (`existsUnique_orderedNormalizedProd_eq_of_form_eq_zero`).

A worked instance, the pentagon identity read as the ordered factorization of `Ψ[y] Ψ[x]` for
`{x, y} = 1`, is in `Mei.Geometry.ScatteringDiagram.Skew.RankTwo.Examples`.

## References

* Tomoki Nakanishi, *Cluster algebras and scattering diagrams, Part III*, §5.2, the ordering of
  rank-two products of dilogarithm elements to all orders (arXiv:2111.00800v6).
* Gross–Hacking–Keel–Kontsevich, *Canonical bases for cluster algebras*, Theorem 1.13 and
  Appendix C.3 (arXiv:1411.1394v2).
-/

public section

noncomputable section

namespace Mei.SkewLatticeDatum

open StandardPlane PowerSeries

variable {N : Type*} [AddCommGroup N] (D : SkewLatticeDatum N)
  (d : PositiveDegrees D.unfrozen) [DecidableEq D.unfrozen]

local notation "βℚ" => D.coefficientForm ℚ
local notation "hβℚ" => D.isAlt_coefficientForm ℚ
local notation "κ" => D.sublattice.toAddSubgroup.rayIndex

section Indexed

variable {D d} {ι : Type*} {δ : ι → D.NonzeroDegree d}

/-- A family of rational powers `Ψ[δ i]^{c i}` of dilogarithm labels at distinct nonzero allowed
degrees has only finitely many nonidentity factors at every order. -/
theorem hasFiniteSupport_dilogPow (hδ : Function.Injective δ) (c : ι → ℚ) :
    CompletedGroup.HasFiniteSupport fun i => D.dilogPow d (δ i) (c i) := by
  simpa only [dilogPow_def] using SkewLieAlgebra.hasFiniteSupport_rayExp_smul_negDilogNeg βℚ hβℚ
    (fun i => (δ i).1) (fun i => (δ i).2.1) (fun i => (δ i).2.2)
    (Subtype.val_injective.comp hδ) c

variable [Module.Free ℤ N] [LinearOrder ι]

/-- The ordered product `∏ᵢ Ψ[δ i]^{s(i) κ(δ i)}` of normalized positive factors at distinct
nonzero allowed degrees `δ i`, over the linearly ordered index type, smallest index leftmost. -/
def orderedNormalizedProd (hδ : Function.Injective δ) (s : ι → ℕ) :
    d.completedBCHGroup (SkewLieAlgebra.positiveGrading βℚ hβℚ d) :=
  CompletedGroup.orderedProd (fun i => D.dilogPow d (δ i) (s i * κ ((δ i).1 : N)))
    (hasFiniteSupport_dilogPow hδ fun i => s i * κ ((δ i).1 : N))

/-- Unfolds `orderedNormalizedProd`, which holds by definition. -/
theorem orderedNormalizedProd_def (hδ : Function.Injective δ) (s : ι → ℕ) :
    orderedNormalizedProd hδ s =
      CompletedGroup.orderedProd (fun i => D.dilogPow d (δ i) (s i * κ ((δ i).1 : N)))
        (hasFiniteSupport_dilogPow hδ fun i => s i * κ ((δ i).1 : N)) := (rfl)

/-- **Compatibility under truncation.** At order `k`, the ordered product
`∏ᵢ Ψ[δ i]^{s(i) κ(δ i)}` is the finite product, in the order of `ι`, of the powers
`Ψ[δ i]^{s(i) κ(δ i)}` of unit factors over any finite set `S` of indices containing every `i`
with `deg (δ i) ≤ k`. -/
theorem projection_orderedNormalizedProd (hδ : Function.Injective δ) (s : ι → ℕ) (k : ℕ)
    (S : Finset ι) (hS : ∀ i, d.degree (δ i).1 ≤ k → i ∈ S) :
    CompletedGroup.projection k (orderedNormalizedProd hδ s) =
      CompletedGroup.projection k (S.sort.map fun i => D.unitFactor d (δ i) ^ s i).prod := by
  rw [orderedNormalizedProd_def,
    CompletedGroup.projection_orderedProd_of_support _ _ k S fun i hi => hS i ?_,
    map_list_prod, List.map_map, Function.comp_def]
  · simp only [dilogPow_natCast_mul, unitFactor_def]
  · by_contra hik
    refine hi ?_
    rw [dilogPow_def]
    exact SkewLieAlgebra.projection_rayExp_eq_one_of_lt _ _ _ _ _ (by omega)

variable [Module.Free ℤ D.sublattice] (x y : D.NonzeroDegree d)

omit [LinearOrder ι] in
/-- At every order, a product of normalized positive factors at degrees of the additive monoid
generated by `x` and `y` agrees with a product of unit factors `Ψ[δ i]^{κ(δ i)}` over a list of
indices in which `{δ i, δ j} ≥ 0` whenever `i` precedes `j`, provided `δ` indexes every nonzero
allowed degree of the monoid. -/
theorem exists_pairwise_projection_prod_unitFactor_eq
    (hrange : ∀ m : D.NonzeroDegree d, m.1 ∈ AddSubmonoid.closure {x.1, y.1} → m ∈ Set.range δ)
    (l : List (D.NonzeroDegree d × ℕ))
    (hl : ∀ p ∈ l, (p.1 : D.unfrozen) ∈ AddSubmonoid.closure {x.1, y.1}) (k : ℕ) :
    ∃ L : List ι, L.Pairwise (fun i j => 0 ≤ βℚ (δ i).1 (δ j).1) ∧
      CompletedGroup.projection k (L.map fun i => D.unitFactor d (δ i)).prod =
        CompletedGroup.projection k
          (l.map fun p => D.dilogPow d p.1 (p.2 * κ (p.1 : N))).prod := by
  obtain ⟨l', hmem, hchain, -, hprod⟩ := D.exists_isChain_projection_prod_pow_eq d x y k l hl
  obtain ⟨i₀, -⟩ := hrange x (AddSubmonoid.subset_closure (Set.mem_insert _ _))
  have : Nonempty ι := ⟨i₀⟩
  have hpw : l'.Pairwise fun a b => 0 ≤ βℚ a.1 b.1 :=
    LinearMap.IsAlt.pairwise_of_isChain_of_mem_closure_pair hβℚ Subtype.val hmem
      (fun m _ => m.2.2) hchain
  -- Lift the ordered unit factors to indices.
  obtain ⟨L, rfl⟩ : ∃ L : List ι, L.map δ = l' := ⟨l'.map (Function.invFun δ), by
    rw [List.map_map]
    exact (List.map_congr_left fun m hm => Function.invFun_eq (hrange m (hmem m hm))).trans
      (List.map_id l')⟩
  rw [List.map_map, Function.comp_def] at hprod
  exact ⟨L, List.pairwise_map.mp hpw, hprod⟩

/-- **Positive ordering of rank-two products to all orders.** Let `x, y` be nonzero allowed
degrees, with any value of `{x, y}`, and let `δ` index the nonzero allowed degrees of the additive
monoid generated by `x` and `y` injectively by a linearly ordered type, so that `i ≤ j` whenever
`{δ i, δ j} > 0`; indices of degrees outside the monoid are allowed. A finite product of
normalized positive factors `Ψ[m]^{sκ(m)}`, `s ∈ ℕ`, at degrees of the monoid then equals, for
exactly one family of natural numbers `s'`, the ordered product `∏ᵢ Ψ[δ i]^{s'(i) κ(δ i)}` over
`ι` (`orderedNormalizedProd`). -/
theorem existsUnique_orderedNormalizedProd_eq (hδ : Function.Injective δ)
    (hord : ∀ i j, 0 < βℚ (δ i).1 (δ j).1 → i ≤ j)
    (hrange : ∀ m : D.NonzeroDegree d, m.1 ∈ AddSubmonoid.closure {x.1, y.1} → m ∈ Set.range δ)
    (l : List (D.NonzeroDegree d × ℕ))
    (hl : ∀ p ∈ l, (p.1 : D.unfrozen) ∈ AddSubmonoid.closure {x.1, y.1}) :
    ∃! s : ι → ℕ, orderedNormalizedProd hδ s =
      (l.map fun p => D.dilogPow d p.1 (p.2 * κ (p.1 : N))).prod := by
  have hfact (k : ℕ) : ∃ L : List ι, L.Pairwise (fun i j => 0 ≤ βℚ (δ i).1 (δ j).1) ∧
      CompletedGroup.projection k (L.map fun i => SkewLieAlgebra.rayExp βℚ hβℚ (δ i).2.1
          (δ i).2.2 (κ ((δ i).1 : N) • negDilogNeg ℚ)).prod =
        CompletedGroup.projection k
          (l.map fun p => D.dilogPow d p.1 (p.2 * κ (p.1 : N))).prod := by
    simpa only [unitFactor_def, dilogPow_def] using
      exists_pairwise_projection_prod_unitFactor_eq x y hrange l hl k
  simpa only [orderedNormalizedProd_def, dilogPow_def, nsmul_eq_mul] using
    SkewLieAlgebra.existsUnique_orderedProd_rayExp_nsmul_smul_negDilogNeg βℚ hβℚ
      (fun i => (δ i).1) (fun i => (δ i).2.1) (fun i => (δ i).2.2)
      (Subtype.val_injective.comp hδ) hord (fun i => κ ((δ i).1 : N))
      (fun i => (D.rayIndex_unfrozen_pos (δ i).2.2).ne') _ hfact

/-- **Positive ordering for a vanishing pairing, to all orders.** If `{x, y} = 0`, the conclusion
of `existsUnique_orderedNormalizedProd_eq` holds for every injective indexing `δ` of the nonzero
allowed degrees of the monoid generated by `x` and `y` by degrees of that monoid, in every linear
order. -/
theorem existsUnique_orderedNormalizedProd_eq_of_form_eq_zero (h : βℚ x.1 y.1 = 0)
    (hδ : Function.Injective δ) (hmem : ∀ i, (δ i).1 ∈ AddSubmonoid.closure {x.1, y.1})
    (hrange : ∀ m : D.NonzeroDegree d, m.1 ∈ AddSubmonoid.closure {x.1, y.1} → m ∈ Set.range δ)
    (l : List (D.NonzeroDegree d × ℕ))
    (hl : ∀ p ∈ l, (p.1 : D.unfrozen) ∈ AddSubmonoid.closure {x.1, y.1}) :
    ∃! s : ι → ℕ, orderedNormalizedProd hδ s =
      (l.map fun p => D.dilogPow d p.1 (p.2 * κ (p.1 : N))).prod :=
  existsUnique_orderedNormalizedProd_eq x y hδ (fun i j hij => absurd
    (D.coefficientForm_eq_zero_of_mem_closure h (hmem i) (hmem j)) hij.ne') hrange l hl

end Indexed

variable [Module.Free ℤ N] [Module.Free ℤ D.sublattice] (x y : D.NonzeroDegree d)

/-- **Positive ordering for a positive pairing, to all orders.** If `{x, y} > 0`, a finite
product of normalized positive factors `Ψ[m]^{sκ(m)}`, `s ∈ ℕ`, at degrees of the additive
monoid generated by `x` and `y` equals, for exactly one family of natural numbers `s'` on the
plane degrees `(a, b)`, the ordered product `∏_{(a, b)} Ψ[a x + b y]^{s'(a, b) κ(a x + b y)}`
in the angular order of the plane (`Mei.StandardPlane.PlaneDegree.key`). For `{x, y} < 0`,
exchange `x` and `y`. -/
theorem existsUnique_orderedNormalizedProd_planeDegree_eq (hxy : 0 < βℚ x.1 y.1)
    (l : List (D.NonzeroDegree d × ℕ))
    (hl : ∀ p ∈ l, (p.1 : D.unfrozen) ∈ AddSubmonoid.closure {x.1, y.1}) :
    ∃! s : PlaneDegree (D.planeWeight d x y) → ℕ,
      orderedNormalizedProd (D.planeDegree_injective d x y hxy.ne') s =
        (l.map fun p => D.dilogPow d p.1 (p.2 * κ (p.1 : N))).prod :=
  existsUnique_orderedNormalizedProd_eq x y (D.planeDegree_injective d x y hxy.ne')
    (fun q q' h => PlaneDegree.le_of_coefficientForm_pos (pos_of_mul_pos_right
      ((D.coefficientForm_planeDegree d x y q q').symm.trans_gt h) hxy.le))
    (fun m hm => D.exists_planeDegree_eq d x y m hm) l hl

end Mei.SkewLatticeDatum
