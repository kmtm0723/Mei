/-!
# The plane spanned by two allowed degrees

Two nonzero allowed degrees `x, y` of a skew lattice datum `D` give the additive map
`(a, b) ↦ a x + b y` from the lattice of the standard plane. With the weights
`(deg x, deg y)` it is a positive degree map from the first quadrant with the same cutoffs, and
it multiplies the skew form by `{x, y}`. When `{x, y} ≠ 0` it therefore carries the graded Lie
algebra of the plane to that of `D` by `X_n ↦ {x, y}⁻¹ X_{a x + b y}`, and at every finite order
the label `Ψ[n]^c` of the plane to `Ψ[a x + b y]^{c / {x, y}}`
(`projection_prod_planeDegree_eq`).

For a plane degree `q = (a, b)`, the exponent `{x, y} κ(a x + b y)` of the unit factor of
`a x + b y` in `D` is a natural-number multiple of the plane exponent `κ(q) = 1 / gcd(a, b)`
(`exists_natCast_mul_rayIndex_eq`), since the integers `κ(n) {x, n} = κ(n) b {x, y}` and
`κ(n) {y, n} = -κ(n) a {x, y}` generate the ideal generated by `κ(n) {x, y} gcd(a, b)`
(`exists_natCast_eq_mul_gcd`).
-/

public section

noncomputable section

universe u

namespace Mei.SkewLatticeDatum

open StandardPlane PowerSeries

variable {N : Type*} [AddCommGroup N] (D : SkewLatticeDatum N)
  (d : PositiveDegrees D.unfrozen) (x y : D.NonzeroDegree d)

local notation "βℚ" => D.coefficientForm ℚ
local notation "hβℚ" => D.isAlt_coefficientForm ℚ
local notation "κ" => D.sublattice.toAddSubgroup.rayIndex

/-- The weights `(deg x, deg y)` of the plane spanned by two nonzero allowed degrees. -/
def planeWeight : Weight where
  fst := (d.degree x.1).toNat
  snd := (d.degree y.1).toNat
  fst_pos := by have := d.degree_pos x.2.1 x.2.2; omega
  snd_pos := by have := d.degree_pos y.2.1 y.2.2; omega

/-- The first weight of the plane spanned by `x, y` is the degree of `x`. -/
@[simp]
theorem planeWeight_fst : (D.planeWeight d x y).fst = (d.degree x.1).toNat := (rfl)

/-- The second weight of the plane spanned by `x, y` is the degree of `y`. -/
@[simp]
theorem planeWeight_snd : (D.planeWeight d x y).snd = (d.degree y.1).toNat := (rfl)

/-- The additive map `(a, b) ↦ a x + b y` from the lattice of the standard plane. -/
def planeHom : Γ →+ D.unfrozen where
  toFun v := v.1.1 • x.1 + v.1.2 • y.1
  map_zero' := by simp
  map_add' v v' := by
    simp only [AddMemClass.coe_add, Prod.fst_add, Prod.snd_add, add_smul]
    abel

/-- Unfolds `planeHom`, which holds by definition. -/
@[simp]
theorem planeHom_apply (v : Γ) : D.planeHom d x y v = v.1.1 • x.1 + v.1.2 • y.1 := (rfl)

/-- The first quadrant is carried into the allowed monoid. -/
theorem planeHom_mem {v : Γ} (hv : v ∈ (plane (D.planeWeight d x y)).monoid) :
    D.planeHom d x y v ∈ d.monoid := by
  rw [mem_plane_monoid] at hv
  rw [planeHom_apply, ← Int.toNat_of_nonneg hv.1, ← Int.toNat_of_nonneg hv.2, natCast_zsmul,
    natCast_zsmul]
  exact add_mem (d.monoid.nsmul_mem x.2.1 _) (d.monoid.nsmul_mem y.2.1 _)

/-- The map `(a, b) ↦ a x + b y` carries the weighted degree of the plane to the degree of `d`. -/
theorem degree_planeHom (v : Γ) :
    d.degree (D.planeHom d x y v) = (plane (D.planeWeight d x y)).degree v := by
  rw [planeHom_apply, map_add, map_zsmul, map_zsmul, plane_degree, planeWeight_fst,
    planeWeight_snd, Int.toNat_of_nonneg (d.degree_nonneg x.2.1),
    Int.toNat_of_nonneg (d.degree_nonneg y.2.1)]
  ring

/-- The positive degree map `(a, b) ↦ a x + b y` from the plane with the weights
`(deg x, deg y)`, with the same cutoff. -/
def planeMap : PositiveDegreeMap (plane (D.planeWeight d x y)) d :=
  PositiveDegreeMap.ofBound (D.planeHom d x y) (fun _ hv => D.planeHom_mem d x y hv) 1
    (fun v _ => by rw [Nat.cast_one, one_mul, degree_planeHom])

/-- The positive degree map `planeMap` is the additive map `planeHom`. -/
@[simp]
theorem planeMap_apply (v : Γ) : D.planeMap d x y v = D.planeHom d x y v :=
  PositiveDegreeMap.ofBound_apply _ _ _ _ v

/-- The cutoff modulus of `planeMap` is at most the identity. -/
theorem planeMap_modulus_le (k : ℕ) : (D.planeMap d x y).modulus k ≤ k := by
  rw [planeMap, PositiveDegreeMap.ofBound_modulus]
  omega

/-- The nonzero allowed degree `a x + b y` of a plane degree `(a, b)`. -/
def planeDegree (q : PlaneDegree (D.planeWeight d x y)) : D.NonzeroDegree d :=
  ⟨D.planeMap d x y q.vec, (D.planeMap d x y).map_mem q.mem,
    (D.planeMap d x y).map_ne_zero q.mem q.ne_zero⟩

/-- The underlying vector of `planeDegree q` is the image of `q` under `planeHom`. -/
@[simp]
theorem coe_planeDegree (q : PlaneDegree (D.planeWeight d x y)) :
    (D.planeDegree d x y q : D.unfrozen) = D.planeHom d x y q.vec := by
  simp [planeDegree]

/-- The degrees `a x + b y` lie in the additive monoid generated by `x` and `y`. -/
theorem planeDegree_mem_closure (q : PlaneDegree (D.planeWeight d x y)) :
    (D.planeDegree d x y q : D.unfrozen) ∈ AddSubmonoid.closure {x.1, y.1} := by
  have h1 : 0 ≤ q.vec.1.1 := q.fst_nonneg
  have h2 : 0 ≤ q.vec.1.2 := q.snd_nonneg
  rw [coe_planeDegree, planeHom_apply, ← Int.toNat_of_nonneg h1, ← Int.toNat_of_nonneg h2,
    natCast_zsmul, natCast_zsmul]
  exact (AddSubmonoid.mem_closure_pair _ _ _).mpr ⟨_, _, rfl⟩

/-- Every allowed degree `a x + b y` with `a, b ∈ ℕ` comes from a plane degree. -/
theorem exists_planeDegree_eq (m : D.NonzeroDegree d)
    (hm : (m : D.unfrozen) ∈ AddSubmonoid.closure {x.1, y.1}) :
    ∃ q : PlaneDegree (D.planeWeight d x y), D.planeDegree d x y q = m := by
  obtain ⟨a, b, hab⟩ := (AddSubmonoid.mem_closure_pair _ _ _).mp hm
  have hq : D.planeHom d x y ⟨((a : ℤ), (b : ℤ)), mem_unfrozen _⟩ = m.1 := by
    rw [planeHom_apply, ← hab]
    simp
  refine ⟨⟨⟨((a : ℤ), (b : ℤ)), mem_unfrozen _⟩, mem_plane_monoid.mpr ⟨by simp, by simp⟩,
    fun h => m.2.2 ?_⟩, Subtype.ext ?_⟩
  · rw [← hq, h, map_zero]
  · rw [coe_planeDegree]
    exact hq

/-- The degree of `a x + b y` in `d` is the weighted degree of the plane degree `(a, b)`. -/
theorem degree_planeDegree (q : PlaneDegree (D.planeWeight d x y)) :
    d.degree (D.planeDegree d x y q).1 = q.deg := by
  rw [coe_planeDegree, degree_planeHom, ← PlaneDegree.deg_eq_degree]

/-- The map `(a, b) ↦ a x + b y` multiplies the skew form by `{x, y}`. -/
theorem coefficientForm_planeHom (v v' : Γ) :
    βℚ (D.planeHom d x y v) (D.planeHom d x y v') =
      βℚ x.1 y.1 * E.coefficientForm ℚ v v' := by
  rw [planeHom_apply, planeHom_apply, LinearMap.IsAlt.apply_zsmul_add_zsmul hβℚ, zsmul_eq_mul,
    StandardPlane.coefficientForm_apply, mul_comm]

/-- The skew form of two degrees `a x + b y` is `{x, y}` times that of `(a, b)`. -/
theorem coefficientForm_planeDegree (q q' : PlaneDegree (D.planeWeight d x y)) :
    βℚ (D.planeDegree d x y q).1 (D.planeDegree d x y q').1 =
      βℚ x.1 y.1 * E.coefficientForm ℚ q.vec q'.vec := by
  rw [coe_planeDegree, coe_planeDegree, coefficientForm_planeHom]

section Transport

/-- The skew form of the plane is `{x, y}⁻¹` times that of `D` on the images. -/
theorem coefficientForm_eq_inv_mul_planeMap (hxy : βℚ x.1 y.1 ≠ 0) (n m : Γ) :
    E.coefficientForm ℚ n m =
      (βℚ x.1 y.1)⁻¹ * βℚ (D.planeMap d x y n) (D.planeMap d x y m) := by
  rw [planeMap_apply, planeMap_apply, coefficientForm_planeHom, ← mul_assoc,
    inv_mul_cancel₀ hxy, one_mul]

variable [DecidableEq D.unfrozen]

/-- The group map at order `k` carrying the completed group of the plane to that of `D`, induced
by `X_n ↦ {x, y}⁻¹ X_{a x + b y}`. -/
def planeTransport (hxy : βℚ x.1 y.1 ≠ 0) (k : ℕ) :=
  ((SkewLieAlgebra.gradedMap (E.coefficientForm ℚ) (E.isAlt_coefficientForm ℚ) βℚ hβℚ
          (βℚ x.1 y.1)⁻¹ (D.planeMap d x y)
          (D.coefficientForm_eq_inv_mul_planeMap d x y hxy)).truncatedMap k
        (D.planeMap_modulus_le d x y k)).bchGroupMap

/-- The finite-order projection of a ray label of the plane, carried to `D` by the map
`(a, b) ↦ a x + b y`, is the projection of the ray label of the image degree with exponent divided
by `{x, y}`. -/
theorem map_projection_dilogPow (hxy : βℚ x.1 y.1 ≠ 0) (k : ℕ)
    (q : PlaneDegree (D.planeWeight d x y)) (c : ℚ) :
    D.planeTransport d x y hxy k
        (CompletedGroup.projection k (StandardPlane.dilogPow q c)) =
      CompletedGroup.projection k
        (D.dilogPow d (D.planeDegree d x y q) ((βℚ x.1 y.1)⁻¹ * c)) := by
  rw [planeTransport, StandardPlane.dilogPow_def, dilogPow_def, mul_smul]
  exact SkewLieAlgebra.truncatedMap_gradedMap_projection_rayExp (E.coefficientForm ℚ)
    (E.isAlt_coefficientForm ℚ) βℚ hβℚ (βℚ x.1 y.1)⁻¹ (D.planeMap d x y)
    (D.coefficientForm_eq_inv_mul_planeMap d x y hxy) q.mem q.ne_zero (c • negDilogNeg ℚ) k k
    (D.planeMap_modulus_le d x y k)

/-- **Transport of identities between ray labels.** An identity at order `k` between products of
ray labels `Ψ[δ i]^{c i}` of the plane gives the identity between the products of the ray labels
`Ψ[δ i]^{c i / {x, y}}` of `D`, at the degrees `a x + b y` of the plane degrees `(a, b)`. -/
theorem projection_prod_planeDegree_eq (hxy : βℚ x.1 y.1 ≠ 0) (k : ℕ) {ι ι' : Type u}
    {I : List ι} {δ : ι → PlaneDegree (D.planeWeight d x y)} {c : ι → ℚ}
    {J : List ι'} {δ' : ι' → PlaneDegree (D.planeWeight d x y)} {c' : ι' → ℚ}
    (h : CompletedGroup.projection k (I.map fun i => StandardPlane.dilogPow (δ i) (c i)).prod =
      CompletedGroup.projection k (J.map fun i => StandardPlane.dilogPow (δ' i) (c' i)).prod) :
    CompletedGroup.projection k
        (I.map fun i => D.dilogPow d (D.planeDegree d x y (δ i)) ((βℚ x.1 y.1)⁻¹ * c i)).prod =
      CompletedGroup.projection k
        (J.map fun i => D.dilogPow d (D.planeDegree d x y (δ' i))
          ((βℚ x.1 y.1)⁻¹ * c' i)).prod := by
  let ψ := D.planeTransport d x y hxy k
  have key {α : Type u} (L : List α) (δ : α → PlaneDegree (D.planeWeight d x y)) (c : α → ℚ) :
      ψ (CompletedGroup.projection k (L.map fun i => StandardPlane.dilogPow (δ i) (c i)).prod) =
      CompletedGroup.projection k
        (L.map fun i => D.dilogPow d (D.planeDegree d x y (δ i)) ((βℚ x.1 y.1)⁻¹ * c i)).prod := by
    induction L with
    | nil =>
      simp only [List.map_nil, List.prod_nil, map_one (CompletedGroup.projection k)]
      exact map_one ψ
    | cons i L ih =>
      simp only [List.map_cons, List.prod_cons, map_mul (CompletedGroup.projection k)]
      exact (map_mul ψ _ _).trans
        (congrArg₂ (· * ·) (D.map_projection_dilogPow d x y hxy k (δ i) (c i)) ih)
  exact (key I δ c).symm.trans ((congrArg ψ h).trans (key J δ' c'))

end Transport

section Exponent

variable [Module.Free ℤ N]

/-- **Integrality of the exponents of the normalized factors of `D` on the plane of `x, y`.**
If `{x, y} > 0`, the exponent `{x, y} κ(a x + b y)` of the unit factor of the degree `a x + b y`
is a natural-number multiple of the unit exponent `κ(a, b) = 1 / gcd(a, b)` of the plane degree
`(a, b)`. -/
theorem exists_natCast_mul_rayIndex_eq (hxy : 0 < βℚ x.1 y.1)
    (q : PlaneDegree (D.planeWeight d x y)) :
    ∃ z : ℕ, (z : ℚ) * rayIndex q.vec = βℚ x.1 y.1 * κ (D.planeDegree d x y q).1 := by
  set n : D.NonzeroDegree d := D.planeDegree d x y q with hn
  -- The integers `κ(n) {x, n} = κ(n) b {x, y}` and `κ(n) {y, n} = -κ(n) a {x, y}`.
  obtain ⟨k₁, hk₁⟩ := D.exists_int_eq_rayIndex_mul_form n.1.2 x.1
  obtain ⟨k₂, hk₂⟩ := D.exists_int_eq_rayIndex_mul_form n.1.2 y.1
  have e₁ : D.form x.1 n.1 = q.snd * D.form x.1 y.1 := by
    simp [hn, coe_planeDegree]
  have e₂ : D.form y.1 n.1 = -q.fst * D.form x.1 y.1 := by
    simp [hn, coe_planeDegree, D.form_swap y.1 x.1]
  have hn0 : (n.1 : N) ≠ 0 := fun h => n.2.2 (Subtype.ext h)
  have hκ : 0 < κ (n.1 : N) := AddSubgroup.rayIndex_pos _ hn0
  have hg : 0 < Int.gcd q.fst q.snd := Int.gcd_pos_iff.mpr (by
    by_contra h
    push Not at h
    exact q.ne_zero (Subtype.ext (Prod.ext h.1 h.2)))
  have hform : βℚ x.1 y.1 = D.form x.1 y.1 := by
    simp [D.coefficientForm_apply]
  rw [hform] at hxy ⊢
  have h₁ : κ (n.1 : N) * D.form x.1 y.1 * q.snd = k₁ := by
    rw [← hk₁, e₁]
    ring
  have h₂ : κ (n.1 : N) * D.form x.1 y.1 * q.fst = -k₂ := by
    rw [e₂] at hk₂
    linear_combination -hk₂
  obtain ⟨z, hz⟩ := Mei.exists_natCast_eq_mul_gcd (mul_pos hκ hxy) hg h₁ h₂
  refine ⟨z, ?_⟩
  have hg' : (Int.gcd q.fst q.snd : ℚ) ≠ 0 := by exact_mod_cast hg.ne'
  rw [rayIndex_eq_inv_gcd q.ne_zero, hz]
  field_simp

end Exponent

end Mei.SkewLatticeDatum
