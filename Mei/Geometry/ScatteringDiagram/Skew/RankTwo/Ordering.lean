module

public import Mei.Geometry.ScatteringDiagram.Skew.RankTwo.Embedding
public import Mei.Geometry.ScatteringDiagram.Skew.RankTwo.Regroup

/-!
# Positive ordering of rank-two products of normalized positive factors

Let `D` be a skew lattice datum with positive degrees `d`, and let `x, y` be nonzero allowed
degrees. At every finite order `k`, a finite product of normalized positive factors
`Ψ[m]^{sκ(m)}`, `s ∈ ℕ`, at degrees `m` of the additive monoid generated by `x` and `y` agrees
with a product of unit factors `Ψ[m']^{κ(m')}` of degrees `m'` of the same monoid, all of weighted
degree at most `k`, whose adjacent pairings are nonnegative, `{m', m''} ≥ 0`
(`exists_isChain_projection_prod_pow_eq`). Here `κ` is the ray index of `N°` and the skew form
may be degenerate or zero.

If `{x, y} = 0` all pairings in the monoid vanish, so the product is already ordered. If
`{x, y} ≠ 0`, reorder `x, y` so that `{x, y} > 0` and carry the ordering of the standard plane
(`Mei.StandardPlane.exists_isChain_projection_prod_pow_eq`) along `(a, b) ↦ a x + b y`. The
plane factors have the exponents `{x, y} s κ(a x + b y)`, which are integer multiples of the plane
unit exponents (`exists_natCast_mul_rayIndex_eq`), and their output goes back to `D` with the
exponents `κ(a, b) / {x, y}`, which need not be unit exponents of `D`. These regroup into unit
factors of `D` because the original product acts integrally on the principal coefficients and
the output is sorted (`exists_nodup_prod_eq_and_intCast_mul_rayIndex_of_isChain`).

## References

* Tomoki Nakanishi, *Cluster algebras and scattering diagrams, Part III*, §5.2, the ordering of
  rank-two products of dilogarithm elements and the integrality of the exponents of the ordered
  product (arXiv:2111.00800v6).
-/

public section

noncomputable section

universe u

namespace Mei.SkewLatticeDatum

open StandardPlane PowerSeries

variable {N : Type*} [AddCommGroup N] [Module.Free ℤ N] (D : SkewLatticeDatum N)
  (d : PositiveDegrees D.unfrozen) [DecidableEq D.unfrozen] (x y : D.NonzeroDegree d)

local notation "βℚ" => D.coefficientForm ℚ
local notation "hβℚ" => D.isAlt_coefficientForm ℚ
local notation "κ" => D.sublattice.toAddSubgroup.rayIndex

omit [Module.Free ℤ N] [DecidableEq D.unfrozen] in
/-- If `{a, b} = 0`, the skew form vanishes on the additive monoid generated by `a` and `b`. -/
theorem coefficientForm_eq_zero_of_mem_closure {a b : D.unfrozen} (h : βℚ a b = 0)
    {m m' : D.unfrozen} (hm : m ∈ AddSubmonoid.closure {a, b})
    (hm' : m' ∈ AddSubmonoid.closure {a, b}) : βℚ m m' = 0 := by
  obtain ⟨c, e, rfl⟩ := (AddSubmonoid.mem_closure_pair _ _ _).mp hm
  obtain ⟨c', e', rfl⟩ := (AddSubmonoid.mem_closure_pair _ _ _).mp hm'
  have := LinearMap.IsAlt.apply_zsmul_add_zsmul hβℚ a b c e c' e'
  simpa only [natCast_zsmul, h, smul_zero] using this

/-- **Ordering for a vanishing pairing.** If `{x, y} = 0`, every finite product of normalized
positive factors at degrees of the additive monoid generated by `x` and `y` agrees at order `k`
with a product of unit factors of such degrees, each of degree at most `k`, whose adjacent
pairings are nonnegative. -/
theorem exists_isChain_projection_prod_pow_eq_of_form_eq_zero (h : βℚ x.1 y.1 = 0) (k : ℕ)
    (l : List (D.NonzeroDegree d × ℕ))
    (hl : ∀ p ∈ l, (p.1 : D.unfrozen) ∈ AddSubmonoid.closure {x.1, y.1}) :
    ∃ l' : List (D.NonzeroDegree d),
      (∀ m ∈ l', (m : D.unfrozen) ∈ AddSubmonoid.closure {x.1, y.1}) ∧
      (l'.IsChain fun a b => 0 ≤ βℚ a.1 b.1) ∧ (∀ m ∈ l', d.degree m.1 ≤ k) ∧
      CompletedGroup.projection k (l'.map (D.unitFactor d)).prod =
        CompletedGroup.projection k
          (l.map fun p => D.dilogPow d p.1 (p.2 * κ (p.1 : N))).prod := by
  classical
  set F : List (D.NonzeroDegree d) := (l.map fun p => List.replicate p.2 p.1).flatten with hF
  have hFmem : ∀ m ∈ F, (m : D.unfrozen) ∈ AddSubmonoid.closure {x.1, y.1} := by
    intro m hm
    simp only [hF, List.mem_flatten, List.mem_map] at hm
    obtain ⟨L, ⟨p, hp, rfl⟩, hmL⟩ := hm
    rw [List.eq_of_mem_replicate hmL]
    exact hl p hp
  refine ⟨F.filter fun m => d.degree m.1 ≤ k, fun m hm => hFmem m (List.mem_filter.mp hm).1, ?_,
    fun m hm => by simpa using (List.mem_filter.mp hm).2, ?_⟩
  · refine List.Pairwise.isChain (List.Pairwise.sublist (List.filter_sublist)
      (List.pairwise_of_forall_mem_list fun a ha b hb => ?_))
    rw [D.coefficientForm_eq_zero_of_mem_closure h (hFmem a ha) (hFmem b hb)]
  · have hflat := D.prod_unitFactor_flatten_replicate d l Prod.fst Prod.snd
      (fun p => p.2 * κ (p.1 : N)) fun p _ => by
        rw [D.dilogPow_natCast_mul, unitFactor_def]
    have hfilter := D.projection_prod_dilogPow_filter d F id (fun m => κ (m.1 : N)) k
    simp only [id_eq, ← unitFactor_def] at hfilter
    rw [← hflat, ← hF, ← hfilter]

section Positive

/-- Normalized positive factors at degrees of the monoid generated by `x, y` with `{x, y} > 0` are,
after division of the exponents by `{x, y}`, images of the factors of the plane of `x, y`. -/
private theorem exists_planeDegree_list_eq (hxy : 0 < βℚ x.1 y.1) (l : List (D.NonzeroDegree d × ℕ))
    (hl : ∀ p ∈ l, (p.1 : D.unfrozen) ∈ AddSubmonoid.closure {x.1, y.1}) :
    ∃ L : List (PlaneDegree (D.planeWeight d x y) × ℕ),
      (L.map fun r => D.dilogPow d (D.planeDegree d x y r.1)
        ((βℚ x.1 y.1)⁻¹ * (r.2 * rayIndex r.1.vec))) =
      l.map fun p => D.dilogPow d p.1 (p.2 * κ (p.1 : N)) := by
  induction l with
  | nil => exact ⟨[], rfl⟩
  | cons p l ih =>
    obtain ⟨L, hL⟩ := ih fun p' hp' => hl p' (List.mem_cons_of_mem p hp')
    obtain ⟨q, hq⟩ := D.exists_planeDegree_eq d x y p.1 (hl p List.mem_cons_self)
    obtain ⟨z, hz⟩ := D.exists_natCast_mul_rayIndex_eq d x y hxy q
    rw [hq] at hz
    -- The exponent of the image of `(q, p.2 * z)` is the original exponent `p.2 κ(p.1)`.
    have hexp : (βℚ x.1 y.1)⁻¹ * (((p.2 * z : ℕ) : ℚ) * rayIndex q.vec) = p.2 * κ (p.1 : N) := by
      have hne : βℚ x.1 y.1 ≠ 0 := hxy.ne'
      push_cast
      calc _ = (βℚ x.1 y.1)⁻¹ * (p.2 * ((z : ℚ) * rayIndex q.vec)) := by ring
        _ = _ := by rw [hz]; field_simp
    refine ⟨(q, p.2 * z) :: L, ?_⟩
    simp only [List.map_cons, hL, hq, hexp]

/-- **Ordering for a positive pairing.** If `{x, y} > 0`, every finite product of normalized
positive factors at degrees of the additive monoid generated by `x` and `y` agrees at order `k`
with a product of unit factors of such degrees, each of degree at most `k`, whose adjacent
pairings are nonnegative. -/
theorem exists_isChain_projection_prod_pow_eq_of_form_pos [Module.Free ℤ D.sublattice]
    (hxy : 0 < βℚ x.1 y.1) (k : ℕ) (l : List (D.NonzeroDegree d × ℕ))
    (hl : ∀ p ∈ l, (p.1 : D.unfrozen) ∈ AddSubmonoid.closure {x.1, y.1}) :
    ∃ l' : List (D.NonzeroDegree d),
      (∀ m ∈ l', (m : D.unfrozen) ∈ AddSubmonoid.closure {x.1, y.1}) ∧
      (l'.IsChain fun a b => 0 ≤ βℚ a.1 b.1) ∧ (∀ m ∈ l', d.degree m.1 ≤ k) ∧
      CompletedGroup.projection k (l'.map (D.unitFactor d)).prod =
        CompletedGroup.projection k
          (l.map fun p => D.dilogPow d p.1 (p.2 * κ (p.1 : N))).prod := by
  classical
  have : Fact ((D.principalPositiveDegrees d).monoid ≤ D.principalCoefficientMonoid d) :=
    ⟨D.principalPositiveDegrees_le_coefficientMonoid d⟩
  set w := D.planeWeight d x y with hw
  have hne : βℚ x.1 y.1 ≠ 0 := hxy.ne'
  -- Move the product to the plane and order it there.
  obtain ⟨L, hL⟩ := exists_planeDegree_list_eq D d x y hxy l hl
  obtain ⟨I, hIchain, hIdeg, hIprod⟩ := StandardPlane.exists_isChain_projection_prod_pow_eq k L
  rw [show (StandardPlane.unitFactor : PlaneDegree w → _) =
    fun m => StandardPlane.dilogPow m (rayIndex m.vec) from
      funext StandardPlane.unitFactor_def] at hIprod
  have hC := D.projection_prod_planeDegree_eq d x y hne k
    (I := I) (δ := fun q => q) (c := fun q => rayIndex q.vec) (J := L) (δ' := fun r => r.1)
    (c' := fun r => r.2 * rayIndex r.1.vec) hIprod
  rw [hL] at hC
  -- The original product acts integrally on the principal coefficients.
  have hint : D.IsIntegralLabel d (l.map fun p => D.dilogPow d p.1 (p.2 * κ (p.1 : N))).prod := by
    refine IsIntegralLabel.list_prod D d fun g hg => ?_
    obtain ⟨p, -, rfl⟩ := List.mem_map.mp hg
    rw [dilogPow_def]
    exact D.isIntegralLabel_rayExp d p.1.2.1 p.1.2.2 (s := p.2) (by rw [Int.cast_natCast])
  -- Regroup the output into unit factors of `D`.
  have hdeg : ∀ q ∈ I, d.degree (D.planeDegree d x y q).1 ≤ k := by
    intro q hq
    rw [degree_planeDegree]
    exact_mod_cast hIdeg q hq
  obtain ⟨M, hM, hMchain, hMdeg, hMprod⟩ := exists_isChain_projection_prod_unitFactor_eq D d I
    (D.planeDegree d x y) (fun q => (βℚ x.1 y.1)⁻¹ * rayIndex q.vec)
    (fun q _ => mul_pos (inv_pos.mpr hxy) q.rayIndex_pos) (x := x.1) (y := y.1)
    (fun q _ => D.planeDegree_mem_closure d x y q)
    (hIchain.imp fun a b hab => by
      rw [D.coefficientForm_planeDegree]
      exact mul_nonneg hxy.le hab) hint hdeg hC.symm
  refine ⟨M, fun m hm => ?_, hMchain, hMdeg, hMprod⟩
  obtain ⟨q, -, rfl⟩ := hM m hm
  exact D.planeDegree_mem_closure d x y q

end Positive

/-- **Positive ordering of rank-two products.** Let `x, y` be nonzero allowed degrees of a skew
lattice datum, with any value of the pairing `{x, y}`, including zero. At every finite order `k`,
a finite product of normalized positive factors `Ψ[m]^{sκ(m)}`, `s ∈ ℕ`, at degrees `m` of the
additive monoid generated by `x` and `y` agrees with a product of unit factors `Ψ[m']^{κ(m')}` of
degrees `m'` of the same monoid, each of degree at most `k`, in which all adjacent pairings
`{m', m''}` are nonnegative. -/
theorem exists_isChain_projection_prod_pow_eq [Module.Free ℤ D.sublattice] (k : ℕ)
    (l : List (D.NonzeroDegree d × ℕ))
    (hl : ∀ p ∈ l, (p.1 : D.unfrozen) ∈ AddSubmonoid.closure {x.1, y.1}) :
    ∃ l' : List (D.NonzeroDegree d),
      (∀ m ∈ l', (m : D.unfrozen) ∈ AddSubmonoid.closure {x.1, y.1}) ∧
      (l'.IsChain fun a b => 0 ≤ βℚ a.1 b.1) ∧ (∀ m ∈ l', d.degree m.1 ≤ k) ∧
      CompletedGroup.projection k (l'.map (D.unitFactor d)).prod =
        CompletedGroup.projection k
          (l.map fun p => D.dilogPow d p.1 (p.2 * κ (p.1 : N))).prod := by
  rcases lt_trichotomy (βℚ x.1 y.1) 0 with hneg | hzero | hpos
  · have hyx : 0 < βℚ y.1 x.1 := by
      rw [← LinearMap.IsAlt.neg (D.isAlt_coefficientForm ℚ) x.1 y.1]
      exact neg_pos.mpr hneg
    rw [Set.pair_comm] at hl ⊢
    exact D.exists_isChain_projection_prod_pow_eq_of_form_pos d y x hyx k l hl
  · exact D.exists_isChain_projection_prod_pow_eq_of_form_eq_zero d x y hzero k l hl
  · exact D.exists_isChain_projection_prod_pow_eq_of_form_pos d x y hpos k l hl

end Mei.SkewLatticeDatum
