module

public import Mei.Geometry.ScatteringDiagram.Skew.RankTwo.Basic

/-!
# Integral regrouping of ordered rank-two products

Let `I` be an ordered list of nonzero allowed degrees `δ i` in the additive monoid generated by
two vectors `x, y`, with positive exponents `c i` and adjacent pairings `0 ≤ {δ i, δ j}`. If a
label `g` acting integrally on the principal coefficients agrees at order `k` with the product of
the labels `Ψ[δ i]^{c i}`, then at order `k` it is an ordered product of unit factors
`Ψ[m]^{κ(m)}` at the degrees `m = δ i` (`exists_isChain_projection_prod_unitFactor_eq`). Grouping
the factors of one degree adds their exponents, and
`exists_nodup_prod_eq_and_intCast_mul_rayIndex_of_isChain` shows that each total exponent is an
integer multiple of `κ(m)`; it is positive because the exponents `c i` are.

## References

* Tomoki Nakanishi, *Cluster algebras and scattering diagrams, Part III*, §5.2, the integrality
  of the exponents of the ordered product of dilogarithm elements (arXiv:2111.00800v6).
-/

public section

noncomputable section

namespace Mei.SkewLatticeDatum

variable {N : Type*} [AddCommGroup N] [Module.Free ℤ N] (D : SkewLatticeDatum N)
  (d : PositiveDegrees D.unfrozen) [DecidableEq D.unfrozen]

local notation "βℚ" => D.coefficientForm ℚ
local notation "κ" => D.sublattice.toAddSubgroup.rayIndex

omit [Module.Free ℤ N] [DecidableEq D.unfrozen] in
/-- **Structure of the flattened replicate list.** If a list `I'` of indices is pairwise ordered by
nonnegative pairings of the degrees `δ i` and all `δ i` have degree at most `k`, then the flattened
list of `s i` copies of each `δ i` consists of the `δ i`, is a chain for the nonnegative pairing,
and has all degrees at most `k`. -/
theorem flatten_replicate_properties {ι : Type*} (I' : List ι) (δ : ι → D.NonzeroDegree d)
    (s : ι → ℕ) (hpw : I'.Pairwise fun i j => 0 ≤ βℚ (δ i).1 (δ j).1) {k : ℕ}
    (hdeg : ∀ i ∈ I', d.degree (δ i).1 ≤ k) :
    (∀ m ∈ (I'.map fun i => List.replicate (s i) (δ i)).flatten, ∃ i ∈ I', δ i = m) ∧
      ((I'.map fun i => List.replicate (s i) (δ i)).flatten.IsChain
        fun a b => 0 ≤ βℚ a.1 b.1) ∧
      ∀ m ∈ (I'.map fun i => List.replicate (s i) (δ i)).flatten, d.degree m.1 ≤ k := by
  refine ⟨fun m hm => ?_, ?_, fun m hm => ?_⟩
  · simp only [List.mem_flatten, List.mem_map] at hm
    obtain ⟨L, ⟨i, hi, rfl⟩, hmL⟩ := hm
    exact ⟨i, hi, (List.eq_of_mem_replicate hmL).symm⟩
  · refine List.Pairwise.isChain (List.pairwise_flatten.mpr ⟨?_, ?_⟩)
    · intro L hL
      obtain ⟨i, -, rfl⟩ := List.mem_map.mp hL
      exact List.pairwise_replicate.mpr (Or.inr (by simp))
    · rw [List.pairwise_map]
      refine hpw.imp fun {i j} hij => ?_
      intro a ha b hb
      rw [List.eq_of_mem_replicate ha, List.eq_of_mem_replicate hb]
      exact hij
  · simp only [List.mem_flatten, List.mem_map] at hm
    obtain ⟨L, ⟨i, hi, rfl⟩, hmL⟩ := hm
    rw [List.eq_of_mem_replicate hmL]
    exact hdeg i hi

/-- **Integral regrouping.** Let `I` be a list with nonzero allowed degrees `δ i` in the monoid
generated by two vectors `x, y`, positive exponents `c i` and adjacent pairings
`0 ≤ {δ i, δ j}`, all of degree at most `k`. If a label `g` acting integrally agrees at order `k`
with the product of the labels `Ψ[δ i]^{c i}`, then at order `k` it is an ordered product of unit
factors at degrees among the `δ i`. -/
theorem exists_isChain_projection_prod_unitFactor_eq [Module.Free ℤ D.sublattice]
    [DecidableEq (Module.Dual ℤ D.sublattice)]
    [Fact ((D.principalPositiveDegrees d).monoid ≤ D.principalCoefficientMonoid d)]
    {ι : Type*} (I : List ι) (δ : ι → D.NonzeroDegree d) (c : ι → ℚ) (hc : ∀ i ∈ I, 0 < c i)
    {x y : D.unfrozen} (hxy : ∀ i ∈ I, (δ i : D.unfrozen) ∈ AddSubmonoid.closure {x, y})
    (hI : I.IsChain fun i j => 0 ≤ βℚ (δ i).1 (δ j).1) {g : d.completedBCHGroup
      (SkewLieAlgebra.positiveGrading βℚ (D.isAlt_coefficientForm ℚ) d)}
    (hg : D.IsIntegralLabel d g) {k : ℕ} (hdeg : ∀ i ∈ I, d.degree (δ i).1 ≤ k)
    (hk : CompletedGroup.projection k g =
      CompletedGroup.projection k (I.map fun i => D.dilogPow d (δ i) (c i)).prod) :
    ∃ M : List (D.NonzeroDegree d), (∀ m ∈ M, ∃ i ∈ I, δ i = m) ∧
      (M.IsChain fun a b => 0 ≤ βℚ a.1 b.1) ∧ (∀ m ∈ M, d.degree m.1 ≤ k) ∧
      CompletedGroup.projection k (M.map (D.unitFactor d)).prod =
        CompletedGroup.projection k g := by
  classical
  obtain ⟨I', hI'I, -, -, hI'pw, hprod, hs⟩ :=
    D.exists_nodup_prod_eq_and_intCast_mul_rayIndex_of_isChain d I (fun i => (δ i).1)
      (fun i => (δ i).2.1) (fun i => (δ i).2.2) c hxy hI hg
      (by simpa only [dilogPow_def] using hk)
  -- The total exponent of the degree of `i`.
  set σ : ι → ℚ := fun i => ((I.filter fun j => decide ((δ j).1 = (δ i).1)).map c).sum with hσ
  have hσpos : ∀ i ∈ I', 0 < σ i := by
    intro i hi
    refine List.sum_pos _ (fun a ha => ?_) (List.ne_nil_of_mem (List.mem_map.mpr
      ⟨i, List.mem_filter.mpr ⟨hI'I hi, by simp⟩, rfl⟩))
    obtain ⟨j, hj, rfl⟩ := List.mem_map.mp ha
    exact hc j (List.mem_filter.mp hj).1
  have hs' : ∀ i, ∃ s : ℤ, i ∈ I' → σ i = s * κ (δ i).1 := by
    intro i
    by_cases h : i ∈ I'
    · obtain ⟨s, hs⟩ := hs i h (hdeg i (hI'I h))
      exact ⟨s, fun _ => hs⟩
    · exact ⟨0, fun h' => absurd h' h⟩
  choose s hs using hs'
  have hpow : ∀ i ∈ I', D.dilogPow d (δ i) (σ i) = D.unitFactor d (δ i) ^ (s i).toNat := by
    intro i hi
    have hκ : 0 < κ (δ i).1 := AddSubgroup.rayIndex_pos _ fun h => (δ i).2.2 (Subtype.ext h)
    have hspos : 0 < s i := by
      have h1 := hσpos i hi
      rw [hs i hi] at h1
      exact_mod_cast pos_of_mul_pos_left h1 hκ.le
    rw [hs i hi]
    exact D.dilogPow_intCast_mul_rayIndex d _ hspos.le
  have hflat := D.prod_unitFactor_flatten_replicate d I' δ (fun i => (s i).toNat) σ hpow
  -- The flattened list of unit factors is ordered, of bounded degree, and has the right product.
  obtain ⟨hmem, hchain, hbound⟩ := flatten_replicate_properties D d I' δ (fun i => (s i).toNat)
    hI'pw fun i hi => hdeg i (hI'I hi)
  refine ⟨(I'.map fun i => List.replicate (s i).toNat (δ i)).flatten, fun m hm => ?_, hchain,
    hbound, ?_⟩
  · obtain ⟨i, hi, hm⟩ := hmem m hm
    exact ⟨i, hI'I hi, hm⟩
  · rw [hflat, hk]
    exact congrArg _ (by simpa only [dilogPow_def] using hprod.symm)

end Mei.SkewLatticeDatum
