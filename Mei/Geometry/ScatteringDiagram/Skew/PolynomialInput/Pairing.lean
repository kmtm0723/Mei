module

public import Mei.Geometry.ScatteringDiagram.Skew.PolynomialInput.Principal
public import Mei.Geometry.ScatteringDiagram.Skew.PolynomialInput.Incoming
public import Mei.Algebra.Lie.Logarithmic.Pairing.Basic

/-!
# The tropical pairing of a polynomial input with its principal datum

The principal lattice lift preserves evaluations of cylinder normals. On their
linear span it therefore defines a tropical pairing, with identity cutoff
modulus. The character map ignores the extra coefficient coordinates and
transports spatial characters through `principalSublatticeEquiv`. In particular,
each initial cylinder normal becomes the primitive principal normal, with no
additional rational factor or choice of coorientation.

We use `principalLift`, `principalFiniteAlphabetLift`, and the tropical pairing
construction. The comparison follows Burcroff–Lee–Mou, *Positivity of generalized
cluster scattering diagrams*, §8.1 and §9.2 (arXiv:2503.03719v1); principal normal
normalization is that of Gross–Hacking–Keel–Kontsevich, *Canonical bases for
cluster algebras*, §1 (arXiv:1411.1394v2).
-/

public noncomputable section

namespace Mei.SkewLatticeDatum.AdaptedBasis.BLMPolynomialInput

variable {N ι : Type*} [AddCommGroup N] {D : SkewLatticeDatum N} {B : D.AdaptedBasis ι}
  (I : B.BLMPolynomialInput) [DecidableEq ι] [Fintype ι]

local notation "Γ" => Module.Dual ℤ N × (I.Letter → ℤ)
local notation "Γ'" => Module.Dual ℤ I.principalDatum.sublattice × I.principalDatum.unfrozen
local notation "𝒅" => PositiveDegrees.finiteAlphabet I.letterExponent
local notation "𝒆" => I.principalDatum.principalPositiveDegrees
  I.principalBasis.unfrozenBasis.positiveDegrees

variable (R : Type*) [CommRing R]

/-- The character subspace generated by the initial integral cylinder normals.
It contains every character needed by their iterated Lie brackets. -/
def alphabetNormalSpan : Submodule R (Γ →+ R) :=
  Submodule.span R (Set.range fun i : B.unfrozenIndex =>
    (Int.castAddHom R).comp (I.alphabetNormal i))

omit [DecidableEq ι] [Fintype ι] in
/-- The selected character domain is exactly the span of the original normals. -/
theorem alphabetNormalSpan_def :
    I.alphabetNormalSpan R = Submodule.span R (Set.range fun i : B.unfrozenIndex =>
      (Int.castAddHom R).comp (I.alphabetNormal i)) := (rfl)

omit [DecidableEq ι] [Fintype ι] in
/-- Each initial normal belongs to the selected character subspace. -/
theorem alphabetNormal_mem_span (i : B.unfrozenIndex) :
    (Int.castAddHom R).comp (I.alphabetNormal i) ∈ I.alphabetNormalSpan R :=
  Submodule.subset_span (Set.mem_range_self i)

omit [DecidableEq ι] [Fintype ι] in
/-- Characters generated by cylinder normals ignore all coefficient coordinates. -/
theorem alphabetNormalSpan_apply (m : I.alphabetNormalSpan R) (q : Γ) :
    m.val q = m.val (q.1, 0) := by
  obtain ⟨m, hm⟩ := m
  induction hm using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    simp
  | zero => simp
  | add x y _ _ hx hy => simp [hx, hy]
  | smul r x _ hx => simp [hx]

omit [DecidableEq ι] [Fintype ι] in
/-- Changing the coefficient ring preserves the span of the integral cylinder
normals, even if the coefficient map has a kernel. -/
theorem comp_mem_alphabetNormalSpan {S : Type*} [CommRing S] (φ : R →+* S)
    (m : I.alphabetNormalSpan R) :
    φ.toAddMonoidHom.comp m.val ∈ I.alphabetNormalSpan S := by
  obtain ⟨m, hm⟩ := m
  induction hm using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    convert I.alphabetNormal_mem_span S i using 1
    ext q
    simp
  | zero => simp
  | add x y _ _ hx hy =>
    convert (I.alphabetNormalSpan S).add_mem hx hy using 1
    ext q
    simp
  | smul r x _ hx =>
    convert (I.alphabetNormalSpan S).smul_mem (φ r) hx using 1
    ext q
    simp

private theorem alphabetNormalSpan_principalLift (m : I.alphabetNormalSpan R) (q : Γ) :
    m.val (I.principalSublatticeEquiv.dualMap (I.principalLift q).1, 0) = m.val q := by
  rw [principalLift_apply, ← LinearEquiv.dualMap_symm, LinearEquiv.apply_symm_apply]
  exact (I.alphabetNormalSpan_apply R m q).symm

/-- The principal lift and inverse spatial dual preserve all selected normal
pairings, on the whole alphabet lattice, including Laurent coefficient degrees. -/
def principalTropicalPairing :
    TropicalPairing (d := 𝒅) (e := 𝒆) (ρ := AddMonoidHom.id Γ)
      (ρ' := AddMonoidHom.id Γ') (I.alphabetNormalSpan R) where
  degreeMap := I.principalFiniteAlphabetLift
  characterMap :=
    { toFun m := m.val.comp ((AddMonoidHom.inl _ _).comp
        (I.principalSublatticeEquiv.dualMap.toAddMonoidHom.comp (AddMonoidHom.fst _ _)))
      map_add' _ _ := by ext; simp
      map_smul' _ _ := by ext; simp }
  eval_eq m n _ := by
    simpa using I.alphabetNormalSpan_principalLift R m n

@[simp]
theorem principalTropicalPairing_degreeMap :
    (I.principalTropicalPairing R).degreeMap = I.principalFiniteAlphabetLift := (rfl)

/-- The transported character is evaluated on the original spatial character
and zero coefficient coordinates. -/
@[simp]
theorem principalTropicalPairing_characterMap_apply
    (m : I.alphabetNormalSpan R) (q : Γ') :
    (I.principalTropicalPairing R).characterMap m q =
      m.val (I.principalSublatticeEquiv.dualMap q.1, 0) := (rfl)

/-- Evaluation is preserved on every coefficient exponent, not only the
positive monoid required by the pairing contract. -/
@[simp high]
theorem principalTropicalPairing_eval (m : I.alphabetNormalSpan R) (q : Γ) :
    (I.principalTropicalPairing R).characterMap m (I.principalLift q) = m.val q := by
  rw [principalTropicalPairing_characterMap_apply]
  exact I.alphabetNormalSpan_principalLift R m q

/-- Each original normal becomes exactly the normalized primitive principal
normal of its unfrozen basis vector. -/
@[simp]
theorem principalTropicalPairing_alphabetNormal (i : B.unfrozenIndex) :
    (I.principalTropicalPairing R).characterMap
        ⟨(Int.castAddHom R).comp (I.alphabetNormal i), I.alphabetNormal_mem_span R i⟩ =
      (Int.castAddHom R).comp
        (I.principalDatum.principalNormal (I.principalBasis.unfrozenBasis
          ⟨i, by simp⟩)).toAddMonoidHom := by
  ext q
  rw [principalTropicalPairing_characterMap_apply]
  simp only [AddMonoidHom.comp_apply, alphabetNormal_apply,
    LinearEquiv.dualMap_apply, LinearMap.toAddMonoidHom_coe, principalNormal_apply]
  congr 1
  apply congrArg q.1
  apply Subtype.ext
  rw [coe_principalSublatticeEquiv, principalInclusion_basis,
    coe_unfrozenBasis, I.principalBasis.coe_rayVector_basis]
  simp

end Mei.SkewLatticeDatum.AdaptedBasis.BLMPolynomialInput
