module

public import Mei.Geometry.ScatteringDiagram.Skew.PolynomialInput.Coefficient
public import Mei.Algebra.Lie.Logarithmic.TangentRestriction
public import Mei.Algebra.Lie.Logarithmic.Pairing.Completion

/-!
# Principal comparison of the initial polynomial labels

The initial BLM labels belong to the completed Lie subalgebra generated by the
cylinder normals. We construct them in that subalgebra from the logarithm of
the actual tangent initial polynomial, and recover the existing labels under
inclusion. The principal coefficient substitution therefore intertwines their
actions, including inverse crossings and arbitrary completed coefficients.

We use `completedTropicalTangentFieldToSubalgebra` and the completed action
comparison of `principalCoefficientGradedLieHom`. This is the initial-label
part of the principal comparison in Burcroff–Lee–Mou, *Positivity of generalized
cluster scattering diagrams*, §8.1 and §9.2 (arXiv:2503.03719v1), with the
function-wall convention of Gross–Hacking–Keel–Kontsevich, *Canonical bases
for cluster algebras*, §1.1 (arXiv:1411.1394v2).
-/

public noncomputable section

namespace Mei.SkewLatticeDatum.AdaptedBasis.BLMPolynomialInput

open LogarithmicVectorField _root_.AddMonoidAlgebra
open scoped TropicalVertexCoefficientAction

section Label

variable {N ι : Type*} [AddCommGroup N] {D : SkewLatticeDatum N}
  {B : D.AdaptedBasis ι} (I : B.BLMPolynomialInput) [DecidableEq ι]
  {R : Type*} [CommRing R] [Algebra ℚ R] [DecidableEq (Module.Dual ℤ N)]

local notation "d" => PositiveDegrees.finiteAlphabet I.letterExponent
local notation "ρ" => AddMonoidHom.id (Module.Dual ℤ N × (I.Letter → ℤ))
local notation "U" => I.alphabetNormalSpan R
local notation "ℒ" => tropicalVertexGrading (R := R) d ρ
local notation "ℳ" => tropicalSubalgebraGrading ρ U d
local notation "χ" i => AddMonoidHom.comp (Int.castAddHom R) (I.alphabetNormal i)
local notation "T" i => tropicalTangentMonoid d ρ (χ i)
local notation "H" i => TropicalVertexCoefficientAction.filtration (R := R) d (T i)

/-- The actual initial logarithmic label formed inside the cylinder-normal
subalgebra, which is the domain of the principal coefficient Lie map. -/
def initialSubalgebraLabel (i : B.unfrozenIndex) : (d).completedBCHGroup ℳ :=
  (d).completedBCHExp ℳ
    (completedTropicalTangentFieldToSubalgebra d ρ U
      ⟨χ i, I.alphabetNormal_mem_span R i⟩
      ((H i).completedLog ⟨(H i).toCompletion (I.tangentInitialFunction i),
        I.toCompletion_tangentInitialFunction_sub_one_mem i⟩))

/-- The logarithmic coordinate is the restricted tangent field of the logarithm
of the original initial polynomial. -/
@[simp]
theorem completedBCHExp_symm_initialSubalgebraLabel (i : B.unfrozenIndex) :
    ((d).completedBCHExp ℳ).symm (I.initialSubalgebraLabel (R := R) i) =
      completedTropicalTangentFieldToSubalgebra d ρ U
        ⟨χ i, I.alphabetNormal_mem_span R i⟩
        ((H i).completedLog ⟨(H i).toCompletion (I.tangentInitialFunction i),
          I.toCompletion_tangentInitialFunction_sub_one_mem i⟩) :=
  ((d).completedBCHExp ℳ).symm_apply_apply _

/-- Inclusion recovers the existing unsplit polynomial label, rather than a
label specified only by its coefficient action. -/
@[simp]
theorem completedMap_initialSubalgebraLabel (i : B.unfrozenIndex) :
    (TropicalPairing.id d ρ U).gradedLieHom.completedMap
        (I.initialSubalgebraLabel (R := R) i) = I.initialLabel i := by
  dsimp only [initialSubalgebraLabel]
  exact (completedMap_completedBCHExp_completedTropicalTangentFieldToSubalgebra d ρ U
    ⟨χ i, I.alphabetNormal_mem_span R i⟩ _).trans (I.initialLabel_def (R := R) i).symm

/-- The restricted initial label has exactly the original coefficient action,
also for inverse crossings and all integral powers of the label. -/
theorem completedBCHAction_initialSubalgebraLabel (Q : AddSubmonoid
    (Module.Dual ℤ N × (I.Letter → ℤ))) [Fact ((d).monoid ≤ Q)]
    (i : B.unfrozenIndex) (z : ℤ)
    (a : (TropicalVertexCoefficientAction.filtration (R := R) d Q).completion) :
    (TropicalVertexCoefficientAction.filtration (R := R) d Q).completedBCHAction
        d ℳ (I.initialSubalgebraLabel i ^ z) a =
      (TropicalVertexCoefficientAction.filtration (R := R) d Q).completedBCHAction
        d ℒ (I.initialLabel i ^ z) a := by
  have he := completedBCHAction_tropicalSubalgebraInclusion d ρ U Q
    (I.initialSubalgebraLabel (R := R) i ^ z) a
  have hg : (TropicalPairing.id d ρ U).gradedLieHom.completedMap
      (I.initialSubalgebraLabel (R := R) i ^ z) = I.initialLabel i ^ z :=
    (map_zpow _ _ _).trans
      (congrArg (fun g => g ^ z) (I.completedMap_initialSubalgebraLabel (R := R) i))
  exact he.trans (congrArg (fun g =>
    (TropicalVertexCoefficientAction.filtration (R := R) d Q).completedBCHAction
      d ℒ g a) hg)

end Label

section Principal

universe u

variable {N ι : Type u} [AddCommGroup N] {D : SkewLatticeDatum N}
  {B : D.AdaptedBasis ι} (I : B.BLMPolynomialInput) [DecidableEq ι]
  {R : Type*} [CommRing R] [Algebra ℚ R] [DecidableEq (Module.Dual ℤ N)]
  [Fintype ι] [DecidableEq (Module.Dual ℤ I.principalDatum.sublattice)]

local notation "d" => PositiveDegrees.finiteAlphabet I.letterExponent
local notation "ρ" => AddMonoidHom.id (Module.Dual ℤ N × (I.Letter → ℤ))
local notation "ℒ" => tropicalVertexGrading (R := R) d ρ

local notation "e" => I.principalDatum.principalPositiveDegrees
  I.principalBasis.unfrozenBasis.positiveDegrees
local notation "𝒬" => I.principalDatum.principalCoefficientMonoid
  I.principalBasis.unfrozenBasis.positiveDegrees
local notation "ρ'" => AddMonoidHom.id
  (Module.Dual ℤ I.principalDatum.sublattice × I.principalDatum.unfrozen)
local notation "ℳ'" => (fun n => Submodule.restrictScalars R
  (tropicalVertexGrading (R := MvPolynomial I.Letter R) e ρ' n))
local notation "F" => TropicalVertexCoefficientAction.filtration (R := R) d I.coefficientMonoid
local notation "G" => TropicalVertexCoefficientAction.filtration
  (R := MvPolynomial I.Letter R) e 𝒬

local instance initialLabelCoefficientMonoidFact : Fact ((d).monoid ≤ I.coefficientMonoid) :=
  ⟨I.positiveDegrees_le_coefficientMonoid⟩

local instance initialLabelPrincipalCoefficientMonoidFact : Fact ((e).monoid ≤ 𝒬) :=
  ⟨I.principalDatum.principalPositiveDegrees_le_coefficientMonoid
    I.principalBasis.unfrozenBasis.positiveDegrees⟩

local instance initialLabelPrincipalLieModule : LieModule R (tropicalVertexLieAlgebra
    (R := MvPolynomial I.Letter R) e ρ') (MvPolynomial I.Letter R)[𝒬] :=
  LieModule.restrictScalars R (MvPolynomial I.Letter R) _ _

local instance initialLabelPrincipalIsFiltrationRaising :
    IsFiltrationRaising e ℳ' ((G).toModuleFiltration R) :=
  IsFiltrationRaising.restrictScalars_algebra (R := R) (S := MvPolynomial I.Letter R) (G) e
    (tropicalVertexGrading (R := MvPolynomial I.Letter R) e ρ')

/-- The actual initial labels and their signed powers intertwine under the
principal polynomial substitution, on arbitrary completed coefficient inputs. -/
theorem principalCoefficientCompletionMap_completedBCHAction_initialLabel
    (i : B.unfrozenIndex) (z : ℤ) (a : (F).completion) :
    I.principalCoefficientCompletionMap
        ((F).completedBCHAction d ℒ (I.initialLabel i ^ z) a) =
      (G).completedBCHAction (R := R) e ℳ'
        ((I.principalCoefficientGradedLieHom R).completedMap
          (I.initialSubalgebraLabel i) ^ z)
        (I.principalCoefficientCompletionMap a) := by
  have he := I.principalCoefficientCompletionMap_completedBCHAction R
    (I.initialSubalgebraLabel (R := R) i ^ z) a
  have hs := I.completedBCHAction_initialSubalgebraLabel I.coefficientMonoid i z a
  have ht := congrArg (fun g => (G).completedBCHAction (R := R) e ℳ' g
    (I.principalCoefficientCompletionMap a))
    ((I.principalCoefficientGradedLieHom R).completedMap.map_zpow
      (I.initialSubalgebraLabel i) z)
  exact (congrArg I.principalCoefficientCompletionMap hs.symm).trans (he.trans ht)

end Principal

end Mei.SkewLatticeDatum.AdaptedBasis.BLMPolynomialInput
