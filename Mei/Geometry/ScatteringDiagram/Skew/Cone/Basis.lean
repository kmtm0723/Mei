module

public import Mei.Geometry.ScatteringDiagram.Skew.Cone.Basic
public import Mei.Geometry.Toric.Algebraic.Cone.Basis

/-!
# The basis-generated principal positive cone

Given an integral basis of the unfrozen lattice, the cone generated by its principal
lifts is rational. If the first lattice map `j` is injective and the unfrozen basis
images under `i` are real linearly independent, its lattice points are exactly the
principal positive monoid. Salience requires only that linear independence.
Supported primitive ray generators belong to the principal monoid by
`Module.Basis.supportedRay_generator_mem_positiveDegrees_graph`, since principal
positive degrees are graph degrees and the character lattice is torsion-free.
The integral degree is the sum of the unfrozen coordinates, so finite cutoffs follow
from `Module.Basis.positiveDegrees` and the existing graph construction.

These are the cone and degree data of the principal realization in
Gross–Hacking–Keel–Kontsevich, *Canonical bases for cluster algebras*, §1 and
Appendix B, arXiv:1411.1394v2. Only a basis of the unfrozen lattice is needed here;
no nondegeneracy of the skew form or diagonal basis of the other sublattice is required.
-/

public section

noncomputable section

namespace Mei.SkewLatticeDatum

open TauCeti.Toric

variable {N ι V W : Type*} [AddCommGroup N]
  [AddCommGroup V] [Module ℝ V] [AddCommGroup W] [Module ℝ W]
  (D : SkewLatticeDatum N) (b : Module.Basis ι ℤ D.unfrozen)
  (j : Module.Dual ℤ D.sublattice →+ W) (i : D.unfrozen →+ V)

/-- The cone spanned by the principal lifts of the unfrozen basis vectors. -/
def principalBasisCone : PointedCone ℝ (W × V) :=
  PointedCone.hull ℝ (Set.range fun a => (j (D.principalCharacter (b a)), i (b a)))

/-- The principal cone is generated by the images of the lifted basis. -/
theorem principalBasisCone_eq_hull :
    D.principalBasisCone b j i = PointedCone.hull ℝ
      ((j.prodMap i) '' Set.range (fun a => D.principalEmbedding (b a))) := by
  simp only [principalBasisCone, ← Set.range_comp, Function.comp_def, principalEmbedding_apply,
    AddMonoidHom.coe_prodMap, Prod.map_apply]

/-- With an integral unfrozen lattice, the basis cone is the general principal
cone of the cone spanned by the unfrozen basis. -/
theorem principalBasisCone_eq_principalCone (hi : IsIntegralLattice i) :
    D.principalBasisCone b j i =
      D.principalCone hi j (PointedCone.hull ℝ (i '' Set.range b)) := by
  rw [D.principalCone_hull hi j, D.principalBasisCone_eq_hull b j i]
  simp only [← Set.range_comp, Function.comp_def]

/-- The principal basis cone is salient: the unfrozen coordinate retains an independent
basis, regardless of the first lattice map or the skew form. -/
theorem salient_principalBasisCone (hi : LinearIndependent ℝ fun a => i (b a)) :
    (D.principalBasisCone b j i : ConvexCone ℝ (W × V)).Salient := by
  rw [principalBasisCone]
  exact PointedCone.salient_hull_range
    (LinearIndependent.of_comp (LinearMap.snd ℝ W V) hi)

/-- The principal basis cone is lattice rational, including for the zero skew form. -/
theorem isLatticeRational_principalBasisCone [Finite ι] :
    IsLatticeRational (j.prodMap i) (D.principalBasisCone b j i) := by
  classical
  let := Fintype.ofFinite ι
  refine isLatticeRational_iff.mpr
    ⟨Finset.univ.image (fun a => D.principalEmbedding (b a)), ?_⟩
  simpa only [Finset.coe_image, Finset.coe_univ, Set.image_univ] using
    D.principalBasisCone_eq_hull b j i

variable [Fintype ι]

/-- Principal positive degrees are exactly the lattice points of the principal cone.
The first lattice map only needs to be injective; the unfrozen basis images need
only be real linearly independent, without spanning the ambient space. -/
theorem principalPositiveDegrees_monoid_eq_latticePoints_principalBasisCone
    (hj : Function.Injective j) (hi : LinearIndependent ℝ fun a => i (b a)) :
    (D.principalPositiveDegrees b.positiveDegrees).monoid =
      (D.principalBasisCone b j i).latticePoints (j.prodMap i) :=
  b.positiveDegrees_graph_monoid_eq_latticePoints_hull hi j hj
    D.principalCharacter.toAddMonoidHom

end Mei.SkewLatticeDatum
