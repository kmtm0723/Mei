public import TauCeti.Geometry.Toric.Algebraic.Lattice

/-!
# Principal cones and their lattice points

The principal cone is the graph lift of a cone of unfrozen degrees under the
real extension of the skew character. Its lattice points are exactly the
principal lifts of the source lattice points. Thus a positive grading defined
by a cone gives the existing principal positive grading on the principal cone,
with the same finite cutoffs. No nondegeneracy of the skew form is required.

The lift preserves rational generators and salience. In particular a cone
generated by unfrozen basis vectors lifts to the cone generated by their
principal exponents. This identifies the geometric and algebraic principal
positive monoids without replacing the existing graph grading.

We use `IsIntegralLattice.extend`, `IsLatticeRational.map` and
`PositiveDegrees.graph`. The principal realization follows
Gross--Hacking--Keel--Kontsevich, *Canonical bases for cluster algebras*, §1
and Appendix B (arXiv:1411.1394v2).
-/

public section

noncomputable section

namespace Mei.SkewLatticeDatum

open TauCeti.Toric

variable {N V W : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  [AddCommGroup W] [Module ℝ W] (D : SkewLatticeDatum N)
  {i : D.unfrozen →+ V} (hi : IsIntegralLattice i)
  (j : Module.Dual ℤ D.sublattice →+ W)

/-- The principal cone, the graph of the real skew character over the cone of
unfrozen degrees. The retained second coordinate keeps radical directions. -/
def principalCone (σ : PointedCone ℝ V) : PointedCone ℝ (W × V) :=
  σ.map ((hi.extend j D.principalCharacter.toAddMonoidHom).prod LinearMap.id)

/-- The principal cone is the linear image under the graph embedding. -/
theorem principalCone_def (σ : PointedCone ℝ V) :
    D.principalCone hi j σ =
      σ.map ((hi.extend j D.principalCharacter.toAddMonoidHom).prod LinearMap.id) := (rfl)

/-- A point belongs to the principal cone precisely when its second coordinate
lies in the source cone and its first coordinate is the extended skew character. -/
@[simp]
theorem mem_principalCone (σ : PointedCone ℝ V) (y : W) (x : V) :
    (y, x) ∈ D.principalCone hi j σ ↔
      x ∈ σ ∧ y = hi.extend j D.principalCharacter.toAddMonoidHom x := by
  rw [principalCone_def, PointedCone.mem_map]
  simp only [LinearMap.prod_apply, Function.prod_apply, LinearMap.id_apply, Prod.mk.injEq]
  constructor
  · rintro ⟨z, hz, hy, rfl⟩
    exact ⟨hz, hy.symm⟩
  · rintro ⟨hx, rfl⟩
    exact ⟨x, hx, rfl, rfl⟩

/-- Principal lifting sends generators to their principal exponents. This
applies in particular to the cone generated by an unfrozen basis. -/
theorem principalCone_hull (s : Set D.unfrozen) :
    D.principalCone hi j (PointedCone.hull ℝ (i '' s)) =
      PointedCone.hull ℝ ((j.prodMap i) '' (D.principalEmbedding '' s)) := by
  rw [principalCone_def]
  simp only [PointedCone.map, Submodule.map_span, Set.image_image]
  congr 1
  apply Set.image_congr
  intro n hn
  simp [principalEmbedding_apply]

/-- A lattice-rational source cone has a lattice-rational principal lift for
the product lattice map. The character map need not be injective. -/
theorem isLatticeRational_principalCone {σ : PointedCone ℝ V}
    (hσ : IsLatticeRational i σ) :
    IsLatticeRational (j.prodMap i) (D.principalCone hi j σ) := by
  rw [principalCone_def]
  exact hσ.map (f := D.principalEmbedding.toAddMonoidHom) (fun n => by simp)

/-- Principal lifting preserves and reflects salience, including for the zero
skew form. -/
@[simp]
theorem salient_principalCone_iff (σ : PointedCone ℝ V) :
    (D.principalCone hi j σ : ConvexCone ℝ (W × V)).Salient ↔
      (σ : ConvexCone ℝ V).Salient := by
  constructor
  · intro h x hx hx0 hneg
    let F := hi.extend j D.principalCharacter.toAddMonoidHom
    have hne : (F x, x) ≠ 0 := fun he => hx0 (congrArg Prod.snd he)
    exact h (F x, x) ((D.mem_principalCone hi j σ _ _).mpr ⟨hx, rfl⟩) hne
      ((D.mem_principalCone hi j σ _ _).mpr ⟨hneg, by simp [F]⟩)
  · intro h
    rw [principalCone_def, PointedCone.toConvexCone_map]
    exact h.map (fun _ _ he => congrArg Prod.snd he)

/-- The principal cone has exactly the principal lifts of the source lattice
points. No saturation or injectivity hypothesis on the skew character is needed. -/
theorem principalCone_latticePoints (σ : PointedCone ℝ V)
    (hj : Function.Injective j) :
    (D.principalCone hi j σ).latticePoints (j.prodMap i) =
      (σ.latticePoints i).map D.principalEmbedding.toAddMonoidHom := by
  rw [principalCone_def]
  have he : D.principalEmbedding.toAddMonoidHom =
      D.principalCharacter.toAddMonoidHom.prod (AddMonoidHom.id D.unfrozen) := by
    apply AddMonoidHom.ext
    intro n
    exact D.principalEmbedding_apply n
  rw [he]
  exact σ.latticePoints_map_prod_id i j D.principalCharacter.toAddMonoidHom
    (hi.extend j D.principalCharacter.toAddMonoidHom) (fun n => by simp) hj

/-- When the source positive monoid is the lattice-point monoid of a cone, its
principal positive monoid is exactly the lattice-point monoid of the principal cone.
The degree and finite cutoffs remain those of `principalPositiveDegrees`. -/
theorem principalPositiveDegrees_monoid_eq_latticePoints
    (d : PositiveDegrees D.unfrozen) (σ : PointedCone ℝ V)
    (hσ : d.monoid = σ.latticePoints i) (hj : Function.Injective j) :
    (D.principalPositiveDegrees d).monoid =
      (D.principalCone hi j σ).latticePoints (j.prodMap i) := by
  rw [principalCone_latticePoints D hi j σ hj, ← hσ]
  ext ⟨m, n⟩
  simp [principalPositiveDegrees, AddSubmonoid.mem_map, principalEmbedding_apply, eq_comm]

end Mei.SkewLatticeDatum
