module

public import Mei.Geometry.ScatteringDiagram.Skew.StandardPlane.UnitFactor
public import Mei.Geometry.ScatteringDiagram.Skew.Integrality
import Mei.Algebra.BigOperators.Group.List.Basic

/-!
# Integral regrouping of ordered products of dilogarithm labels

A finite ordered product of labels `Ψ[m]^c` at plane degrees in the monoid generated by two
plane degrees, with positive rational exponents, that agrees at order `k` with a label acting
integrally on the principal coefficients is, at order `k`, a product of unit factors
`Ψ[m]^{κ(m)}`. Grouping the factors of one degree adds their exponents, and
`SkewLatticeDatum.exists_nodup_prod_eq_and_intCast_mul_rayIndex_of_isChain` shows that each
total exponent at a degree retained by the cutoff is a positive integer multiple of `κ(m)`.
Unit factors act integrally, and so do their inverses and products.
-/

public section

noncomputable section

namespace Mei.StandardPlane

open SkewLatticeDatum.Examples PowerSeries

local notation "β" => E.coefficientForm ℚ
local notation "hβ" => E.isAlt_coefficientForm ℚ

/-- The principal positive degrees lie in the principal coefficient monoid, as the integrality
API requires. -/
instance factPrincipal (w : Weight) :
    Fact ((E.principalPositiveDegrees (plane w)).monoid ≤ E.principalCoefficientMonoid (plane w)) :=
  ⟨E.principalPositiveDegrees_le_coefficientMonoid _⟩

/-- Labels of degree above the cutoff `k` project to the identity at order `k`. -/
theorem projection_prod_dilogPow_filter {w : Weight} {ι : Type*} (l : List ι)
    (δ : ι → PlaneDegree w) (σ : ι → ℚ) (k : ℕ) :
    CompletedGroup.projection k (l.map fun i => dilogPow (δ i) (σ i)).prod =
      CompletedGroup.projection k
        ((l.filter fun i => (δ i).deg ≤ k).map fun i => dilogPow (δ i) (σ i)).prod := by
  rw [map_list_prod, map_list_prod, List.map_map, List.map_map]
  refine (List.prod_map_filter_of_ne l fun i _ hi => ?_).symm
  by_contra hik
  refine hi ?_
  rw [Function.comp_apply, dilogPow_def]
  apply SkewLieAlgebra.projection_rayExp_eq_one_of_lt
  have := (δ i).deg_eq_degree
  omega

/-- If each label `Ψ[δ i]^{σ i}` is the `s i`-th power of the unit factor of `δ i`, then the unit
factors of the flattened list of `s i` copies of each `δ i` multiply to the product of the
labels. -/
theorem prod_unitFactor_flatten_replicate {w : Weight} {ι : Type*} (l : List ι)
    (δ : ι → PlaneDegree w) (s : ι → ℕ) (σ : ι → ℚ)
    (h : ∀ i ∈ l, dilogPow (δ i) (σ i) = unitFactor (δ i) ^ s i) :
    ((l.map fun i => List.replicate (s i) (δ i)).flatten.map unitFactor).prod =
      (l.map fun i => dilogPow (δ i) (σ i)).prod := by
  rw [List.map_flatten, List.prod_flatten, List.map_map, List.map_map]
  congr 1
  refine List.map_congr_left fun i hi => ?_
  simp only [Function.comp_apply, List.map_replicate, List.prod_replicate]
  exact (h i hi).symm

variable {w : Weight} [DecidableEq (Module.Dual ℤ E.sublattice)]

/-- Unit factors act integrally on the principal coefficients. -/
theorem isIntegralLabel_unitFactor (m : PlaneDegree w) :
    E.IsIntegralLabel (plane w) (unitFactor m) := by
  rw [unitFactor_def, dilogPow_def]
  exact E.isIntegralLabel_rayExp (plane w) m.mem m.ne_zero (c := rayIndex m.vec) (s := 1)
    (by rw [Int.cast_one, one_mul])

/-- The inverse of a unit factor acts integrally on the principal coefficients. -/
theorem isIntegralLabel_unitFactor_inv (m : PlaneDegree w) :
    E.IsIntegralLabel (plane w) (unitFactor m)⁻¹ := by
  rw [unitFactor_def, ← dilogPow_neg, dilogPow_def]
  exact E.isIntegralLabel_rayExp (plane w) m.mem m.ne_zero (c := -rayIndex m.vec) (s := -1)
    (by rw [Int.cast_neg, Int.cast_one, neg_one_mul])

/-- **Integral regrouping.** Let `I` be a list with plane degrees `δ i` in the monoid generated by
two plane degrees `x, y`, positive exponents `c i`, and adjacent pairings `0 ≤ {δ i, δ j}`. If a
label `g` acting integrally agrees at order `k` with the product of the labels `Ψ[δ i]^{c i}`,
then at order `k` it is a product of unit factors whose degrees are among the `δ i`. -/
theorem exists_units_prod_eq_of_isChain {ι : Type*} (I : List ι) (δ : ι → PlaneDegree w) (c : ι → ℚ)
    (hc : ∀ i ∈ I, 0 < c i) (x y : PlaneDegree w)
    (hxy : ∀ i ∈ I, (δ i).vec ∈ AddSubmonoid.closure {x.vec, y.vec})
    (hI : I.IsChain fun i j => 0 ≤ E.coefficientForm ℚ (δ i).vec (δ j).vec)
    {g : Label w} (hg : E.IsIntegralLabel (plane w) g) {k : ℕ}
    (hk : CompletedGroup.projection k g =
      CompletedGroup.projection k (I.map fun i => dilogPow (δ i) (c i)).prod) :
    ∃ M : List (PlaneDegree w), (∀ m ∈ M, ∃ i ∈ I, δ i = m) ∧
      CompletedGroup.projection k (M.map unitFactor).prod = CompletedGroup.projection k g := by
  classical
  obtain ⟨l', hl'I, -, -, -, hprod, hint⟩ :=
    E.exists_nodup_prod_eq_and_intCast_mul_rayIndex_of_isChain (plane w) I (fun i => (δ i).vec)
      (fun i => (δ i).mem) (fun i => (δ i).ne_zero) c hxy hI hg (k := k)
      (by simpa only [dilogPow_def] using hk)
  -- The total exponent of the degree `δ i`.
  set σ : ι → ℚ := fun i => ((I.filter fun j => decide ((δ j).vec = (δ i).vec)).map c).sum
    with hσ
  have hσpos : ∀ i ∈ l', 0 < σ i := by
    intro i hi
    apply List.sum_pos
    · intro a ha
      simp only [List.mem_map, List.mem_filter] at ha
      obtain ⟨j, ⟨hj, -⟩, rfl⟩ := ha
      exact hc j hj
    · exact List.ne_nil_of_mem (List.mem_map.mpr ⟨i, List.mem_filter.mpr
        ⟨hl'I hi, by simp⟩, rfl⟩)
  have hs : ∀ i, ∃ s : ℤ, i ∈ l' → (plane w).degree (δ i).vec ≤ k →
      σ i = s * rayIndex (δ i).vec := by
    intro i
    by_cases h : i ∈ l' ∧ (plane w).degree (δ i).vec ≤ k
    · obtain ⟨s, hs⟩ := hint i h.1 h.2
      exact ⟨s, fun _ _ => hs⟩
    · exact ⟨0, fun h1 h2 => absurd ⟨h1, h2⟩ h⟩
  choose s hs using hs
  -- Each retained degree contributes a nonnegative integer power of its unit factor.
  have hpow : ∀ i ∈ l', (δ i).deg ≤ k → dilogPow (δ i) (σ i) = unitFactor (δ i) ^ (s i).toNat := by
    intro i hi hik
    have hdeg : (plane w).degree (δ i).vec ≤ k := by
      have := (δ i).deg_eq_degree
      omega
    have hκ : 0 < rayIndex (δ i).vec := (δ i).rayIndex_pos
    have hspos : 0 < s i := by
      have h1 := hσpos i hi
      rw [hs i hi hdeg] at h1
      exact_mod_cast pos_of_mul_pos_left h1 hκ.le
    rw [hs i hi hdeg, dilogPow_intCast_mul, unitFactor_def, ← zpow_natCast,
      Int.toNat_of_nonneg hspos.le]
  refine ⟨((l'.filter fun i => (δ i).deg ≤ k).map fun i =>
    List.replicate (s i).toNat (δ i)).flatten, ?_, ?_⟩
  · intro m hm
    simp only [List.mem_flatten, List.mem_map, List.mem_filter] at hm
    obtain ⟨L, ⟨i, ⟨hi, -⟩, rfl⟩, hmL⟩ := hm
    exact ⟨i, hl'I hi, (List.eq_of_mem_replicate hmL).symm⟩
  · have hflat := prod_unitFactor_flatten_replicate (l'.filter fun i => (δ i).deg ≤ k) δ
      (fun i => (s i).toNat) σ fun i hi => by
        rw [List.mem_filter, decide_eq_true_eq] at hi
        exact hpow i hi.1 hi.2
    have hl' : (l'.map fun i => dilogPow (δ i) (σ i)).prod =
        (I.map fun i => dilogPow (δ i) (c i)).prod := by
      simpa only [dilogPow_def] using hprod.symm
    rw [hflat, ← projection_prod_dilogPow_filter, hl', ← hk]

end Mei.StandardPlane
