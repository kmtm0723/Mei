module

public import Mei.Geometry.Convex.PolyhedralComplex.Map

/-! # Subcomplexes generated by cells

A subcomplex retains some of the actual cells of a finite polyhedral complex,
including all their nonempty faces. The subcomplex generated by a chosen family
consists of the ambient cells contained in a chosen cell. Its support is exactly
the union of the chosen ambient cells, and it is the smallest complex retaining
them. This allows one to discard cells while retaining prescribed wall supports.
Generation commutes with integral affine transport. Unbounded cells and lineality
are allowed throughout.
-/

public section

namespace Mei.FinitePolyhedralComplex

variable {N V : Type*} [AddCommGroup N] [NormedAddCommGroup V] [NormedSpace ℝ V]
  {i : N →+ V} {h : TauCeti.Toric.IsIntegralLattice i}

/-- A subcomplex retains actual cells of the ambient complex. Face closure is
already part of the complex structure. -/
def IsSubcomplex (C D : FinitePolyhedralComplex h) : Prop := C.cells ⊆ D.cells

/-- Subcomplex inclusion is precisely inclusion of the finite cell collections. -/
theorem isSubcomplex_iff {C D : FinitePolyhedralComplex h} :
    C.IsSubcomplex D ↔ C.cells ⊆ D.cells := Iff.rfl

/-- Every complex is a subcomplex of itself. -/
theorem IsSubcomplex.refl (C : FinitePolyhedralComplex h) : C.IsSubcomplex C :=
  Finset.Subset.refl _

/-- Subcomplex inclusions compose. -/
theorem IsSubcomplex.trans {C D E : FinitePolyhedralComplex h}
    (hCD : C.IsSubcomplex D) (hDE : D.IsSubcomplex E) : C.IsSubcomplex E :=
  Finset.Subset.trans hCD hDE

/-- Mutual subcomplex inclusion determines the same complex. -/
theorem IsSubcomplex.antisymm {C D : FinitePolyhedralComplex h}
    (hCD : C.IsSubcomplex D) (hDC : D.IsSubcomplex C) : C = D :=
  ext (Finset.Subset.antisymm hCD hDC)

/-- A subcomplex is a weak refinement of its ambient complex. -/
theorem IsSubcomplex.isWeakRefinement {C D : FinitePolyhedralComplex h}
    (hCD : C.IsSubcomplex D) : C.IsWeakRefinement D :=
  isWeakRefinement_iff.mpr (fun P hP => ⟨P, hCD hP, Set.Subset.rfl⟩)

/-- Generate a subcomplex by chosen ambient cells and all their nonempty faces.
Members of the chosen family which are not ambient cells are ignored. -/
noncomputable def generatedSubcomplex (C : FinitePolyhedralComplex h)
    (S : Set (Set V)) : FinitePolyhedralComplex h := by
  classical
  refine
    { cells := C.cells.filter (fun P => ∃ Q ∈ C.cells, Q ∈ S ∧ P ⊆ Q)
      nonempty := ?_
      rational := ?_
      face_closed := ?_
      inter_face := ?_ }
  · intro P hP
    exact C.nonempty P (Finset.mem_filter.mp hP).1
  · intro P hP
    exact C.rational P (Finset.mem_filter.mp hP).1
  · intro P hP F hF
    obtain ⟨hPC, Q, hQ, hQS, hPQ⟩ := Finset.mem_filter.mp hP
    exact Finset.mem_filter.mpr
      ⟨C.face_closed P hPC F hF, Q, hQ, hQS, (isPolyhedralFace_iff.mp hF).2.subset.trans hPQ⟩
  · intro P hP Q hQ hne
    exact C.inter_face P (Finset.mem_filter.mp hP).1 Q (Finset.mem_filter.mp hQ).1 hne

/-- Generated cells are precisely ambient cells contained in a chosen ambient cell. -/
@[simp]
theorem mem_generatedSubcomplex_cells {C : FinitePolyhedralComplex h}
    {S : Set (Set V)} {P : Set V} :
    P ∈ (C.generatedSubcomplex S).cells ↔
      P ∈ C.cells ∧ ∃ Q ∈ C.cells, Q ∈ S ∧ P ⊆ Q := by
  classical
  simp only [generatedSubcomplex, Finset.mem_filter]

/-- Generation produces a subcomplex of the ambient complex. -/
theorem generatedSubcomplex_isSubcomplex (C : FinitePolyhedralComplex h)
    (S : Set (Set V)) : (C.generatedSubcomplex S).IsSubcomplex C :=
  fun _ hP => (mem_generatedSubcomplex_cells.mp hP).1

/-- Every chosen ambient cell is retained by generation. -/
theorem mem_generatedSubcomplex_of_mem {C : FinitePolyhedralComplex h}
    {S : Set (Set V)} {P : Set V} (hP : P ∈ C.cells) (hPS : P ∈ S) :
    P ∈ (C.generatedSubcomplex S).cells :=
  mem_generatedSubcomplex_cells.mpr ⟨hP, P, hP, hPS, Set.Subset.rfl⟩

/-- The generated subcomplex is the smallest complex retaining the chosen ambient cells.
The comparison complex need not itself be a subcomplex of the ambient one. -/
theorem generatedSubcomplex_isSubcomplex_iff {C D : FinitePolyhedralComplex h}
    {S : Set (Set V)} :
    (C.generatedSubcomplex S).IsSubcomplex D ↔
      ∀ P ∈ C.cells, P ∈ S → P ∈ D.cells := by
  constructor
  · intro hCD P hP hPS
    exact hCD (mem_generatedSubcomplex_of_mem hP hPS)
  · intro hD P hP
    obtain ⟨hPC, Q, hQ, hQS, hPQ⟩ := mem_generatedSubcomplex_cells.mp hP
    exact D.face_closed Q (hD Q hQ hQS) P (C.face_of_subset hPC hQ hPQ)

/-- No additional points are introduced by adjoining the faces of chosen cells. -/
@[simp]
theorem support_generatedSubcomplex (C : FinitePolyhedralComplex h) (S : Set (Set V)) :
    (C.generatedSubcomplex S).support = ⋃ P ∈ C.cells, ⋃ (_ : P ∈ S), P := by
  ext x
  simp only [mem_support, mem_generatedSubcomplex_cells, Set.mem_iUnion]
  constructor
  · rintro ⟨P, ⟨_, Q, hQ, hQS, hPQ⟩, hx⟩
    exact ⟨Q, hQ, hQS, hPQ hx⟩
  · rintro ⟨P, hP, hPS, hx⟩
    exact ⟨P, ⟨hP, P, hP, hPS, Set.Subset.rfl⟩, hx⟩

/-- Enlarging the chosen family enlarges the generated subcomplex. -/
theorem generatedSubcomplex_mono (C : FinitePolyhedralComplex h)
    {S T : Set (Set V)} (hST : S ⊆ T) :
    (C.generatedSubcomplex S).IsSubcomplex (C.generatedSubcomplex T) := by
  apply generatedSubcomplex_isSubcomplex_iff.mpr
  intro P hP hPS
  exact mem_generatedSubcomplex_of_mem hP (hST hPS)

/-- Choosing all ambient cells recovers the original complex. -/
@[simp]
theorem generatedSubcomplex_univ (C : FinitePolyhedralComplex h) :
    C.generatedSubcomplex Set.univ = C := by
  apply (C.generatedSubcomplex_isSubcomplex Set.univ).antisymm
  intro P hP
  exact mem_generatedSubcomplex_of_mem hP (Set.mem_univ P)

/-- Generating by the cells of an existing subcomplex recovers that subcomplex. -/
theorem IsSubcomplex.generatedSubcomplex_eq {C D : FinitePolyhedralComplex h}
    (hDC : D.IsSubcomplex C) : C.generatedSubcomplex (D.cells : Set (Set V)) = D := by
  apply IsSubcomplex.antisymm
  · exact generatedSubcomplex_isSubcomplex_iff.mpr (fun _ _ hP => hP)
  · intro P hP
    exact mem_generatedSubcomplex_of_mem (hDC hP) hP

variable {N' W : Type*} [AddCommGroup N'] [NormedAddCommGroup W] [NormedSpace ℝ W]
  {i' : N' →+ W} {h' : TauCeti.Toric.IsIntegralLattice i'}

/-- Integral affine transport preserves subcomplex inclusions. -/
theorem IsSubcomplex.image {C D : FinitePolyhedralComplex h} (hCD : C.IsSubcomplex D)
    (e : Toric.IntegralAffineEquiv h h') : (C.image e).IsSubcomplex (D.image e) := by
  intro P hP
  obtain ⟨Q, hQ, rfl⟩ := mem_cells_image.mp hP
  exact mem_cells_image.mpr ⟨Q, hCD hQ, rfl⟩

/-- Transport commutes with generating a subcomplex from chosen cells. -/
theorem image_generatedSubcomplex (C : FinitePolyhedralComplex h) (S : Set (Set V))
    (e : Toric.IntegralAffineEquiv h h') :
    (C.generatedSubcomplex S).image e =
      (C.image e).generatedSubcomplex ((fun P => e '' P) '' S) := by
  apply IsSubcomplex.antisymm
  · intro P hP
    obtain ⟨P₀, hP₀, rfl⟩ := mem_cells_image.mp hP
    obtain ⟨hPC, Q, hQ, hQS, hPQ⟩ := mem_generatedSubcomplex_cells.mp hP₀
    exact mem_generatedSubcomplex_cells.mpr
      ⟨mem_cells_image.mpr ⟨P₀, hPC, rfl⟩,
        e '' Q, mem_cells_image.mpr ⟨Q, hQ, rfl⟩,
        ⟨Q, hQS, rfl⟩, Set.image_mono hPQ⟩
  · apply generatedSubcomplex_isSubcomplex_iff.mpr
    intro P hP hPS
    obtain ⟨Q, hQ, rfl⟩ := mem_cells_image.mp hP
    obtain ⟨R, hRS, heq⟩ := hPS
    have hRQ : R = Q := Set.image_injective.mpr e.toAffineEquiv.injective heq
    subst R
    exact mem_cells_image.mpr ⟨Q, mem_generatedSubcomplex_of_mem hQ hRS, rfl⟩

end Mei.FinitePolyhedralComplex
