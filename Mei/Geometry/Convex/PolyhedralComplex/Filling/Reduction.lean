/-!
# Reduction to transverse triangular fillings

In a finite ambient polyhedral complex, every admissible polygonal loop is
normally generated by admissible triangles whose filled interiors avoid the
codimension-at-least-three skeleton and whose planes complement the directions
of the joints they meet. These are precisely the geometric conditions needed
to subdivide a filling into regular and isolated joint patches. The original
loop, including every edge and its basepoint, stays fixed.

The apex is chosen in the open set where all spokes to the loop vertices are
admissible. Within that set,
`FinitePolyhedralComplex.exists_mem_open_triangle_fillings_transverse_joints`
supplies simultaneous avoidance and transversality. The algebraic assembly uses
`Quiver.Path.crossingWord_mem_of_triangles_mem`, factoring the common-apex
argument for ordinary triangular relations. The result permits unbounded cells,
lineality, repeated vertices and degenerate triangles missing all joints.
-/

public section

noncomputable section

open Set Mei.Convex

namespace Mei.FinitePolyhedralComplex

variable {N V : Type*} [AddCommGroup N] [NormedAddCommGroup V] [NormedSpace ℝ V]
  {i : N →+ V} {h : TauCeti.Toric.IsIntegralLattice i}
  (C : FinitePolyhedralComplex h)

/-- Words of admissible triangles in a prescribed region whose fillings avoid
higher strata and are transverse to every joint they meet. Triangles missing
all joints may be degenerate. For a convex region their filled triangles remain
in that region. -/
def transverseTriangleWords (ν : C.walls → V →ₗ[ℝ] ℝ) (U : Set V) :
    Set (FreeGroup C.walls) :=
  {g | ∃ (x y z : WallComplement (fun P : C.walls => (P : Set V)))
    (e : x ⟶ y) (f : y ⟶ z) (r : z ⟶ x),
    x.val ∈ U ∧ y.val ∈ U ∧ z.val ∈ U ∧
    Disjoint (convexHull ℝ {x.val, y.val, z.val}) (C.codimensionAtLeast 3).support ∧
    (∀ J ∈ C.joints, (convexHull ℝ {x.val, y.val, z.val} ∩ J).Nonempty →
      IsCompl (affineSpan ℝ J).direction (vectorSpan ℝ {x.val, y.val, z.val})) ∧
    g = ((e.toPath.cons f).cons r).crossingWord ν}

/-- Membership in the transverse triangular relations records the actual
admissible edges and the avoidance and complementarity of their filling. -/
@[simp]
theorem mem_transverseTriangleWords (ν : C.walls → V →ₗ[ℝ] ℝ) (U : Set V)
    (g : FreeGroup C.walls) :
    g ∈ C.transverseTriangleWords ν U ↔
      ∃ (x y z : WallComplement (fun P : C.walls => (P : Set V)))
        (e : x ⟶ y) (f : y ⟶ z) (r : z ⟶ x),
        x.val ∈ U ∧ y.val ∈ U ∧ z.val ∈ U ∧
        Disjoint (convexHull ℝ {x.val, y.val, z.val}) (C.codimensionAtLeast 3).support ∧
        (∀ J ∈ C.joints, (convexHull ℝ {x.val, y.val, z.val} ∩ J).Nonempty →
          IsCompl (affineSpan ℝ J).direction (vectorSpan ℝ {x.val, y.val, z.val})) ∧
        g = ((e.toPath.cons f).cons r).crossingWord ν := Iff.rfl

/-- Transverse triangular relations are ordinary triangular relations. -/
theorem transverseTriangleWords_subset_triangleWords
    (ν : C.walls → V →ₗ[ℝ] ℝ) (U : Set V) :
    C.transverseTriangleWords ν U ⊆ C.triangleWords ν U := by
  rintro g ⟨x, y, z, e, f, r, hx, hy, hz, -, -, he⟩
  exact (C.mem_triangleWords ν U g).mpr ⟨x, y, z, e, f, r, hx, hy, hz, he⟩

end Mei.FinitePolyhedralComplex

namespace Quiver.Path

variable {N V : Type*} [AddCommGroup N] [NormedAddCommGroup V] [NormedSpace ℝ V]
  {i : N →+ V} {h : TauCeti.Toric.IsIntegralLattice i}
  {C : Mei.FinitePolyhedralComplex h}
  {x : WallComplement (fun P : C.walls => (P : Set V))}

/-- An admissible loop in an ambient complex reduces to triangles with
joint-transverse fillings avoiding the higher skeleton. No extra general
position is assumed of the loop. In a convex open region the entire triangular
fillings lie in that region. -/
theorem crossingWord_mem_normalClosure_transverse_triangles
    (p : AdmissiblePLPath x x) (hC : C.support = univ)
    (ν : C.walls → V →ₗ[ℝ] ℝ)
    (hν : ∀ P, (ν P).ker = (affineSpan ℝ (P : Set V)).direction)
    {U : Set V} (hU : IsOpen U) (hp : ∀ u ∈ p.vertices, u.val ∈ U) :
    p.crossingWord ν ∈ Subgroup.normalClosure (C.transverseTriangleWords ν U) := by
  classical
  have := h.finiteDimensional
  let A := p.vertices.toFinset
  let W := fun P : C.walls => (P : Set V)
  have hpoly (P : C.walls) := C.isConvexPolyhedron (C.mem_cells_of_mem_walls P.property)
  have hdim (P : C.walls) := C.finrank_direction_add_one_of_mem_walls P.property
  -- First obtain a nonempty open set of apex positions preserving every spoke.
  let S : Set V := U ∩ ⋂ u : A,
    {z | (u.val.val, z) ∈ admissiblePairs W ∧ (z, u.val.val) ∈ admissiblePairs W}
  have hS : IsOpen S := hU.inter (isOpen_iInter_of_finite fun u =>
    isOpen_setOf_admissiblePairs W (fun P => (hpoly P).isClosed) u.val.val u.val.val)
  obtain ⟨z₀, hz₀, hspokes⟩ := WallComplement.exists_mem_open_admissible_spokes
    W hpoly hdim (fun u : A => u.val) hU ⟨x.val, hp x p.start_mem_vertices⟩
  have hSne : S.Nonempty := by
    refine ⟨z₀.val, hz₀, mem_iInter.mpr fun u => ?_⟩
    obtain ⟨e⟩ := hspokes u
    exact ⟨(mem_admissiblePairs_iff _ _).mpr e.down.symm,
      (mem_admissiblePairs_iff _ _).mpr e.down⟩
  -- All admissible pairs among the finite vertex set can be treated at once.
  let E := {a : A × A // Nonempty (a.1.val ⟶ a.2.val)}
  obtain ⟨z, hz, -, havoid, htrans⟩ := C.exists_mem_open_triangle_fillings_transverse_joints
    (fun a : E => a.val.1.val.val) (fun a : E => a.val.2.val.val)
    (fun a => C.disjoint_segment_support_codimensionAtLeast hC a.property.some le_rfl)
    (fun j : _root_.Empty => nomatch j) (fun j => nomatch j) hS hSne
  have hzW : ∀ P, z ∉ W P := by
    have hxA : x ∈ A := by simpa only [A, List.mem_toFinset] using p.start_mem_vertices
    exact (mem_admissiblePairs.mp (mem_iInter.mp hz.2 ⟨x, hxA⟩).2).choose
  let z' : WallComplement W := ⟨z, hzW⟩
  have hs (u) (hu : u ∈ p.vertices) : Nonempty (z' ⟶ u) := by
    have huA : u ∈ A := by simpa only [A, List.mem_toFinset] using hu
    exact ⟨⟨(mem_admissiblePairs_iff _ _).mp (mem_iInter.mp hz.2 ⟨u, huA⟩).2⟩⟩
  let s := fun u hu => (hs u hu).some
  apply p.crossingWord_mem_of_triangles_mem ν hν _
    (Subgroup.normalClosure_normal (s := C.transverseTriangleWords ν U)) z' s
  intro u hu v hv e
  have huA : u ∈ A := by simpa only [A, List.mem_toFinset] using hu
  have hvA : v ∈ A := by simpa only [A, List.mem_toFinset] using hv
  let a : E := ⟨(⟨u, huA⟩, ⟨v, hvA⟩), ⟨e⟩⟩
  exact Subgroup.subset_normalClosure
    ⟨z', u, v, s u hu, e, Quiver.reverse (s v hv), hz.1, hp u hu, hp v hv,
      havoid a, htrans a, rfl⟩

end Quiver.Path

namespace Mei.FinitePolyhedralComplex

variable {N V : Type*} [AddCommGroup N] [NormedAddCommGroup V] [NormedSpace ℝ V]
  {i : N →+ V} {h : TauCeti.Toric.IsIntegralLattice i}

/-- For an ambient complex, transverse triangular fillings generate exactly
the ordinary triangular relations. In a convex open set all fillings remain
in that set, so local relations can be checked on these transverse fillings. -/
theorem normalClosure_transverseTriangleWords_eq (C : FinitePolyhedralComplex h)
    (hC : C.support = univ) (ν : C.walls → V →ₗ[ℝ] ℝ)
    (hν : ∀ P, (ν P).ker = (affineSpan ℝ (P : Set V)).direction)
    {U : Set V} (hU : IsOpen U) :
    Subgroup.normalClosure (C.transverseTriangleWords ν U) =
      Subgroup.normalClosure (C.triangleWords ν U) := by
  apply le_antisymm (Subgroup.normalClosure_mono
    (C.transverseTriangleWords_subset_triangleWords ν U))
  apply Subgroup.normalClosure_le_normal
  intro g hg
  obtain ⟨x, y, z, e, f, r, hx, hy, hz, rfl⟩ := (C.mem_triangleWords ν U g).mp hg
  apply Quiver.Path.crossingWord_mem_normalClosure_transverse_triangles _ hC ν hν hU
  intro u hu
  simp only [Quiver.Path.vertices_cons, Quiver.Path.vertices_toPath,
    List.concat_eq_append, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hu
  rcases hu with (((rfl | rfl) | rfl) | rfl) <;> assumption

end Mei.FinitePolyhedralComplex
