/-!
# Crossing words near a joint

Let `U` be an open convex region meeting a joint `J` of a finite polyhedral
complex, such that every cell meeting `U` contains `J`, so that `U` lies in the open
star of `J`; the isolating balls at relative interior points of joints are examples.
The crossing word of every admissible polygonal loop in `U` lies in the normal
closure of the words of admissible triangular loops in `U` whose filled triangle
meets `J` and spans a plane complementary to the direction of `J`; inside `U` such
triangles meet only walls containing `J`. Thus the boundary word of a joint neighbourhood in a
subdivided filling is generated by transverse triangular loops around its joint.

After reduction to triangles, a filled triangle missing `J` misses its affine
span, so it lies in an open half-space bounded by a hyperplane through `J`. There
the walls form a pencil of hyperplanes through the affine span of `J`, and
`FinitePolyhedralComplex.crossingWord_eq_of_pencil` shows that the triangle's word
is trivial. If a wall contains `J`, a filled triangle meeting `J` with a non-complementary
plane would meet `J` on an edge, by `Mei.exists_mem_segment_sub_mem_of_not_isCompl`,
contradicting admissibility of that edge. If no wall contains `J`, no wall meets
`U`, so all crossing words in `U` are trivial.

The local generators in `jointTriangleWords` satisfy the full isolation conditions: their
filled triangles meet the skeleton at one relative interior point of the joint,
avoid its relative boundary and every other joint, and meet only incident cells.
This identification uses `FinitePolyhedralComplex.exists_isolating_point_of_disjoint_direction`
and `AffineSubspace.subsingleton_inter_of_disjoint_direction`.

The separating functional comes from Mathlib's
`geometric_hahn_banach_compact_closed`; the pencil coefficients come from
`mem_span_of_iInf_ker_le_ker` and the integral joint equations of
`FinitePolyhedralComplex.exists_joint_direction_eq_inf_ker`. The reduction to
triangles is `Quiver.Path.crossingWord_mem_normalClosure_triangles`.
-/

public section

noncomputable section

open Set Module Mei.Convex

namespace Mei.FinitePolyhedralComplex

variable {N V : Type*} [AddCommGroup N] [NormedAddCommGroup V] [NormedSpace ℝ V]
  {i : N →+ V} {h : TauCeti.Toric.IsIntegralLattice i}
  (C : FinitePolyhedralComplex h)

/-- Words of admissible triangular meridians in `U` isolating `J`. The filled
triangle meets the codimension-two skeleton at one relative interior point of
`J`, its boundary avoids `J`, and it avoids the relative boundary of `J` and
every other joint while meeting only cells containing `J`. Both orientations of
the boundary are retained. -/
def jointTriangleWords (ν : C.walls → V →ₗ[ℝ] ℝ) (J U : Set V) : Set (FreeGroup C.walls) :=
  {g | ∃ (x y z : WallComplement (fun P : C.walls => (P : Set V)))
    (e : x ⟶ y) (f : y ⟶ z) (r : z ⟶ x) (q : V),
    q ∈ intrinsicInterior ℝ J ∧
      Disjoint (segment ℝ x.val y.val ∪ segment ℝ y.val z.val ∪ segment ℝ z.val x.val) J ∧
      convexHull ℝ {x.val, y.val, z.val} ⊆ U ∧
      IsCompl (affineSpan ℝ J).direction (vectorSpan ℝ {x.val, y.val, z.val}) ∧
      convexHull ℝ {x.val, y.val, z.val} ∩ (C.codimensionAtLeast 2).support = {q} ∧
      Disjoint (convexHull ℝ {x.val, y.val, z.val}) (intrinsicFrontier ℝ J) ∧
      (∀ Q ∈ C.joints, Q ≠ J → Disjoint (convexHull ℝ {x.val, y.val, z.val}) Q) ∧
      (∀ Q ∈ C.cells, (convexHull ℝ {x.val, y.val, z.val} ∩ Q).Nonempty → J ⊆ Q) ∧
      g = ((e.toPath.cons f).cons r).crossingWord ν}

/-- Membership records the actual admissible boundary and every isolation condition. -/
@[simp]
theorem mem_jointTriangleWords (ν : C.walls → V →ₗ[ℝ] ℝ) (J U : Set V)
    (g : FreeGroup C.walls) :
    g ∈ C.jointTriangleWords ν J U ↔
      ∃ (x y z : WallComplement (fun P : C.walls => (P : Set V)))
        (e : x ⟶ y) (f : y ⟶ z) (r : z ⟶ x) (q : V),
        q ∈ intrinsicInterior ℝ J ∧
          Disjoint (segment ℝ x.val y.val ∪ segment ℝ y.val z.val ∪ segment ℝ z.val x.val) J ∧
          convexHull ℝ {x.val, y.val, z.val} ⊆ U ∧
          IsCompl (affineSpan ℝ J).direction (vectorSpan ℝ {x.val, y.val, z.val}) ∧
          convexHull ℝ {x.val, y.val, z.val} ∩ (C.codimensionAtLeast 2).support = {q} ∧
          Disjoint (convexHull ℝ {x.val, y.val, z.val}) (intrinsicFrontier ℝ J) ∧
          (∀ Q ∈ C.joints, Q ≠ J → Disjoint (convexHull ℝ {x.val, y.val, z.val}) Q) ∧
          (∀ Q ∈ C.cells, (convexHull ℝ {x.val, y.val, z.val} ∩ Q).Nonempty → J ⊆ Q) ∧
          g = ((e.toPath.cons f).cons r).crossingWord ν := Iff.rfl

/-- Enlarging the region keeps every isolating meridian of a joint. -/
theorem jointTriangleWords_mono (ν : C.walls → V →ₗ[ℝ] ℝ) (J : Set V) {U U' : Set V}
    (hUU' : U ⊆ U') : C.jointTriangleWords ν J U ⊆ C.jointTriangleWords ν J U' := by
  intro g hg
  obtain ⟨x, y, z, e, f, r, q, hq, hedge, hU, hrest⟩ := (C.mem_jointTriangleWords ν J U g).mp hg
  exact (C.mem_jointTriangleWords ν J U' g).mpr
    ⟨x, y, z, e, f, r, q, hq, hedge, hU.trans hUU', hrest⟩

/-- Isolating joint meridians are triangular relations in the same region. -/
theorem jointTriangleWords_subset_triangleWords (ν : C.walls → V →ₗ[ℝ] ℝ) (J U : Set V) :
    C.jointTriangleWords ν J U ⊆ C.triangleWords ν U := by
  rintro g ⟨x, y, z, e, f, r, q, -, -, hU, -, -, -, -, -, rfl⟩
  exact (C.mem_triangleWords ν U _).mpr ⟨x, y, z, e, f, r,
    hU (subset_convexHull ℝ _ (by simp)), hU (subset_convexHull ℝ _ (by simp)),
    hU (subset_convexHull ℝ _ (by simp)), rfl⟩

/-- Words of the isolating triangular meridians, in `U`, of all joints of the complex. -/
def jointMeridianWords (ν : C.walls → V →ₗ[ℝ] ℝ) (U : Set V) : Set (FreeGroup C.walls) :=
  {g | ∃ J ∈ C.joints, g ∈ C.jointTriangleWords ν J U}

@[simp]
theorem mem_jointMeridianWords (ν : C.walls → V →ₗ[ℝ] ℝ) (U : Set V) (g : FreeGroup C.walls) :
    g ∈ C.jointMeridianWords ν U ↔ ∃ J ∈ C.joints, g ∈ C.jointTriangleWords ν J U := Iff.rfl

/-- Enlarging the region keeps every joint meridian. -/
theorem jointMeridianWords_mono (ν : C.walls → V →ₗ[ℝ] ℝ) {U U' : Set V} (hUU' : U ⊆ U') :
    C.jointMeridianWords ν U ⊆ C.jointMeridianWords ν U' := by
  rintro g ⟨J, hJ, hg⟩
  exact ⟨J, hJ, C.jointTriangleWords_mono ν J hUU' hg⟩

/-- Joint meridians are triangular relations in the same region. -/
theorem jointMeridianWords_subset_triangleWords (ν : C.walls → V →ₗ[ℝ] ℝ) (U : Set V) :
    C.jointMeridianWords ν U ⊆ C.triangleWords ν U := by
  rintro g ⟨J, -, hg⟩
  exact C.jointTriangleWords_subset_triangleWords ν J U hg

variable {C} {J U : Set V}

/-- Near a joint contained in a wall, an admissible triangle whose filled triangle meets
the joint spans a plane complementary to the joint direction: otherwise the joint
would meet one of its edges. -/
private theorem isCompl_of_convexHull_inter_nonempty (hJ : J ∈ C.joints) (hU : Convex ℝ U)
    (hUJ : (U ∩ J).Nonempty) (hinc : ∀ Q ∈ C.cells, (U ∩ Q).Nonempty → J ⊆ Q)
    {P : C.walls} (hJP : J ⊆ P) {x y z : WallComplement (fun P : C.walls => (P : Set V))}
    (e : x ⟶ y) (f : y ⟶ z) (r : z ⟶ x) (hx : x.val ∈ U) (hy : y.val ∈ U) (hz : z.val ∈ U)
    (hmeet : (convexHull ℝ {x.val, y.val, z.val} ∩ J).Nonempty) :
    IsCompl (affineSpan ℝ J).direction (vectorSpan ℝ {x.val, y.val, z.val}) := by
  have := h.finiteDimensional
  obtain ⟨hJC, hdimJ⟩ := (C.mem_cellsOfCodimension 2 J).mp hJ
  by_contra hcompl
  obtain ⟨w, hwΔ, hwJ⟩ := hmeet
  obtain ⟨u, hu, hud⟩ := exists_mem_segment_sub_mem_of_not_isCompl hdimJ hwΔ hcompl
  have huA : u ∈ affineSpan ℝ J := by
    simpa using AffineSubspace.vadd_mem_of_mem_direction hud (subset_affineSpan ℝ J hwJ)
  have hseg {a b : V} (ha : a ∈ U) (hb : b ∈ U) (hu : u ∈ segment ℝ a b) : u ∈ U :=
    hU.segment_subset ha hb hu
  have huU : u ∈ U := by
    rcases hu with hu | hu | hu
    exacts [hseg hx hy hu, hseg hy hz hu, hseg hz hx hu]
  have hus := mem_singularSupport_of_mem_joint hJ hJP
    (hU.inter_affineSpan_subset hUJ (disjoint_intrinsicFrontier hJ hinc) ⟨huU, huA⟩)
  rcases hu with hu | hu | hu
  · obtain ⟨t, ht, rfl⟩ := (segment_eq_image_lineMap ℝ x.val y.val) ▸ hu
    exact e.down.regular t ht hus
  · obtain ⟨t, ht, rfl⟩ := (segment_eq_image_lineMap ℝ y.val z.val) ▸ hu
    exact f.down.regular t ht hus
  · obtain ⟨t, ht, rfl⟩ := (segment_eq_image_lineMap ℝ z.val x.val) ▸ hu
    exact r.down.regular t ht hus

/-- For a joint contained in a wall, an admissible triangle meeting that joint
satisfies every meridian isolation condition in a convex region meeting only
cells incident to the joint. -/
theorem mem_jointTriangleWords_iff_of_incident_wall (ν : C.walls → V →ₗ[ℝ] ℝ)
    (hJ : J ∈ C.joints) (hU : Convex ℝ U)
    (hinc : ∀ Q ∈ C.cells, (U ∩ Q).Nonempty → J ⊆ Q)
    {P : C.walls} (hJP : J ⊆ P) (g : FreeGroup C.walls) :
    g ∈ C.jointTriangleWords ν J U ↔
      ∃ (x y z : WallComplement (fun P : C.walls => (P : Set V)))
        (e : x ⟶ y) (f : y ⟶ z) (r : z ⟶ x),
        x.val ∈ U ∧ y.val ∈ U ∧ z.val ∈ U ∧
          (convexHull ℝ {x.val, y.val, z.val} ∩ J).Nonempty ∧
          g = ((e.toPath.cons f).cons r).crossingWord ν := by
  constructor
  · rintro ⟨x, y, z, e, f, r, q, hq, -, hSU, -, hskel, -, -, -, rfl⟩
    have hqS : q ∈ convexHull ℝ {x.val, y.val, z.val} :=
      (Set.ext_iff.mp hskel q |>.mpr (mem_singleton q)).1
    exact ⟨x, y, z, e, f, r,
      hSU (subset_convexHull ℝ _ (by simp)), hSU (subset_convexHull ℝ _ (by simp)),
      hSU (subset_convexHull ℝ _ (by simp)), ⟨q, hqS, intrinsicInterior_subset hq⟩, rfl⟩
  · rintro ⟨x, y, z, e, f, r, hx, hy, hz, hmeet, rfl⟩
    have hSU : convexHull ℝ {x.val, y.val, z.val} ⊆ U :=
      convexHull_min (by simp [Set.insert_subset_iff, hx, hy, hz]) hU
    have hUJ : (U ∩ J).Nonempty :=
      hmeet.mono (Set.inter_subset_inter_left _ hSU)
    have hc := isCompl_of_convexHull_inter_nonempty hJ hU hUJ hinc hJP e f r hx hy hz hmeet
    obtain ⟨q, hq, hskel, hfront, hother⟩ := C.exists_isolating_point_of_disjoint_direction
      hJ hinc hSU hmeet
      (by simpa only [affineSpan_convexHull, direction_affineSpan] using hc.disjoint)
    -- An incident wall makes every point of the joint singular for admissible edges.
    have hedge {a b : WallComplement (fun Q : C.walls => (Q : Set V))} (d : a ⟶ b) :
        Disjoint (segment ℝ a.val b.val) J := by
      apply Set.disjoint_left.mpr
      intro v hv hvJ
      obtain ⟨t, ht, rfl⟩ := (segment_eq_image_lineMap ℝ a.val b.val) ▸ hv
      exact d.down.regular t ht (C.mem_singularSupport_of_mem_joint hJ hJP hvJ)
    refine ⟨x, y, z, e, f, r, q, hq, ((hedge e).union_left (hedge f)).union_left (hedge r),
      hSU, hc, hskel, hfront, hother, ?_, rfl⟩
    rintro Q hQ ⟨v, hvS, hvQ⟩
    exact hinc Q hQ ⟨v, hSU hvS, hvQ⟩

/-- Near a joint, admissible paths have equal crossing words when the convex hull of
their vertices misses the joint. Such a hull lies in an open half-space bounded by a
hyperplane through the joint, where the walls form a pencil. -/
theorem crossingWord_eq_of_disjoint_convexHull (ν : C.walls → V →ₗ[ℝ] ℝ)
    (hν : ∀ P, LinearMap.ker (ν P) = (affineSpan ℝ (P : Set V)).direction)
    (hJ : J ∈ C.joints) (hU : Convex ℝ U) (hUJ : (U ∩ J).Nonempty)
    (hinc : ∀ Q ∈ C.cells, (U ∩ Q).Nonempty → J ⊆ Q) {S : Set V} (hS : S.Finite)
    (hSU : S ⊆ U) (hSJ : Disjoint (convexHull ℝ S) J)
    {x y : WallComplement (fun P : C.walls => (P : Set V))} (p q' : AdmissiblePLPath x y)
    (hp : ∀ u ∈ p.vertices, u.val ∈ S) (hq : ∀ u ∈ q'.vertices, u.val ∈ S) :
    p.crossingWord ν = q'.crossingWord ν := by
  have := h.finiteDimensional
  have hΔ : convexHull ℝ S ⊆ U := convexHull_min hSU hU
  have hskel := inter_support_codimensionAtLeast_two_subset hJ hinc
  have hspan : U ∩ affineSpan ℝ J ⊆ J := hU.inter_affineSpan_subset hUJ
    (disjoint_intrinsicFrontier hJ hinc)
  have hdisj : Disjoint (convexHull ℝ S) (affineSpan ℝ J : Set V) :=
    Set.disjoint_left.mpr fun w hwΔ hwA => Set.disjoint_left.mp hSJ hwΔ (hspan ⟨hΔ hwΔ, hwA⟩)
  obtain ⟨φ, u₀, v₀, hφΔ, huv, hφA⟩ := geometric_hahn_banach_compact_closed
    (convex_convexHull ℝ _) (hS.isCompact_convexHull ℝ)
    (affineSpan ℝ J).convex (affineSpan ℝ J).closed_of_finiteDimensional hdisj
  obtain ⟨q, hqU, hqJ⟩ := hUJ
  have hqA : q ∈ affineSpan ℝ J := subset_affineSpan ℝ J hqJ
  -- The separating functional is constant on the affine span of the joint.
  have hφD (d : V) (hd : d ∈ (affineSpan ℝ J).direction) : φ d = 0 := by
    by_contra hne
    have hmem := AffineSubspace.vadd_mem_of_mem_direction
      ((affineSpan ℝ J).direction.smul_mem ((v₀ - φ q - 1) / φ d) hd) hqA
    have hlt := hφA _ hmem
    rw [vadd_eq_add, map_add, map_smul, smul_eq_mul, div_mul_cancel₀ _ hne] at hlt
    linarith
  have hφ0 : φ.toLinearMap ≠ 0 := fun h0 => by
    have hx' := hφΔ _ (subset_convexHull ℝ _ (hp x p.start_mem_vertices))
    have hq' := hφA q hqA
    rw [← ContinuousLinearMap.coe_coe φ, h0, LinearMap.zero_apply] at hx' hq'
    linarith
  obtain ⟨ℓ, m, hℓφ, hpen'⟩ := exists_pencil_of_joint hJ q (φ := φ.toLinearMap) hφD hφ0
  simp only [ContinuousLinearMap.coe_coe] at hℓφ
  let U' := U ∩ {w | φ w < u₀}
  have hU' : Convex ℝ U' := hU.inter (convex_halfSpace_lt (𝕜 := ℝ) φ.toLinearMap.isLinear u₀)
  have hmemU' (w : V) (hw : w ∈ S) : w ∈ U' :=
    ⟨hSU hw, hφΔ w (subset_convexHull ℝ _ hw)⟩
  have hℓ (w : V) (hw : w ∈ U') : 0 < ℓ w := by
    have hwu : φ w < u₀ := hw.2
    rw [hℓφ]
    linarith [hφA q hqA]
  -- The region misses the codimension-two skeleton, hence singular support.
  have hskel' (w : V) (hw : w ∈ U') : w ∉ (C.codimensionAtLeast 2).support := fun hws => by
    have hwA := subset_affineSpan ℝ J (hskel ⟨hw.1, hws⟩)
    have hwu : φ w < u₀ := hw.2
    linarith [hφA w hwA]
  have hsing : Disjoint U' (singularSupport fun P : C.walls => (P : Set V)) :=
    Set.disjoint_left.mpr fun w hw hws =>
      hskel' w hw (C.singularSupport_walls_subset_support_codimensionAtLeast hws)
  -- Each wall meeting the region is its affine span there, through the joint.
  have hspanP (P : C.walls) (hP : (U' ∩ P).Nonempty) (w : V) :
      w ∈ affineSpan ℝ (P : Set V) ↔ ν P w = ν P q := by
    have hJP := hinc P (C.mem_cells_of_mem_walls P.property)
      (hP.mono (Set.inter_subset_inter_left _ Set.inter_subset_left))
    rw [← (affineSpan ℝ (P : Set V)).mk'_eq (subset_affineSpan ℝ _ (hJP hqJ)),
      AffineSubspace.mem_mk', ← hν P, LinearMap.mem_ker, vsub_eq_sub, map_sub, sub_eq_zero]
  have hwall (P : C.walls) (hP : (U' ∩ P).Nonempty) (w : V) (hw : w ∈ U') :
      w ∈ (P : Set V) ↔ ν P w = ν P q := by
    rw [← hspanP P hP]
    refine ⟨fun hwP => subset_affineSpan ℝ _ hwP, fun hwA => ?_⟩
    have hfr : Disjoint U' (intrinsicFrontier ℝ (P : Set V)) :=
      Set.disjoint_left.mpr fun v hv hvf => hskel' v hv
        (C.intrinsicFrontier_subset_support_codimensionAtLeast
          (C.mem_cells_of_mem_walls P.property) 1
          (C.finrank_direction_add_one_of_mem_walls P.property).le hvf)
    exact hU'.inter_affineSpan_subset hP hfr ⟨hw, hwA⟩
  have hpen (P : C.walls) (hP : (U' ∩ P).Nonempty) :
      ∃ α β : ℝ, ∀ w, ν P w - ν P q = α * ℓ w + β * m w := by
    refine hpen' (ν P) fun d hd => ?_
    have hJP := hinc P (C.mem_cells_of_mem_walls P.property)
      (hP.mono (Set.inter_subset_inter_left _ Set.inter_subset_left))
    rw [← LinearMap.mem_ker, hν P]
    exact AffineSubspace.direction_le (affineSpan_mono ℝ hJP) hd
  exact C.crossingWord_eq_of_pencil ν hν (fun P => ν P q) hU' hsing ℓ m hℓ hwall hpen p q'
    (fun w hw => hmemU' _ (hp w hw)) (fun w hw => hmemU' _ (hq w hw))

/-- Near a joint, an admissible triangular loop either has trivial crossing word or
is a transverse joint triangle: its filled triangle meets the joint and its plane is
complementary to the joint direction. -/
theorem triangleWords_subset_insert_jointTriangleWords (ν : C.walls → V →ₗ[ℝ] ℝ)
    (hν : ∀ P, LinearMap.ker (ν P) = (affineSpan ℝ (P : Set V)).direction)
    (hJ : J ∈ C.joints) (hU : Convex ℝ U) (hUJ : (U ∩ J).Nonempty)
    (hinc : ∀ Q ∈ C.cells, (U ∩ Q).Nonempty → J ⊆ Q) :
    C.triangleWords ν U ⊆ insert 1 (C.jointTriangleWords ν J U) := by
  intro g hg
  obtain ⟨x, y, z, e, f, r, hx, hy, hz, rfl⟩ := (C.mem_triangleWords ν U g).mp hg
  have hverts (S : Set V) (hx' : x.val ∈ S) (hy' : y.val ∈ S) (hz' : z.val ∈ S) :
      ∀ w ∈ ((e.toPath.cons f).cons r).vertices, w.val ∈ S := by
    simp [Quiver.Hom.toPath, Quiver.Path.vertices_cons, hx', hy', hz']
  have hnil : (Quiver.Path.nil : AdmissiblePLPath x x).crossingWord ν = 1 :=
    Quiver.Path.crossingWord_nil ν
  rw [Set.mem_insert_iff]
  by_cases hmeet : (convexHull ℝ {x.val, y.val, z.val} ∩ J).Nonempty
  · by_cases hwall : ∃ P : C.walls, J ⊆ P
    · obtain ⟨P, hJP⟩ := hwall
      exact Or.inr ((C.mem_jointTriangleWords_iff_of_incident_wall ν hJ hU hinc hJP _).mpr
        ⟨x, y, z, e, f, r, hx, hy, hz, hmeet, rfl⟩)
    · -- No wall meets the region, so the pencil condition is vacuous.
      have hmiss (P : C.walls) : ¬ (U ∩ P).Nonempty := fun hP =>
        hwall ⟨P, hinc P (C.mem_cells_of_mem_walls P.property) hP⟩
      have hsing : Disjoint U (singularSupport fun P : C.walls => (P : Set V)) := by
        refine Set.disjoint_left.mpr fun w hwU hws => ?_
        obtain ⟨P, hwP⟩ := Set.mem_iUnion.mp (singularSupport_subset_iUnion _
          (fun P => (C.isConvexPolyhedron (C.mem_cells_of_mem_walls P.property)).isClosed) hws)
        exact hmiss P ⟨w, hwU, hwP⟩
      exact Or.inl ((C.crossingWord_eq_of_pencil ν hν 0 hU hsing (AffineMap.const ℝ V 1) 0
        (fun _ _ => one_pos) (fun P hP => (hmiss P hP).elim) (fun P hP => (hmiss P hP).elim)
        _ Quiver.Path.nil (hverts U hx hy hz) (by simpa using hx)).trans hnil)
  · -- A filled triangle missing the joint has the word of the constant loop.
    refine Or.inl ((C.crossingWord_eq_of_disjoint_convexHull ν hν hJ hU hUJ hinc
      (Set.toFinite _) (by simp [Set.insert_subset_iff, hx, hy, hz])
      (Set.disjoint_left.mpr fun w hw hwJ => hmeet ⟨w, hw, hwJ⟩) _ Quiver.Path.nil
      (hverts _ (by simp) (by simp) (by simp)) (by simp)).trans hnil)

end Mei.FinitePolyhedralComplex

namespace Quiver.Path

variable {N V : Type*} [AddCommGroup N] [NormedAddCommGroup V] [NormedSpace ℝ V]
  {i : N →+ V} {h : TauCeti.Toric.IsIntegralLattice i}
  {C : Mei.FinitePolyhedralComplex h}
  {x : Mei.Convex.WallComplement (fun P : C.walls => (P : Set V))}

/-- In an open convex region meeting a joint, all of whose incident cells contain
that joint, the word of every admissible polygonal loop lies in the normal closure
of the words of isolating triangular meridians around the joint. Each filled
triangle meets the skeleton once and avoids the joint boundary and all other joints. -/
theorem crossingWord_mem_normalClosure_jointTriangleWords (p : Mei.Convex.AdmissiblePLPath x x)
    (ν : C.walls → V →ₗ[ℝ] ℝ)
    (hν : ∀ P, LinearMap.ker (ν P) = (affineSpan ℝ (P : Set V)).direction)
    {J U : Set V} (hJ : J ∈ C.joints) (hUo : IsOpen U) (hU : Convex ℝ U)
    (hUJ : (U ∩ J).Nonempty) (hinc : ∀ Q ∈ C.cells, (U ∩ Q).Nonempty → J ⊆ Q)
    (hp : ∀ u ∈ p.vertices, u.val ∈ U) :
    p.crossingWord ν ∈ Subgroup.normalClosure (C.jointTriangleWords ν J U) := by
  refine Subgroup.normalClosure_le_normal (fun g hg => ?_)
    (p.crossingWord_mem_normalClosure_triangles ν hν hUo hp)
  rcases C.triangleWords_subset_insert_jointTriangleWords ν hν hJ hU hUJ hinc hg with rfl | hg
  · exact one_mem _
  · exact Subgroup.subset_normalClosure hg

end Quiver.Path
