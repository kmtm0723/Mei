public import Mei.Geometry.Toric.Algebraic.Cone.RationalDuality
public import TauCeti.Geometry.Toric.Algebraic.Cone.Inf

/-!
# Rational-normal polyhedral cones

A pointed cone has a rational-normal affine inequality presentation exactly when
it is generated by finitely many lattice vectors. Offsets need not be rational:
passing to the recession cone removes them. In the reverse direction integral
dual characters supply a presentation with zero offsets.

The comparison uses `Mei.Toric.isLatticeRational_iff_exists_dual_image`,
`TauCeti.Toric.IsLatticeRational.inf`, and
`Set.mem_recessionCone_setOf_forall_iff`. It allows lineality and bridges
affine polyhedral cells and toric cones. In particular a point, the translate of
the zero cone, is a rational-normal polyhedron.
-/

public section

namespace Mei.Toric.IsRationalFunctional

open TauCeti.Toric

variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} {h : IsIntegralLattice i} {f : Module.Dual ℝ V}

/-- A rational halfspace through the origin is lattice rational, with no salience assumption. -/
theorem isLatticeRational_dual_singleton (hf : IsRationalFunctional h f) :
    IsLatticeRational i (PointedCone.dual
      (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V) {f}) := by
  obtain ⟨q, m, rfl⟩ := iff_exists_character.mp hf
  rcases lt_trichotomy q 0 with hq | rfl | hq
  · have hneg : (q : ℝ) < 0 := by exact_mod_cast hq
    have heq : PointedCone.dual
        (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V)
        {(q : ℝ) • h.realCharacter m.toAddMonoidHom} =
        PointedCone.dual
          (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V)
          {h.realCharacter (-m.toAddMonoidHom)} := by
      ext x
      simp only [PointedCone.mem_dual, Set.mem_singleton_iff, forall_eq,
        LinearMap.id_apply, LinearMap.smul_apply, smul_eq_mul, map_neg,
        LinearMap.neg_apply]
      constructor <;> intro hx <;> nlinarith
    rw [heq]
    simpa using h.isLatticeRational_dual_image {-m.toAddMonoidHom}
  · simpa using h.isLatticeRational_top
  · have hpos : (0 : ℝ) < q := by exact_mod_cast hq
    have heq : PointedCone.dual
        (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V)
        {(q : ℝ) • h.realCharacter m.toAddMonoidHom} =
        PointedCone.dual
          (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V)
          {h.realCharacter m.toAddMonoidHom} := by
      ext x
      simp [mul_nonneg_iff_of_pos_left hpos]
    rw [heq]
    simpa using h.isLatticeRational_dual_image {m.toAddMonoidHom}

end Mei.Toric.IsRationalFunctional

namespace Mei

open TauCeti.Toric

variable {N V : Type*} [AddCommGroup N] [NormedAddCommGroup V] [NormedSpace ℝ V]
  {i : N →+ V} (h : IsIntegralLattice i) {C : PointedCone ℝ V}

variable {h} in
/-- A rational-normal polyhedral cone has finitely many lattice generators.
The affine offsets in the given presentation may be arbitrary real numbers. -/
theorem IsRationalNormalPolyhedron.isLatticeRational
    (hC : IsRationalNormalPolyhedron h (C : Set V)) : IsLatticeRational i C := by
  classical
  obtain ⟨P, hP⟩ := isRationalNormalPolyhedron_iff.mp hC
  have hcarrier : P.carrier = {x | ∀ j, P.inequality j x ≤ 0} := by
    ext x
    exact RationalAffinePolyhedron.mem_carrier
  have hne : {x | ∀ j, P.inequality j x ≤ 0}.Nonempty := by
    rw [← hcarrier, hP]
    exact ⟨0, C.zero_mem⟩
  have hlin (x : V) : x ∈ C ↔ ∀ j, (P.inequality j).linear x ≤ 0 := by
    rw [← C.recessionCone_coe, ← hP, hcarrier]
    exact Set.mem_recessionCone_setOf_forall_iff
      (g := fun j => (P.inequality j).toAffineMap) hne
  let D (s : Finset (Fin P.numConstraints)) : PointedCone ℝ V :=
    PointedCone.dual
      (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V)
      ((fun j => -(P.inequality j).linear) '' (s : Set (Fin P.numConstraints)))
  have hD (s) : IsLatticeRational i (D s) := by
    induction s using Finset.induction_on with
    | empty => simpa [D] using h.isLatticeRational_top
    | @insert j s hj ih =>
      have heq : D (insert j s) = D s ⊓ PointedCone.dual
          (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V)
          {-(P.inequality j).linear} := by
        ext x
        simp [D, and_comm]
      rw [heq]
      exact TauCeti.Toric.IsLatticeRational.inf h.isBaseChange.equiv.injective ih
        ((P.rational_linear j).neg.isLatticeRational_dual_singleton)
  have heq : C = D Finset.univ := by
    ext x
    simp [D, hlin]
  rw [heq]
  exact hD _

variable {h} in
/-- A rational-normal polyhedral cone has a presentation by linear inequalities: replacing every
inequality of any presentation by its linear part keeps the carrier. -/
theorem IsRationalNormalPolyhedron.exists_presentation_map_zero
    (hC : IsRationalNormalPolyhedron h (C : Set V)) :
    ∃ P : RationalAffinePolyhedron h, P.carrier = C ∧ ∀ j, P.inequality j 0 = 0 := by
  obtain ⟨P, hP⟩ := isRationalNormalPolyhedron_iff.mp hC
  have hne : {x | ∀ j, P.inequality j x ≤ 0}.Nonempty :=
    ⟨0, RationalAffinePolyhedron.mem_carrier.mp (hP ▸ C.zero_mem)⟩
  have hlin (j) : ((P.inequality j).contLinear.toContinuousAffineMap : V →ᴬ[ℝ] ℝ).linear =
      (P.inequality j).linear := by
    simp only [← ContinuousAffineMap.coe_contLinear_eq_linear,
      ContinuousLinearMap.toContinuousAffineMap_contLinear]
  refine ⟨⟨P.numConstraints, fun j => (P.inequality j).contLinear.toContinuousAffineMap,
    fun j => by rw [hlin]; exact P.rational_linear j⟩, ?_, fun j => by simp⟩
  ext x
  rw [RationalAffinePolyhedron.mem_carrier, SetLike.mem_coe, ← C.recessionCone_coe, ← hP]
  exact (Set.mem_recessionCone_setOf_forall_iff (g := fun j => (P.inequality j).toAffineMap)
    hne).symm.trans (by simp)

/-- A lattice-rational cone is a rational affine polyhedron. -/
theorem isRationalPolyhedron_of_isLatticeRational (hC : IsLatticeRational i C) :
    IsRationalPolyhedron h (C : Set V) := by
  classical
  let _ := h.finiteDimensional
  obtain ⟨s, rfl⟩ := (Toric.isLatticeRational_iff_exists_dual_image h).mp hC
  let g (m : s) : V →ᴬ[ℝ] ℝ :=
    -(ContinuousLinearMap.toContinuousAffineMap
      ⟨h.realCharacter m.val, (h.realCharacter m.val).continuous_of_finiteDimensional⟩)
  have hg (m : s) : Toric.IsRationalFunctional h (g m).linear := by
    exact (Toric.IsRationalFunctional.realCharacter h m.val.toIntLinearMap).neg
  refine isRationalPolyhedron_iff.mpr
    ⟨RationalAffinePolyhedron.ofFinite g hg, ?_, ?_⟩
  · ext x
    simp [RationalAffinePolyhedron.mem_carrier_ofFinite, PointedCone.mem_dual, g]
  · apply RationalAffinePolyhedron.hasRationalOffsets_ofFinite
    intro m
    exact ⟨0, by simp [g]⟩

/-- On pointed cones, rational-normal polyhedrality and lattice rationality agree. -/
theorem isRationalNormalPolyhedron_coe_iff :
    IsRationalNormalPolyhedron h (C : Set V) ↔ IsLatticeRational i C := by
  refine ⟨fun hC => hC.isLatticeRational, fun hC => ?_⟩
  obtain ⟨P, hP, _⟩ := isRationalPolyhedron_iff.mp
    (isRationalPolyhedron_of_isLatticeRational h hC)
  exact isRationalNormalPolyhedron_iff.mpr ⟨P, hP⟩


/-- A point is a rational-normal polyhedron: the translate of the zero cone. -/
theorem isRationalNormalPolyhedron_singleton (x : V) : IsRationalNormalPolyhedron h {x} := by
  obtain ⟨P, hP⟩ := isRationalNormalPolyhedron_iff.mp
    ((isRationalNormalPolyhedron_coe_iff h (C := ⊥)).mpr (isLatticeRational_bot i))
  let f : V →ᴬ[ℝ] V :=
    (ContinuousLinearMap.id ℝ V).toContinuousAffineMap - ContinuousAffineMap.const ℝ V x
  refine isRationalNormalPolyhedron_iff.mpr ⟨P.preimage f ?_, ?_⟩
  · convert Toric.IsRationalLinearMap.id h
    ext v
    simpa [f] using AffineMap.linear_apply_vsub (f : V →ᵃ[ℝ] V) v 0
  · ext y
    simp [hP, f, sub_eq_zero]

end Mei
