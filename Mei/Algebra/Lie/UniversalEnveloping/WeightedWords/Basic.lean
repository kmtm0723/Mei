module

public import Mei.Algebra.Lie.UniversalEnveloping.Augmentation.Basic

/-!
# Weighted word ideals and the augmentation topology

For a Lie-generating family, the augmentation ideal is generated by the images of
that family. Giving the family positive weights bounded by `B` defines weighted
word ideals cofinal with augmentation powers, with modulus `B * (k - 1) + 1`.

These are ideals defined by weighted words. Identifying them with the intrinsic
degree ideals of a graded enveloping algebra additionally requires a grading
descent theorem; no such identification is assumed or asserted here.

The word descriptions refine the canonical-generator descriptions in
`TauCeti.Algebra.Lie.UniversalEnveloping.Augmentation.Basic`.
-/

public section

namespace Mei.UniversalEnvelopingAlgebra

universe u v w

variable {R : Type u} {L : Type v} [CommRing R] [LieRing L] [LieAlgebra R L]
variable {S : Type w} (e : S → L)

local notation "U" => _root_.UniversalEnvelopingAlgebra R L
local notation "ι" => _root_.UniversalEnvelopingAlgebra.ι R
local notation "J" => TauCeti.HopfIdeal.toIdeal (TauCeti.HopfIdeal.augmentation R U)

attribute [local instance 100] LieRing.ofAssociativeRing

/-- The ideal generated by words whose total weight is at least `n`. -/
def weightedWordIdeal (weight : S → ℕ) (n : ℕ) : Ideal U :=
  Ideal.span {a | ∃ l : List S, n ≤ (l.map weight).sum ∧
    (l.map (fun s => ι (e s))).prod = a}

/-- The defining word-span description of the weighted ideal. -/
theorem weightedWordIdeal_def (weight : S → ℕ) (n : ℕ) :
    weightedWordIdeal (R := R) e weight n =
      Ideal.span {a | ∃ l : List S, n ≤ (l.map weight).sum ∧
        (l.map (fun s => ι (e s))).prod = a} := (rfl)

/-- To contain the weighted ideal, it suffices to contain each defining word. -/
theorem weightedWordIdeal_le_iff (weight : S → ℕ) (n : ℕ) (K : Ideal U) :
    weightedWordIdeal (R := R) e weight n ≤ K ↔
      ∀ l : List S, n ≤ (l.map weight).sum →
        (l.map (fun s => ι (e s))).prod ∈ K := by
  rw [weightedWordIdeal_def, Ideal.span_le]
  constructor
  · intro h l hl
    exact h ⟨l, hl, rfl⟩
  · rintro h _ ⟨l, hl, rfl⟩
    exact h l hl

/-- Every word of sufficiently large total weight belongs to the weighted ideal. -/
theorem prod_mem_weightedWordIdeal (weight : S → ℕ) (n : ℕ) (l : List S)
    (hl : n ≤ (l.map weight).sum) :
    (l.map (fun s => ι (e s))).prod ∈ weightedWordIdeal (R := R) e weight n :=
  Ideal.subset_span ⟨l, hl, rfl⟩

private theorem mul_generator_mem_weightedWordIdeal (weight : S → ℕ) (n : ℕ)
    (s : S) {a : U} (ha : a ∈ weightedWordIdeal (R := R) e weight n) :
    a * ι (e s) ∈ weightedWordIdeal (R := R) e weight n := by
  induction ha using Submodule.span_induction with
  | mem a ha =>
    obtain ⟨l, hl, rfl⟩ := ha
    have hm := prod_mem_weightedWordIdeal (R := R) e weight n (l ++ [s])
      (by simpa using hl.trans (Nat.le_add_right (l.map weight).sum (weight s)))
    simpa using hm
  | zero => simp
  | add a b _ _ ha hb => simpa [add_mul] using add_mem ha hb
  | smul r a _ ha => simpa [smul_eq_mul, mul_assoc] using Ideal.mul_mem_left _ r ha

/-- Lie generation ensures that weighted word ideals are two-sided, even for
weights which need not respect any grading of the Lie algebra. -/
theorem weightedWordIdeal_isTwoSided
    (he : LieSubalgebra.lieSpan R L (Set.range e) = ⊤) (weight : S → ℕ) (n : ℕ) :
    (weightedWordIdeal (R := R) e weight n).IsTwoSided := by
  have hlie (x : L) : ∀ a ∈ weightedWordIdeal (R := R) e weight n,
      a * ι x ∈ weightedWordIdeal (R := R) e weight n := by
    have hx : x ∈ LieSubalgebra.lieSpan R L (Set.range e) := by rw [he]; trivial
    induction hx using LieSubalgebra.lieSpan_induction with
    | mem x hx =>
      obtain ⟨s, rfl⟩ := hx
      exact fun _ ha => mul_generator_mem_weightedWordIdeal e weight n s ha
    | zero => simp
    | add x y _ _ hx hy =>
      intro a ha
      simpa [map_add, mul_add] using add_mem (hx a ha) (hy a ha)
    | smul r x _ hx =>
      intro a ha
      simpa [map_smul, mul_smul_comm] using
        Submodule.smul_of_tower_mem (weightedWordIdeal (R := R) e weight n) r (hx a ha)
    | lie x y _ _ hx hy =>
      intro a ha
      simpa [LieHom.map_lie, LieRing.of_associative_ring_bracket, mul_sub, ← mul_assoc] using
        sub_mem (hy _ (hx a ha)) (hx _ (hy a ha))
  constructor
  intro a b ha
  induction b using TauCeti.UniversalEnvelopingAlgebra.induction_ι R L generalizing a with
  | «ι» x => exact hlie x a ha
  | algebraMap r =>
    rw [← Algebra.commutes r a]
    exact Ideal.mul_mem_left _ _ ha
  | add b c hb hc =>
    simpa [mul_add] using add_mem (hb ha) (hc ha)
  | mul b c hb hc => simpa [mul_assoc] using hc (hb ha)

/-- Concatenating words makes the weighted word ideals multiplicative. -/
theorem weightedWordIdeal_mul_le
    (he : LieSubalgebra.lieSpan R L (Set.range e) = ⊤)
    (weight : S → ℕ) (m n : ℕ) :
    weightedWordIdeal (R := R) e weight m * weightedWordIdeal (R := R) e weight n ≤
      weightedWordIdeal (R := R) e weight (m + n) := by
  have := weightedWordIdeal_isTwoSided e he weight m
  rw [weightedWordIdeal_def] at this
  rw [weightedWordIdeal_def, weightedWordIdeal_def, Ideal.span_mul_span, Ideal.span_le]
  rintro _ ⟨_, ⟨l, hl, rfl⟩, _, ⟨t, ht, rfl⟩, rfl⟩
  have h := prod_mem_weightedWordIdeal (R := R) e weight (m + n) (l ++ t)
    (by simpa using Nat.add_le_add hl ht)
  simpa using h

/-- The empty word makes the threshold-zero ideal the whole enveloping algebra. -/
@[simp]
theorem weightedWordIdeal_zero (weight : S → ℕ) :
    weightedWordIdeal (R := R) e weight 0 = ⊤ := by
  apply Ideal.eq_top_of_isUnit_mem _ ?_ isUnit_one
  exact Ideal.subset_span ⟨[], by simp, rfl⟩

/-- Weighted word ideals decrease with the threshold. -/
theorem weightedWordIdeal_antitone (weight : S → ℕ) :
    Antitone (weightedWordIdeal (R := R) e weight) := by
  intro m n hmn
  apply Ideal.span_mono
  rintro a ⟨l, hl, rfl⟩
  exact ⟨l, hmn.trans hl, rfl⟩

/-- Positive generator weights put each augmentation power in the corresponding word ideal. -/
theorem augmentation_pow_le_weightedWordIdeal
    (he : LieSubalgebra.lieSpan R L (Set.range e) = ⊤)
    (weight : S → ℕ) (hw : ∀ s, 1 ≤ weight s) (k : ℕ) :
    J ^ k ≤ weightedWordIdeal (R := R) e weight k := by
  have hbase : J ≤ weightedWordIdeal (R := R) e weight 1 := by
    rw [augmentation_eq_span_generators e he, Ideal.span_le]
    rintro _ ⟨s, rfl⟩
    simpa using prod_mem_weightedWordIdeal (R := R) e weight 1 [s] (by simpa using hw s)
  induction k with
  | zero => simp [Submodule.pow_zero, Ideal.one_eq_top]
  | succ k ih =>
    rw [Ideal.IsTwoSided.pow_succ]
    exact (Ideal.mul_mono hbase ih).trans
      (by simpa [Nat.add_comm] using weightedWordIdeal_mul_le e he weight 1 k)

/-- The bounded-weight modulus: total weight greater than `B * (k - 1)`
forces at least `k` letters, hence membership in the `k`-th augmentation power. -/
theorem weightedWordIdeal_le_augmentation_pow
    (weight : S → ℕ) (B : ℕ) (hw : ∀ s, weight s ≤ B) {k : ℕ} :
    weightedWordIdeal (R := R) e weight (B * (k - 1) + 1) ≤ J ^ k := by
  rw [weightedWordIdeal, Ideal.span_le]
  rintro a ⟨l, hl, rfl⟩
  have hlen : k ≤ l.length := by
    by_contra h
    have hlt : l.length ≤ k - 1 := by omega
    have hweight : (l.map weight).sum ≤ B * l.length := by
      simpa [Nat.mul_comm] using List.sum_le_length_nsmul (l.map weight) B
        (fun x hx => by obtain ⟨s, _, rfl⟩ := List.mem_map.mp hx; exact hw s)
    have := hweight.trans (Nat.mul_le_mul_left B hlt)
    omega
  exact Ideal.pow_le_pow_right hlen (prod_mem_augmentation_pow e l)

/-- With every generator in weight one, the weighted ideals are exactly augmentation powers. -/
@[simp]
theorem weightedWordIdeal_one_eq_augmentation_pow
    (he : LieSubalgebra.lieSpan R L (Set.range e) = ⊤) (k : ℕ) :
    weightedWordIdeal (R := R) e (fun _ => 1) k = J ^ k := by
  cases k with
  | zero => rw [weightedWordIdeal_zero, Submodule.pow_zero, Ideal.one_eq_top]
  | succ k =>
    apply le_antisymm
    · simpa using weightedWordIdeal_le_augmentation_pow e (fun _ => 1) 1
        (fun _ => le_rfl) (k := k + 1)
    · exact augmentation_pow_le_weightedWordIdeal e he (fun _ => 1) (fun _ => le_rfl) _

end Mei.UniversalEnvelopingAlgebra
