module

public import Mei.Algebra.Lie.Graded.Abelian
public import Mei.Algebra.Lie.UniversalEnveloping.Cofinality
public import TauCeti.Algebra.Lie.UniversalEnveloping.Augmentation.Abelian
public import TauCeti.Algebra.Lie.UniversalEnveloping.Polynomial

/-!
# The degree and augmentation filtrations on abelian examples

Two abelian Lie algebras over a nontrivial commutative ring `R`, graded by positive integer
degrees, show how the degree filtration of the enveloping algebra sits relative to the Lie pieces
and to the powers of the augmentation ideal `J`.

* For the line `R x` with `x` in degree one, the enveloping algebra is `R[x]` and the degree
  piece of the Lie algebra in degree two is zero, yet `x²` lies in the second term of the degree
  filtration and is nonzero. So the degree filtration is not generated by the Lie pieces of the
  corresponding degrees.
* For the abelian Lie algebra with independent generators `x_s` of degree `s + 1`, every `x_s`
  lies in the term of order `s + 1` of the degree filtration but outside `J ^ 2`. No term of the
  degree filtration is therefore contained in `J ^ 2`, so the two filtrations are not cofinal,
  although the converse inclusions `J ^ k ≤ I ^ k` hold for every positive grading
  (`Mei.UniversalEnvelopingAlgebra.augmentation_pow_le_degreeFiltration`). The bound on the
  degrees of generators in
  `Mei.UniversalEnvelopingAlgebra.degreeFiltration_augmentation_isCofinalFor` cannot be dropped.

The second example uses the identification of the quotient by `J ^ 2` of an abelian enveloping
algebra with the trivial square-zero extension.
-/

public section

namespace Mei.UniversalEnvelopingAlgebra.Examples

open _root_.UniversalEnvelopingAlgebra Mei.AbelianLie

variable {S : Type*} (R : Type*) [CommRing R]

/-- The degree filtration of the enveloping algebra of `AbelianLie (S →₀ R)`, graded by
`deg : S → ℕ`, where a natural number has itself as integer degree. The negative-degree
hypothesis of `degreeFiltration` holds vacuously, as no natural number is a negative integer. -/
noncomputable abbrev abelianFiltration (deg : S → ℕ) :
    AlgFiltration (UniversalEnvelopingAlgebra R (AbelianLie (S →₀ R))) :=
  degreeFiltration (grading R deg) (Nat.castAddMonoidHom ℤ) fun _ hn => by simp at hn; omega

/-- Each basis generator lies in the term of the degree filtration given by its degree. -/
theorem basis_mem_abelianFiltration (deg : S → ℕ) (s : S) :
    ι R (basis R s) ∈ (abelianFiltration R deg).ideal (deg s) :=
  ι_mem_degreeFiltration _ _ _ (basis_mem_grading s) (by simp)

section Line

/-- The line `R x` has its generator in degree one. -/
abbrev lineDegree : Unit → ℕ := fun _ => 1

/-- The degree-two piece of the line `R x` with `x` in degree one vanishes. -/
theorem line_grading_two : grading R lineDegree 2 = ⊥ :=
  grading_eq_bot_of_forall_ne fun _ h => by simp at h

/-- The square of the generator `x` of the line `R x` lies in the second term of the degree
filtration, although the degree-two piece of the Lie algebra is zero. -/
theorem line_sq_mem_abelianFiltration_two :
    ι R (basis R ()) ^ 2 ∈ (abelianFiltration R lineDegree).ideal 2 :=
  AlgFiltration.pow_mem _ (basis_mem_abelianFiltration R lineDegree ()) 2

/-- The enveloping algebra of the line `R x` is the polynomial ring `R[x]`, so `x ^ 2 ≠ 0`. -/
theorem line_sq_ne_zero [Nontrivial R] : ι R (basis R ()) ^ 2 ≠ 0 := by
  rw [← TauCeti.UniversalEnvelopingAlgebra.polynomialEquiv_X_pow R (AbelianLie (Unit →₀ R))
    (basis R), map_ne_zero_iff _ (AlgEquiv.injective _)]
  exact (Polynomial.monic_X_pow 2).ne_zero

end Line

section Generators

/-- The generator `x_s` has degree `s + 1`: one independent generator in each positive degree. -/
abbrev generatorDegree : ℕ → ℕ := fun s => s + 1

/-- No generator `x_s` lies in the square of the augmentation ideal. -/
theorem basis_notMem_augmentation_sq [Nontrivial R] (s : S) :
    ι R (basis R s) ∉
      (TauCeti.HopfIdeal.augmentation R
        (UniversalEnvelopingAlgebra R (AbelianLie (S →₀ R)))).toIdeal ^ 2 := by
  intro h
  have h0 := TauCeti.UniversalEnvelopingAlgebra.augmentationSqEquiv_mk_ι R
    (AbelianLie (S →₀ R)) (basis R s)
  rw [(Ideal.Quotient.eq_zero_iff_mem).mpr h, map_zero] at h0
  exact (basis R).ne_zero s (by simpa using congrArg TrivSqZeroExt.snd h0.symm)

/-- No term of the degree filtration of the abelian Lie algebra with one generator in each
positive degree lies in the square of the augmentation ideal. -/
theorem not_abelianFiltration_le_augmentation_sq [Nontrivial R] (n : ℕ) :
    ¬ (abelianFiltration R generatorDegree).ideal n ≤
      (TauCeti.HopfIdeal.augmentation R
        (UniversalEnvelopingAlgebra R (AbelianLie (ℕ →₀ R)))).toIdeal ^ 2 := by
  intro h
  exact basis_notMem_augmentation_sq R n
    (h (AlgFiltration.antitone _ n.le_succ (basis_mem_abelianFiltration R generatorDegree n)))

/-- The degree filtration and the powers of the augmentation ideal of the abelian Lie algebra
with one generator in each positive degree are not cofinal: the power `J ^ 2` contains no term
of the degree filtration. -/
theorem not_isCofinalFor_augmentation_pow_abelianFiltration [Nontrivial R] :
    ¬ IsCofinalFor
      (Set.range fun k : ℕ => OrderDual.toDual
        ((TauCeti.HopfIdeal.augmentation R
          (UniversalEnvelopingAlgebra R (AbelianLie (ℕ →₀ R)))).toIdeal ^ k))
      (Set.range fun n : ℕ =>
        OrderDual.toDual ((abelianFiltration R generatorDegree).ideal n)) := by
  intro h
  obtain ⟨_, ⟨n, rfl⟩, hn⟩ := h (Set.mem_range_self 2)
  exact not_abelianFiltration_le_augmentation_sq R n (OrderDual.toDual_le_toDual.mp hn)

end Generators

end Mei.UniversalEnvelopingAlgebra.Examples
