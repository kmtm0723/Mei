module

public import Mei.Algebra.Lie.Logarithmic.Coefficient
public import Mei.Algebra.PositiveDegrees.NonnegIntegers

/-!
# The coefficient filtration over the nonnegative integers

For the nonnegative integers `Mei.PositiveDegrees.nonnegIntegers` as coefficient monoid, the
positive-increment filtration `Mei.TropicalVertexCoefficientAction.filtration` of
`A[nonnegIntegers.monoid]` is the adic filtration of the ideal generated by the variable
`Mei.PositiveDegrees.nonnegIntegers.X`
(`Mei.TropicalVertexCoefficientAction.filtration_nonnegIntegers_eq_ofIdeal`).
-/

public section

noncomputable section

namespace Mei.TropicalVertexCoefficientAction

open _root_.AddMonoidAlgebra PositiveDegrees nonnegIntegers

variable (A : Type*) [CommSemiring A]

/-- A monomial of natural exponent `k` lies in the `k`-th term of the positive-increment
filtration over the nonnegative integers. -/
theorem single_natExponent_mem_filtration_nonnegIntegers_ideal (k : ℕ) (r : A) :
    single (natExponent k) r ∈
      (filtration (R := A) nonnegIntegers nonnegIntegers.monoid).ideal k := by
  rw [filtration_ideal, AddSubmonoid.single_mem_monoidAlgebraIdeal_iff]
  exact Or.inr ⟨natExponent k, by simp, by simp, 0, (zero_add _).symm⟩

/-- The variable lies in the first term of the positive-increment filtration over the
nonnegative integers. -/
theorem X_mem_filtration_nonnegIntegers_ideal_one :
    X A ∈ (filtration (R := A) nonnegIntegers nonnegIntegers.monoid).ideal 1 := by
  rw [X_def]
  exact single_natExponent_mem_filtration_nonnegIntegers_ideal A 1 1

/-- Over the nonnegative integers, the positive-increment filtration is the adic filtration of
the ideal generated by the variable. -/
theorem filtration_nonnegIntegers_eq_ofIdeal :
    filtration (R := A) nonnegIntegers nonnegIntegers.monoid =
      AlgFiltration.ofIdeal (Ideal.span {X A}) := by
  refine AlgFiltration.ext (funext fun k => le_antisymm ?_ ?_)
  · rw [filtration_ideal, AddSubmonoid.monoidAlgebraIdeal_le_iff]
    rintro n - hn
    have hn' : 0 ≤ (n : ℤ) - k := by simpa using hn
    rw [AlgFiltration.ofIdeal_ideal, Ideal.span_singleton_pow, X_pow, Ideal.mem_span_singleton']
    refine ⟨single ⟨(n : ℤ) - k, mem_nonnegIntegers_monoid.mpr hn'⟩ 1, ?_⟩
    rw [of'_apply, single_mul_single, one_mul]
    exact congrArg (single · 1) (Subtype.ext (by simp))
  · rw [AlgFiltration.ofIdeal_ideal, Ideal.span_singleton_pow, X_pow,
      Ideal.span_singleton_le_iff_mem]
    exact single_natExponent_mem_filtration_nonnegIntegers_ideal A k 1

end Mei.TropicalVertexCoefficientAction
