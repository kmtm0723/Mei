module

public import Mei.Algebra.Lie.BCH.Ray.Commensurable

/-!
# Labels indexed by `2` and `3` in the numerical semigroup `⟨2, 3⟩`

The numerical semigroup `⟨2, 3⟩ = {0, 2, 3, 4, …}` in `ℤ`, with the identity degree, is positive
degree data in which `2 • 1` and `3 • 1` are allowed and `1` is not. Thus the hypotheses of
`Mei.PositiveDegrees.commute_of_logComponent_eq_zero_two_nsmul_three_nsmul` hold for `m = 1`:
for every positive grading with abelian rays, completed labels supported on the positive
multiples of `2` commute with those supported on the positive multiples of `3`.
-/

public section

namespace Mei.PositiveDegrees.Examples

/-- The numerical semigroup `⟨2, 3⟩ = {0, 2, 3, 4, …}` of integers. -/
def twoThreeMonoid : AddSubmonoid ℤ where
  carrier := {n | n = 0 ∨ 2 ≤ n}
  zero_mem' := Or.inl rfl
  add_mem' := by
    rintro a b (rfl | ha) (rfl | hb)
    · exact Or.inl rfl
    · exact Or.inr (by simpa using hb)
    · exact Or.inr (by simpa using ha)
    · exact Or.inr (by omega)

/-- Membership in `⟨2, 3⟩`. -/
@[simp]
theorem mem_twoThreeMonoid {n : ℤ} : n ∈ twoThreeMonoid ↔ n = 0 ∨ 2 ≤ n :=
  Iff.rfl

/-- `twoThreeMonoid` is the additive submonoid generated by `2` and `3`. -/
theorem twoThreeMonoid_eq_closure : twoThreeMonoid = AddSubmonoid.closure {2, 3} := by
  refine le_antisymm (fun n hn => ?_) ((AddSubmonoid.closure_le).mpr ?_)
  · obtain rfl | hn := mem_twoThreeMonoid.mp hn
    · exact zero_mem _
    have h2 : (2 : ℤ) ∈ AddSubmonoid.closure {2, 3} := AddSubmonoid.subset_closure (by simp)
    have h3 : (3 : ℤ) ∈ AddSubmonoid.closure {2, 3} := AddSubmonoid.subset_closure (by simp)
    obtain ⟨k, hk⟩ := Int.eq_ofNat_of_zero_le (by omega : 0 ≤ n - 2)
    obtain rfl : n = k + 2 := by omega
    obtain ⟨j, rfl | rfl⟩ := Nat.even_or_odd' k
    · convert AddSubmonoid.nsmul_mem _ h2 (j + 1) using 1
      push_cast
      ring
    · convert add_mem h3 (AddSubmonoid.nsmul_mem _ h2 j) using 1
      push_cast
      ring
  · rintro n (rfl | rfl) <;> simp

/-- The numerical semigroup `⟨2, 3⟩` with the identity degree. -/
def twoThreeDegrees : PositiveDegrees ℤ where
  monoid := twoThreeMonoid
  degree := AddMonoidHom.id ℤ
  degree_pos {n} hn hne := by
    obtain h | h := mem_twoThreeMonoid.mp hn
    · exact (hne h).elim
    · dsimp only [AddMonoidHom.id_apply]
      omega
  finite_le k := (Set.finite_Icc (a := (0 : ℤ)) (b := k)).subset fun n ⟨hn, hk⟩ => by
    obtain h | h := mem_twoThreeMonoid.mp hn
    · exact ⟨h.ge, h ▸ Int.natCast_nonneg k⟩
    · exact ⟨by omega, hk⟩

/-- The allowed degrees of `twoThreeDegrees` form `⟨2, 3⟩`. -/
@[simp]
theorem twoThreeDegrees_monoid : twoThreeDegrees.monoid = twoThreeMonoid := (rfl)

/-- The degree of `twoThreeDegrees` is the identity. -/
@[simp]
theorem twoThreeDegrees_degree (n : ℤ) : twoThreeDegrees.degree n = n := (rfl)

/-- In `⟨2, 3⟩`, `2 • 1` and `3 • 1` are allowed and `1` is not. -/
theorem two_three_mem_not_one_mem_twoThreeDegrees :
    (2 • 1 : ℤ) ∈ twoThreeDegrees.monoid ∧ (3 • 1 : ℤ) ∈ twoThreeDegrees.monoid ∧
      (1 : ℤ) ∉ twoThreeDegrees.monoid := by
  simp

variable {R L : Type*} [CommRing R] [Algebra ℚ R] [LieRing L] [LieAlgebra R L]
  [LieAlgebra ℚ L] [IsScalarTower ℚ R L] (ℒ : ℤ → Submodule R L)
  [GradedLieAlgebra ℒ] [IsPositiveGrading twoThreeDegrees ℒ]

/-- For a positive grading on `⟨2, 3⟩` with abelian rays, completed labels supported on the
positive multiples of `2` commute with completed labels supported on the positive multiples
of `3`. -/
theorem commute_of_logComponent_eq_zero_twoThreeDegrees [IsAbelianRays twoThreeDegrees ℒ]
    {g g' : twoThreeDegrees.completedBCHGroup ℒ}
    (hg : ∀ n, (∀ j : ℕ, (j + 1) • (2 : ℤ) ≠ n) → twoThreeDegrees.logComponent ℒ g n = 0)
    (hg' : ∀ n, (∀ j : ℕ, (j + 1) • (3 : ℤ) ≠ n) → twoThreeDegrees.logComponent ℒ g' n = 0) :
    Commute g g' :=
  have h := two_three_mem_not_one_mem_twoThreeDegrees
  twoThreeDegrees.commute_of_logComponent_eq_zero_two_nsmul_three_nsmul ℒ h.1 h.2.1 h.2.2
    (by simpa only [nsmul_one, Nat.cast_ofNat] using hg)
    (by simpa only [nsmul_one, Nat.cast_ofNat] using hg')

end Mei.PositiveDegrees.Examples
