module

public import Mei.Algebra.Lie.Skew.Ray

/-!
# Grouping sorted products of ray labels by degree

Let `β` be an alternating form valued in an ordered commutative ring. A finite product
`exp(f₁) ⋯ exp(f_r)` of ray labels at nonzero allowed degrees `n₁, …, n_r` is *sorted* if
`β(nᵢ, nⱼ) ≥ 0` whenever `i < j`. Two factors of one degree need not be adjacent in a sorted
product, but every factor between them pairs to zero with that degree: if `nᵢ = nⱼ` and
`i < l < j`, then `β(nᵢ, n_l) ≥ 0` and `β(n_l, nᵢ) = β(n_l, nⱼ) ≥ 0`. Ray labels of degrees
on which the form vanishes commute (`SkewLieAlgebra.commute_rayExp_of_eq_zero`), and labels of
one degree multiply by adding their series (`SkewLieAlgebra.rayExp_add`). Hence a sorted
product equals the sorted product, over representatives of its distinct degrees `n`, of the
labels of the summed series `∑_{nᵢ = n} fᵢ` (`SkewLieAlgebra.exists_nodup_prod_rayExp_eq`).

Products at pairwise distinct degrees are the input of the integrality criterion for
dilogarithm products. Ordering a product by exchanges of adjacent factors, as in Nakanishi,
*Cluster algebras and scattering diagrams, Part III*, §5.2 (arXiv:2111.00800v6), compares
only adjacent factors and may repeat degrees. When the degrees lie in the additive monoid
generated by two vectors, adjacent comparisons already give a sorted product, by
`LinearMap.IsAlt.nonneg_trans_of_mem_closure_pair` and `List.IsChain.pairwise_of_forall_mem`.
-/

public section

noncomputable section

namespace Mei.SkewLieAlgebra

open PowerSeries

variable {R Γ : Type*} [CommRing R] [Algebra ℚ R] [AddCommGroup Γ] [DecidableEq Γ]
  (β : Γ →ₗ[ℤ] Γ →ₗ[ℤ] R) (hβ : β.IsAlt) {d : PositiveDegrees Γ}
  {ι : Type*} (deg : ι → Γ) (hdeg : ∀ i, deg i ∈ d.monoid) (hdeg0 : ∀ i, deg i ≠ 0)
  (f : ι → R⟦X⟧)

/-- Ray labels at equal degrees agree. -/
private theorem rayExp_congr_degree {n n' : Γ} (h : n = n') (hn : n ∈ d.monoid) (hn0 : n ≠ 0)
    (hn' : n' ∈ d.monoid) (hn0' : n' ≠ 0) (g : R⟦X⟧) :
    rayExp β hβ hn hn0 g = rayExp β hβ hn' hn0' g := by
  subst h
  rfl

/-- **Grouping a sorted product of ray labels by degree.** Let a finite product of ray labels
`exp(fᵢ)` at degrees `nᵢ` be sorted, `β(nᵢ, nⱼ) ≥ 0` for `i < j`. It equals the product, over
a list of representatives chosen from the original list for its distinct degrees, again sorted,
of the labels of the summed series `∑_{nⱼ = n} fⱼ`. -/
theorem exists_nodup_prod_rayExp_eq [PartialOrder R] [IsOrderedAddMonoid R] (l : List ι)
    (hl : l.Pairwise fun i j => 0 ≤ β (deg i) (deg j)) :
    ∃ l' : List ι, l' ⊆ l ∧ (∀ i ∈ l, ∃ j ∈ l', deg j = deg i) ∧ (l'.map deg).Nodup ∧
      l'.Pairwise (fun i j => 0 ≤ β (deg i) (deg j)) ∧
      (l.map fun i => rayExp β hβ (hdeg i) (hdeg0 i) (f i)).prod =
        (l'.map fun i => rayExp β hβ (hdeg i) (hdeg0 i)
          ((l.filter fun j => deg j = deg i).map f).sum).prod := by
  induction l with
  | nil => exact ⟨[], by simp⟩
  | cons a l ih =>
    obtain ⟨ha, hl⟩ := List.pairwise_cons.mp hl
    obtain ⟨G, hGl, hGcov, hGnd, hGpw, hGprod⟩ := ih hl
    -- Away from the degree of `a`, the summed series over `a :: l` and over `l` agree.
    have hmap (L : List ι) (hL : ∀ h ∈ L, deg h ≠ deg a) :
        (L.map fun i => rayExp β hβ (hdeg i) (hdeg0 i)
          (((a :: l).filter fun j => deg j = deg i).map f).sum) =
          L.map fun i => rayExp β hβ (hdeg i) (hdeg0 i)
            ((l.filter fun j => deg j = deg i).map f).sum :=
      List.map_congr_left fun h hh => by
        rw [List.filter_cons_of_neg (by simpa using Ne.symm (hL h hh))]
    -- Either `a` joins the representative `g` of its degree, commuting past the factors
    -- before `g`, or its degree is new and `a` becomes its own representative.
    by_cases hex : ∃ g ∈ G, deg g = deg a
    · obtain ⟨g, hgG, hga⟩ := hex
      obtain ⟨A, B, rfl⟩ := List.append_of_mem hgG
      simp only [List.map_append, List.map_cons, List.nodup_append, List.nodup_cons,
        List.mem_map, List.mem_cons] at hGnd
      -- The factors before `g` pair to zero with the degree of `a`.
      have hA : ∀ h ∈ A, β (deg a) (deg h) = 0 := by
        intro h hh
        have h₁ := ha h (hGl (List.mem_append_left _ hh))
        have h₂ := (List.pairwise_append.mp hGpw).2.2 h hh g List.mem_cons_self
        rw [hga, ← hβ.neg] at h₂
        exact le_antisymm (neg_nonneg.mp h₂) h₁
      have hAne : ∀ h ∈ A, deg h ≠ deg a := fun h hh hha =>
        hGnd.2.2 _ ⟨h, hh, rfl⟩ _ (Or.inl hga.symm) hha
      have hBne : ∀ h ∈ B, deg h ≠ deg a := fun h hh hha =>
        hGnd.2.1.1 ⟨h, hh, hha.trans hga.symm⟩
      refine ⟨A ++ g :: B, fun i hi => List.mem_cons_of_mem a (hGl hi), fun i hi => ?_,
        by simpa only [List.map_append, List.map_cons, List.nodup_append, List.nodup_cons,
          List.mem_map, List.mem_cons] using hGnd, hGpw, ?_⟩
      · rcases List.mem_cons.mp hi with rfl | hi
        · exact ⟨g, hgG, hga⟩
        · exact hGcov i hi
      · have hcomm : Commute (rayExp β hβ (hdeg a) (hdeg0 a) (f a))
            (A.map fun i => rayExp β hβ (hdeg i) (hdeg0 i)
              ((l.filter fun j => deg j = deg i).map f).sum).prod :=
          Commute.list_prod_right _ _ fun x hx => by
            obtain ⟨h, hh, rfl⟩ := List.mem_map.mp hx
            exact commute_rayExp_of_eq_zero β hβ _ _ _ _ (hA h hh) _ _
        have hmerge :
            rayExp β hβ (hdeg a) (hdeg0 a) (f a) *
                rayExp β hβ (hdeg g) (hdeg0 g)
                  ((l.filter fun j => deg j = deg g).map f).sum =
              rayExp β hβ (hdeg g) (hdeg0 g)
                (((a :: l).filter fun j => deg j = deg g).map f).sum := by
          rw [rayExp_congr_degree β hβ hga.symm (hdeg a) (hdeg0 a) (hdeg g) (hdeg0 g),
            ← rayExp_add]
          simp [hga]
        simp only [List.map_cons, List.prod_cons]
        rw [hGprod]
        simp only [List.map_append, List.prod_append, List.map_cons, List.prod_cons,
          hmap A hAne, hmap B hBne]
        -- Move the first factor past the prefix, then merge the equal-degree factors.
        rw [hcomm.left_comm]
        congr 1
        rw [← mul_assoc, hmerge]
    · push Not at hex
      have hnil : l.filter (fun j => deg j = deg a) = [] := by
        refine List.filter_eq_nil_iff.mpr fun j hj hja => ?_
        obtain ⟨g, hg, hgj⟩ := hGcov j hj
        exact hex g hg (hgj.trans (by simpa using hja))
      refine ⟨a :: G, List.cons_subset_cons a hGl, fun i hi => ?_, ?_,
        List.pairwise_cons.mpr ⟨fun j hj => ha j (hGl hj), hGpw⟩, ?_⟩
      · rcases List.mem_cons.mp hi with rfl | hi
        · exact ⟨i, List.mem_cons_self, rfl⟩
        · obtain ⟨j, hj, hji⟩ := hGcov i hi
          exact ⟨j, List.mem_cons_of_mem a hj, hji⟩
      · rw [List.map_cons, List.nodup_cons]
        exact ⟨fun h => by obtain ⟨g, hg, hga⟩ := List.mem_map.mp h; exact hex g hg hga, hGnd⟩
      · simp only [List.map_cons, List.prod_cons]
        rw [hGprod]
        simp [hnil, hmap G hex]

end Mei.SkewLieAlgebra
