module

public import Mathlib.GroupTheory.Subgroup.Saturated
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.LinearAlgebra.StdBasis
public import Mei.Algebra.PositiveDegrees.Graph

/-!
# Finite alphabet lifts of positive degrees

Let `m : E → M` be a finite family of exponents in an additive group, for instance
the exponents `m_α` of finitely many terms `c_α z^{m_α}` of wall functions. Its
*finite alphabet* is the lattice `M × (E → ℤ)` with the letters
`v_α = (m_α, e_α)`. The monoid `P_E` freely generated by the letters is the graph of
`b ↦ ∑ α, b α • m α` over the nonnegative orthant, and the degree counts letters,
so `δ_E(v_α) = 1`. We show that `P_E` is generated by the linearly independent
letters, that it is saturated when `M` is torsion-free, and that distinct letters
span distinct supported rays even when their exponents are proportional.

Given positive degree data `(L, P, δ)` and an additive map `τ : M × (E → ℤ) → L`
sending every letter to a nonzero allowed degree `n_α`, we have
`δ(τ x) = ∑ α, b_α δ(n_α) ≥ δ_E(x)` for `x = ∑ α, b_α v_α` in `P_E`, so `τ` is a
positive degree map with identity cutoff modulus (`finiteAlphabetLift`). The
inequality is strict when some letter with `δ(n_α) ≥ 2` occurs in `x`: at a fixed
target order, contributions involving such terms have strictly smaller alphabet degree.

Separating the terms of wall functions into independent letters in this way follows
the reduction in Burcroff–Lee–Mou, *Positivity of generalized cluster scattering
diagrams*, §9.2, arXiv:2503.03719v1.
-/

public section

namespace Mei.PositiveDegrees

section Letter

variable {M E : Type*} [DecidableEq E] (m : E → M)

/-- The letter `(m α, e_α)` of the finite alphabet of an exponent family `m : E → M`. -/
def letter (α : E) : M × (E → ℤ) := (m α, Pi.single α 1)

@[simp]
theorem letter_fst (α : E) : (letter m α).1 = m α := (rfl)

@[simp]
theorem letter_snd (α : E) : (letter m α).2 = Pi.single α 1 := (rfl)

/-- A letter of a finite alphabet is nonzero: its letter count at its own index is one. -/
@[simp]
theorem letter_ne_zero [Zero M] (α : E) : letter m α ≠ 0 :=
  fun h => by simpa using congrArg (fun x => x.2 α) h

/-- The letters of a finite alphabet are linearly independent over `ℤ`. -/
theorem linearIndependent_letter [AddCommGroup M] : LinearIndependent ℤ (letter m) :=
  LinearIndependent.of_comp (LinearMap.snd ℤ M (E → ℤ)) (Pi.linearIndependent_single_one E ℤ)

end Letter

variable {M : Type*} [AddCommGroup M] {E : Type*} [Fintype E] (m : E → M)

/-- The finite alphabet of an exponent family `m : E → M`: the monoid generated by the
letters `(m α, e_α)` in `M × (E → ℤ)`, graded by the number of letters. It is the graph
of `b ↦ ∑ α, b α • m α` over the nonnegative orthant. -/
def finiteAlphabet : PositiveDegrees (M × (E → ℤ)) :=
  (orthant E).graph (Fintype.linearCombination ℤ m).toAddMonoidHom

/-- An element of `M × (E → ℤ)` is allowed in the finite alphabet exactly when its letter
counts are nonnegative and its first coordinate is the corresponding sum of exponents. -/
@[simp]
theorem mem_finiteAlphabet_monoid {x : M × (E → ℤ)} :
    x ∈ (finiteAlphabet m).monoid ↔ (∀ α, 0 ≤ x.2 α) ∧ x.1 = ∑ α, x.2 α • m α := by
  obtain ⟨a, b⟩ := x
  simp [finiteAlphabet, Fintype.linearCombination_apply]

/-- The finite alphabet degree counts letters. -/
@[simp]
theorem finiteAlphabet_degree (x : M × (E → ℤ)) :
    (finiteAlphabet m).degree x = ∑ α, x.2 α := by
  obtain ⟨a, b⟩ := x
  simp [finiteAlphabet]

/-- Over a torsion-free group of exponents, the finite alphabet monoid is saturated. -/
theorem finiteAlphabet_monoid_nsmulSaturated [IsAddTorsionFree M] :
    (finiteAlphabet m).monoid.NSMulSaturated := by
  rintro k ⟨a, b⟩ h
  rcases Nat.eq_zero_or_pos k with hk | hk
  · exact Or.inl hk
  refine Or.inr ((mem_finiteAlphabet_monoid m).mpr ⟨fun α => ?_, ?_⟩)
  · have := ((mem_finiteAlphabet_monoid m).mp h).1 α
    simp only [Prod.smul_snd, Pi.smul_apply, nsmul_eq_mul] at this
    exact nonneg_of_mul_nonneg_right this (by exact_mod_cast hk)
  · have := ((mem_finiteAlphabet_monoid m).mp h).2
    simp only [Prod.smul_fst, Prod.smul_snd, Pi.smul_apply, smul_assoc, ← Finset.smul_sum] at this
    exact ((AddCommute.all _ _).nsmul_right_inj hk.ne').mp this

variable [DecidableEq E]

/-- Every letter is an allowed degree. -/
@[simp high]
theorem letter_mem (α : E) : letter m α ∈ (finiteAlphabet m).monoid := by
  refine (mem_finiteAlphabet_monoid m).mpr ⟨fun β => ?_, ?_⟩
  · by_cases h : β = α
    · subst h; simp
    · simp [h]
  · simp [Pi.single_apply]

/-- The supported ray of the finite alphabet generated by a letter. Letters are primitive,
since their letter-count coordinate is a standard basis vector. -/
def letterRay (α : E) : SupportedRay (finiteAlphabet m) :=
  SupportedRay.ofMem (letter m α) (letter_mem m α) <| TauCeti.isPrimitive_def.mpr
    ⟨(LinearMap.proj α).comp (LinearMap.snd ℤ M (E → ℤ)), by simp [letter]⟩

@[simp]
theorem letterRay_generator (α : E) : (letterRay m α).generator = letter m α := by
  simp [letterRay]

/-- Distinct letters lie on distinct supported rays, even when their exponents are
proportional. -/
theorem letterRay_injective : Function.Injective (letterRay m) := fun α β h =>
  (linearIndependent_letter m).injective <| by
    simpa using congrArg SupportedRay.generator h

/-- An element whose first coordinate is the sum of exponents prescribed by its letter
counts is the corresponding integer combination of letters. -/
theorem eq_sum_letter {x : M × (E → ℤ)} (hx : x.1 = ∑ α, x.2 α • m α) :
    x = ∑ α, x.2 α • letter m α := by
  ext1
  · simp [letter, Prod.fst_sum, hx]
  · simp only [letter, Prod.snd_sum, Prod.smul_snd]
    funext β
    simp [Finset.sum_apply, Pi.single_apply]

/-- The finite alphabet monoid is generated by its letters. Together with
`linearIndependent_letter`, it is the free commutative monoid on the letters. -/
theorem finiteAlphabet_monoid_eq_closure :
    (finiteAlphabet m).monoid = AddSubmonoid.closure (Set.range (letter m)) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨hpos, hx⟩ := (mem_finiteAlphabet_monoid m).mp hx
    rw [eq_sum_letter m hx]
    refine AddSubmonoid.sum_mem _ fun α _ => ?_
    obtain ⟨k, hk⟩ := Int.eq_ofNat_of_zero_le (hpos α)
    rw [hk, natCast_zsmul]
    exact AddSubmonoid.nsmul_mem _ (AddSubmonoid.subset_closure (Set.mem_range_self α)) k
  · rw [AddSubmonoid.closure_le]
    rintro _ ⟨α, rfl⟩
    exact letter_mem m α

variable {L : Type*} [AddCommGroup L] (e : PositiveDegrees L) (τ : M × (E → ℤ) →+ L)

/-- An additive map sends an integer combination of letters to the corresponding
combination of their images. -/
theorem map_eq_sum_letter {x : M × (E → ℤ)} (hx : x.1 = ∑ α, x.2 α • m α) :
    τ x = ∑ α, x.2 α • τ (letter m α) := by
  conv_lhs => rw [eq_sum_letter m hx]
  simp [map_sum, map_zsmul]

/-- An additive map out of the finite alphabet that sends every letter `(m α, e_α)` to
`m α` agrees with the first projection on integer combinations of letters. -/
theorem eq_fst_of_eq_sum {σ : M × (E → ℤ) →+ M} (hσ : ∀ α, σ (letter m α) = m α)
    {x : M × (E → ℤ)} (hx : x.1 = ∑ α, x.2 α • m α) : σ x = x.1 := by
  rw [map_eq_sum_letter m σ hx, hx]
  simp [hσ]

variable {e τ}

/-- The image degree of an integer combination of letters is the sum of its letter counts
weighted by the degrees of the images of the letters. -/
theorem degree_map_eq_sum {x : M × (E → ℤ)} (hx : x.1 = ∑ α, x.2 α • m α) :
    e.degree (τ x) = ∑ α, x.2 α * e.degree (τ (letter m α)) := by
  simp [map_eq_sum_letter m τ hx, map_sum]

/-- A uniform upper bound on the image degrees of letters bounds the degree of
every allowed alphabet element by that bound times its alphabet degree. -/
theorem finiteAlphabet_degree_map_le_mul {c : ℤ}
    (hc : ∀ α, e.degree (τ (letter m α)) ≤ c)
    {x : M × (E → ℤ)} (hx : x ∈ (finiteAlphabet m).monoid) :
    e.degree (τ x) ≤ c * (finiteAlphabet m).degree x := by
  obtain ⟨hpos, hsum⟩ := (mem_finiteAlphabet_monoid m).mp hx
  rw [degree_map_eq_sum m hsum, finiteAlphabet_degree, Finset.mul_sum]
  refine Finset.sum_le_sum fun α _ => ?_
  calc
    x.2 α * e.degree (τ (letter m α)) ≤ x.2 α * c :=
      mul_le_mul_of_nonneg_left (hc α) (hpos α)
    _ = c * x.2 α := mul_comm _ _

variable (hτ : ∀ α, τ (letter m α) ∈ e.monoid) (hτ0 : ∀ α, τ (letter m α) ≠ 0)
include hτ hτ0

/-- If every letter maps to a nonzero allowed degree, the alphabet degree is bounded by
the image degree. -/
theorem finiteAlphabet_degree_le {x : M × (E → ℤ)} (hx : x ∈ (finiteAlphabet m).monoid) :
    (finiteAlphabet m).degree x ≤ e.degree (τ x) := by
  rw [degree_map_eq_sum m ((mem_finiteAlphabet_monoid m).mp hx).2, finiteAlphabet_degree]
  refine Finset.sum_le_sum fun α _ => ?_
  have hpos := ((mem_finiteAlphabet_monoid m).mp hx).1 α
  have hδ := e.degree_pos (hτ α) (hτ0 α)
  nlinarith

/-- If, moreover, a letter whose image has degree at least two occurs, the alphabet degree
is strictly smaller than the image degree. In particular, an allowed alphabet degree whose
image has degree at most `k + 1` has alphabet degree at most `k`. -/
theorem finiteAlphabet_degree_lt {x : M × (E → ℤ)} (hx : x ∈ (finiteAlphabet m).monoid)
    {α : E} (hα : 0 < x.2 α) (h2 : 2 ≤ e.degree (τ (letter m α))) :
    (finiteAlphabet m).degree x < e.degree (τ x) := by
  rw [degree_map_eq_sum m ((mem_finiteAlphabet_monoid m).mp hx).2, finiteAlphabet_degree]
  refine Finset.sum_lt_sum (fun β _ => ?_) ⟨α, Finset.mem_univ α, by nlinarith⟩
  have hpos := ((mem_finiteAlphabet_monoid m).mp hx).1 β
  have hδ := e.degree_pos (hτ β) (hτ0 β)
  nlinarith

/-- The finite alphabet lift: an additive map sending every letter to a nonzero allowed
degree is a positive degree map with identity cutoff modulus. -/
def finiteAlphabetLift : PositiveDegreeMap (finiteAlphabet m) e :=
  PositiveDegreeMap.ofBound τ (fun x hx => by
    rw [finiteAlphabet_monoid_eq_closure] at hx
    simpa only [AddSubmonoid.mem_comap] using
      (AddSubmonoid.closure_le (S := e.monoid.comap τ)).mpr
        (Set.range_subset_iff.mpr hτ) hx) 1
    (fun _ hx => by simpa using finiteAlphabet_degree_le m hτ hτ0 hx)

@[simp]
theorem finiteAlphabetLift_apply (x : M × (E → ℤ)) :
    finiteAlphabetLift m hτ hτ0 x = τ x := by
  unfold finiteAlphabetLift
  exact PositiveDegreeMap.ofBound_apply ..

@[simp]
theorem finiteAlphabetLift_modulus (k : ℕ) : (finiteAlphabetLift m hτ hτ0).modulus k = k := by
  unfold finiteAlphabetLift
  rw [PositiveDegreeMap.ofBound_modulus, one_mul]

end Mei.PositiveDegrees
