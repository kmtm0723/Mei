module

public import Mei.Algebra.PositiveDegrees.Graph
public import Mathlib.LinearAlgebra.Basis.Defs

/-!
# Positive degrees from an integral basis

A finite integral basis defines the monoid of nonnegative integral combinations,
graded by the sum of its coordinates. Its bounded-degree sets are finite, including
when the basis is empty. These are the degree data for completions in independent
formal variables. The construction pulls back `Mei.PositiveDegrees.orthant` along
Mathlib's `Module.Basis.equivFun`. The allowed monoid is free on the basis vectors:
`Module.Basis.positiveDegreesMonoidEquiv` identifies it with `ι →₀ ℕ`, carrying the degree
to the total degree.
For graphs in a torsion-free target, every supported primitive ray generator
already belongs to the graph monoid.
-/

public section

noncomputable section

namespace Module.Basis

variable {ι N : Type*} [Fintype ι] [AddCommGroup N] (b : Basis ι ℤ N)

/-- The nonnegative basis monoid, with coordinate-sum degree. -/
def positiveDegrees : Mei.PositiveDegrees N where
  monoid := (Mei.PositiveDegrees.orthant ι).monoid.comap b.equivFun.toAddMonoidHom
  degree := (Mei.PositiveDegrees.orthant ι).degree.comp b.equivFun.toAddMonoidHom
  degree_pos hn hne := (Mei.PositiveDegrees.orthant ι).degree_pos hn
    (fun h => hne (b.equivFun.injective (h.trans (map_zero _).symm)))
  finite_le k := (Mei.PositiveDegrees.orthant ι).finite_le k |>.preimage
    b.equivFun.injective.injOn

/-- Allowed exponents have nonnegative coordinates in the chosen basis. -/
@[simp]
theorem mem_positiveDegrees_monoid (n : N) :
    n ∈ b.positiveDegrees.monoid ↔ ∀ j, 0 ≤ b.repr n j := by
  simp [positiveDegrees, equivFun_apply]

/-- Degree is the sum of the integral basis coordinates. -/
@[simp]
theorem positiveDegrees_degree (n : N) :
    b.positiveDegrees.degree n = ∑ j, b.repr n j := by
  simp [positiveDegrees, equivFun_apply]

/-- The allowed monoid is exactly the monoid generated by the basis vectors. -/
theorem positiveDegrees_monoid_eq_closure :
    b.positiveDegrees.monoid = AddSubmonoid.closure (Set.range b) := by
  classical
  apply le_antisymm
  · intro n hn
    rw [← b.sum_repr n]
    apply AddSubmonoid.sum_mem
    intro j _
    have hj := (b.mem_positiveDegrees_monoid n).mp hn j
    have hb := AddSubmonoid.nsmul_mem (AddSubmonoid.closure (Set.range b))
      (AddSubmonoid.subset_closure (Set.mem_range_self j)) (b.repr n j).toNat
    simpa only [← Nat.cast_smul_eq_nsmul ℤ, Int.toNat_of_nonneg hj] using hb
  · apply AddSubmonoid.closure_le.mpr
    rintro _ ⟨j, rfl⟩
    simp [mem_positiveDegrees_monoid, Finsupp.single_apply, ite_nonneg]

/-- The nonnegative basis monoid is saturated under division by positive natural
multiples. -/
theorem nsmulSaturated_positiveDegrees_monoid : b.positiveDegrees.monoid.NSMulSaturated := by
  intro a n hn
  by_cases ha : a = 0
  · exact Or.inl ha
  · right
    apply (b.mem_positiveDegrees_monoid n).mpr
    intro c
    have hc := (b.mem_positiveDegrees_monoid _).mp hn c
    simp only [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul] at hc
    exact nonneg_of_mul_nonneg_right hc (by exact_mod_cast Nat.pos_of_ne_zero ha)

/-- Free natural coordinates on the nonnegative basis monoid: an allowed exponent is
recorded by its basis coordinates, which are natural numbers. -/
def positiveDegreesMonoidEquiv : b.positiveDegrees.monoid ≃+ (ι →₀ ℕ) where
  toFun n := (b.repr n).mapRange Int.toNat Int.toNat_zero
  invFun c := ⟨b.repr.symm (c.mapRange (↑) Nat.cast_zero), by simp⟩
  left_inv n := by
    ext1
    apply b.repr.injective
    ext j
    simp [Int.toNat_of_nonneg ((b.mem_positiveDegrees_monoid _).mp n.property j)]
  right_inv c := by
    ext j
    simp
  map_add' n m := by
    ext j
    simp [Int.toNat_add ((b.mem_positiveDegrees_monoid _).mp n.property j)
      ((b.mem_positiveDegrees_monoid _).mp m.property j)]

/-- The natural coordinates of an allowed exponent are its basis coordinates. -/
@[simp]
theorem positiveDegreesMonoidEquiv_apply (n : b.positiveDegrees.monoid) (j : ι) :
    b.positiveDegreesMonoidEquiv n j = (b.repr n j).toNat :=
  (rfl)

/-- The allowed exponent with natural coordinates `c` has basis coordinates `c`. -/
@[simp]
theorem repr_positiveDegreesMonoidEquiv_symm_apply (c : ι →₀ ℕ) (j : ι) :
    b.repr (b.positiveDegreesMonoidEquiv.symm c) j = c j := by
  simp [positiveDegreesMonoidEquiv]

/-- The degree of an allowed exponent is the total degree of its natural coordinates. -/
theorem positiveDegrees_degree_eq_degree_positiveDegreesMonoidEquiv
    (n : b.positiveDegrees.monoid) :
    b.positiveDegrees.degree n = ((b.positiveDegreesMonoidEquiv n).degree : ℤ) := by
  simp [Finsupp.degree_eq_sum,
    Int.toNat_of_nonneg ((b.mem_positiveDegrees_monoid _).mp n.property _)]

/-- Supported primitive generators belong to the basis graph monoid when the
target is torsion-free. This integral membership does not require real embeddings. -/
theorem supportedRay_generator_mem_positiveDegrees_graph
    {M : Type*} [AddCommGroup M] [Module.IsTorsionFree ℤ M] (f : N →+ M)
    (w : Mei.SupportedRay (b.positiveDegrees.graph f)) :
    w.generator ∈ (b.positiveDegrees.graph f).monoid := by
  let := HasUniqueDiv.of_isTorsionFree ℤ M
  exact w.generator_mem_of_nsmulSaturated
    (b.positiveDegrees.nsmulSaturated_graph_monoid f b.nsmulSaturated_positiveDegrees_monoid)

end Module.Basis
