module

public import Mathlib.Algebra.Group.Submonoid.Basic
public import Mathlib.Algebra.Order.Monoid.Defs

import Mathlib.Algebra.Order.Monoid.Unbundled.Basic

/-!
# Additive maps on the submonoid generated by a family

Let `e : κ → M` be a family in an additive monoid. If an additive map `φ` sends every `e s`
to a positive multiple of a fixed element `m`, it sends every nonzero element of the submonoid
generated by the `e s` to a positive multiple of `m`
(`AddSubmonoid.eq_zero_or_exists_nsmul_of_mem_closure_range`). If an additive map `f` to an
ordered monoid is nonnegative on every `e s`, every nonzero element of that submonoid has
`f`-value at least that of some generator
(`AddSubmonoid.eq_zero_or_exists_le_of_mem_closure_range`).
No commutativity of `M` and no finiteness of `κ` are needed.

Both statements are proved by Mathlib's `AddSubmonoid.closure_induction`.
-/

public section

namespace AddSubmonoid

variable {M κ : Type*} [AddMonoid M] {e : κ → M}

/-- If an additive map `φ` sends every generator `e s` to a positive multiple of `m`, it sends
every nonzero element of the submonoid generated by the `e s` to a positive multiple of `m`. -/
theorem eq_zero_or_exists_nsmul_of_mem_closure_range {N : Type*} [AddMonoid N] (φ : M →+ N)
    (m : N) (he : ∀ s, ∃ b : ℕ, 0 < b ∧ φ (e s) = b • m) {x : M}
    (hx : x ∈ closure (Set.range e)) :
    x = 0 ∨ ∃ b : ℕ, 0 < b ∧ φ x = b • m := by
  induction hx using closure_induction with
  | mem x hx =>
    obtain ⟨s, rfl⟩ := hx
    exact Or.inr (he s)
  | zero => exact Or.inl rfl
  | add x y _ _ hx hy =>
    rcases hx with rfl | ⟨b, hb, hxb⟩
    · simpa using hy
    rcases hy with rfl | ⟨b', hb', hyb⟩
    · simpa using Or.inr ⟨b, hb, hxb⟩
    exact Or.inr ⟨b + b', by omega, by simp only [map_add, hxb, hyb, add_nsmul]⟩

/-- If an additive map `f` to an ordered monoid is nonnegative on every generator `e s`, every
nonzero element of the submonoid generated by the `e s` has `f`-value at least that of some
generator. -/
theorem eq_zero_or_exists_le_of_mem_closure_range {A : Type*} [AddCommMonoid A] [Preorder A]
    [IsOrderedAddMonoid A] (f : M →+ A) (he : ∀ s, 0 ≤ f (e s)) {x : M}
    (hx : x ∈ closure (Set.range e)) :
    x = 0 ∨ ∃ s, f (e s) ≤ f x := by
  have hnonneg (y : M) (hy : y ∈ closure (Set.range e)) : 0 ≤ f y := by
    induction hy using closure_induction with
    | mem y hy =>
      obtain ⟨s, rfl⟩ := hy
      exact he s
    | zero => simp
    | add y z _ _ hy hz => simpa only [map_add] using add_nonneg hy hz
  induction hx using closure_induction with
  | mem x hx =>
    obtain ⟨s, rfl⟩ := hx
    exact Or.inr ⟨s, le_rfl⟩
  | zero => exact Or.inl rfl
  | add x y _ hy ihx ihy =>
    rcases ihx with rfl | ⟨s, hs⟩
    · simpa using ihy
    exact Or.inr ⟨s, by simpa only [map_add] using le_add_of_le_of_nonneg hs (hnonneg y hy)⟩

end AddSubmonoid
