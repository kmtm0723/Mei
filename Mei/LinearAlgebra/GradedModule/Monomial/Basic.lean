module

public import Mei.LinearAlgebra.Basis.Quotient
public import Mei.Algebra.DirectSum.Degree.Basic

/-!
# Monomial presentations of homogeneous modules

A monomial presentation is a basis indexed by homogeneous degrees, with each
homogeneous piece equal to the span of the corresponding basis vector. Thus
homogeneous propagation retains the entire scalar multiple of a monomial.
Discarding a set of coordinates gives a presentation on the surviving quotient
pieces; in particular this applies to degree truncations over arbitrary rings.

The quotient construction uses `Basis.quotientOfCoordinates`. Homogeneous
projection uses Mathlib's internal direct-sum decomposition and basis coordinates.
-/

public noncomputable section

namespace Mei

variable {R M ι : Type*} [Semiring R] [AddCommMonoid M] [Module R M]

/-- A basis compatible with a homogeneous decomposition into rank-one pieces.
The index type consists of the degrees present in the module. -/
@[ext]
structure MonomialPresentation (ℳ : ι → Submodule R M) where
  /-- The chosen monomials, including their scalar coordinates. -/
  basis : Module.Basis ι R M
  /-- Each homogeneous piece is generated by its chosen monomial. -/
  grade_eq_span : ∀ i, ℳ i = R ∙ basis i

namespace MonomialPresentation

variable {ℳ : ι → Submodule R M} (P : MonomialPresentation ℳ)

/-- The chosen monomial belongs to its homogeneous piece. -/
@[simp]
theorem basis_mem (i : ι) : P.basis i ∈ ℳ i := by
  rw [P.grade_eq_span]
  exact Submodule.mem_span_singleton_self _

/-- A homogeneous decoration is exactly a scalar multiple of its monomial. -/
theorem mem_grade_iff (i : ι) (x : M) :
    x ∈ ℳ i ↔ ∃ r : R, r • P.basis i = x := by
  rw [P.grade_eq_span, Submodule.mem_span_singleton]

/-- Homogeneous projection preserves the whole basis coefficient. -/
theorem coe_decompose [DecidableEq ι] [DirectSum.Decomposition ℳ] (x : M) (i : ι) :
    (DirectSum.decompose ℳ x i : M) = P.basis.repr x i • P.basis i := by
  induction x using DirectSum.Decomposition.inductionOn ℳ with
  | zero => simp
  | add x y hx hy => simp [hx, hy, add_smul]
  | @homogeneous j x =>
    obtain ⟨r, hr⟩ := (P.mem_grade_iff j x).mp x.property
    rw [← hr]
    have hx := (ℳ j).smul_mem r (P.basis_mem j)
    by_cases h : j = i
    · subst i
      rw [DirectSum.decompose_of_mem_same ℳ hx]
      simp
    · rw [DirectSum.decompose_of_mem_ne ℳ hx h]
      simp [Module.Basis.repr_self, h]

include P in
/-- The monomial pieces form an internal direct sum. -/
theorem isInternal [DecidableEq ι] : DirectSum.IsInternal ℳ := by
  let f := P.basis.constr ℕ (fun i => DirectSum.lof R ι (fun i => ℳ i) i
    ⟨P.basis i, P.basis_mem i⟩)
  have hl : (DirectSum.coeLinearMap ℳ).comp f = LinearMap.id := by
    apply P.basis.ext
    intro i
    simp [f]
  have hr : f.comp (DirectSum.coeLinearMap ℳ) = LinearMap.id := by
    apply DirectSum.linearMap_ext
    intro i
    apply LinearMap.ext
    intro x
    obtain ⟨r, hr⟩ := (P.mem_grade_iff i x).mp x.property
    have hx : x = r • (⟨P.basis i, P.basis_mem i⟩ : ℳ i) := Subtype.ext hr.symm
    rw [hx]
    simp only [LinearMap.comp_apply, LinearMap.id_apply, map_smul]
    simp [f]
  let := DirectSum.Decomposition.ofLinearMap ℳ f hl hr
  exact DirectSum.Decomposition.isInternal ℳ

/-- A degree tail discards exactly the basis coordinates below its bound. -/
theorem mem_degreeTail_iff
    (d : ι → ℤ) (k : ℕ) (x : M) :
    x ∈ Mei.DirectSum.degreeTail ℳ d k ↔ ∀ i, d i < k → P.basis.repr x i = 0 := by
  classical
  let := P.isInternal.chooseDecomposition
  rw [Mei.DirectSum.mem_degreeTail_iff]
  apply forall_congr'
  intro i
  rw [P.coe_decompose]
  refine imp_congr_right fun _ => ?_
  constructor
  · intro h
    exact P.basis.linearIndependent.smul_left_injective i (by simpa using h)
  · intro h
    simp [h]

end MonomialPresentation

variable {R M ι : Type*} [Ring R] [AddCommGroup M] [Module R M]

namespace MonomialPresentation

variable {ℳ : ι → Submodule R M} (P : MonomialPresentation ℳ)

/-- Discarding coordinates gives the corresponding monomial presentation on the
quotient's surviving homogeneous pieces. -/
def quotient (U : Submodule R M) (s : Set ι)
    (hU : ∀ x, x ∈ U ↔ ∀ i ∈ s, P.basis.repr x i = 0) :
    MonomialPresentation (fun i : s => (ℳ i).map U.mkQ) where
  basis := P.basis.quotientOfCoordinates U s hU
  grade_eq_span i := by
    rw [P.grade_eq_span, Submodule.map_span]
    simp only [Set.image_singleton, P.basis.quotientOfCoordinates_apply U s hU,
      Submodule.mkQ_apply]

/-- Truncation sends each retained monomial to the corresponding quotient monomial. -/
@[simp]
theorem quotient_basis (U : Submodule R M) (s : Set ι)
    (hU : ∀ x, x ∈ U ↔ ∀ i ∈ s, P.basis.repr x i = 0) (i : s) :
    (P.quotient U s hU).basis i = Submodule.Quotient.mk (P.basis i) :=
  P.basis.quotientOfCoordinates_apply U s hU i

/-- Surviving quotient coordinates agree with the original basis coordinates. -/
@[simp]
theorem quotient_repr_mk (U : Submodule R M) (s : Set ι)
    (hU : ∀ x, x ∈ U ↔ ∀ i ∈ s, P.basis.repr x i = 0) (x : M) (i : s) :
    (P.quotient U s hU).basis.repr (Submodule.Quotient.mk x) i = P.basis.repr x i :=
  P.basis.quotientOfCoordinates_repr_mk U s hU x i

/-- The monomial presentation of a quotient retaining degrees at most `k`.
Only the surviving degrees index its basis. -/
def degreeQuotient
    (d : ι → ℤ) (k : ℕ) :
    MonomialPresentation (fun i : {i // d i ≤ k} =>
      (ℳ i).map (Mei.DirectSum.degreeTail ℳ d (k + 1)).mkQ) :=
  P.quotient (Mei.DirectSum.degreeTail ℳ d (k + 1)) {i | d i ≤ k} (by
    intro x
    rw [P.mem_degreeTail_iff]
    simp only [Set.mem_ofPred_eq]
    exact forall_congr' fun i => imp_congr_left (by omega))

/-- Every retained monomial is the quotient class of the original monomial. -/
@[simp]
theorem degreeQuotient_basis
    (d : ι → ℤ) (k : ℕ) (i : {i // d i ≤ k}) :
    (P.degreeQuotient d k).basis i = Submodule.Quotient.mk (P.basis i) := by
  unfold degreeQuotient
  exact P.quotient_basis (Mei.DirectSum.degreeTail ℳ d (k + 1))
    {i | d i ≤ k} _ i

/-- Taking coordinates commutes with a degree truncation on every retained degree. -/
@[simp]
theorem degreeQuotient_repr_mk
    (d : ι → ℤ) (k : ℕ) (x : M) (i : {i // d i ≤ k}) :
    (P.degreeQuotient d k).basis.repr (Submodule.Quotient.mk x) i = P.basis.repr x i := by
  unfold degreeQuotient
  exact P.quotient_repr_mk (Mei.DirectSum.degreeTail ℳ d (k + 1)) {i | d i ≤ k} _ x i

end MonomialPresentation
end Mei
