module

public import Mathlib.LinearAlgebra.Prod

/-!
# Lifts through injective linear maps and common lifts along spans

A linear map `g : E →ₗ[R] W` factors through an injective linear map `f : N →ₗ[R] W` exactly
when the range of `g` lies in the range of `f` (`LinearMap.exists_comp_eq_iff_range_le`), and
then the factorization is unique. The factorization is Mathlib's `LinearMap.codLift`.

Applied to `f.prod g` for a span `U ← N → V`, this describes *common lifts*: linear maps
`ℓ : E →ₗ[R] N` with `f ∘ₗ ℓ = α` and `g ∘ₗ ℓ = β` for given `α : E →ₗ[R] U` and
`β : E →ₗ[R] V`. When the span is jointly injective, a common lift exists exactly when every
pair `(α e, β e)` lies in the joint range of the span, and it is then unique
(`LinearMap.existsUnique_comp_eq_and_comp_eq_iff`). Coefficient propagation across a face of a
scattering diagram uses such lifts: the face module is identified with the pairs of chamber
coefficients that it relates.

Common lifts reflect through a commuting morphism of spans when the maps on the
two outer modules are injective and the target lift takes values in the range of
the middle map. The reflected map is linear even when preimages are given only
pointwise.
-/

public section

namespace LinearMap

variable {R E N U V W : Type*} [Semiring R]
  [AddCommMonoid E] [Module R E] [AddCommMonoid N] [Module R N]
  [AddCommMonoid U] [Module R U] [AddCommMonoid V] [Module R V]
  [AddCommMonoid W] [Module R W]

/-- A linear map factors through an injective linear map exactly when its range is contained in
the range of that map. -/
theorem exists_comp_eq_iff_range_le {f : N →ₗ[R] W} (hf : Function.Injective f)
    {g : E →ₗ[R] W} : (∃ ℓ : E →ₗ[R] N, f ∘ₗ ℓ = g) ↔ range g ≤ range f := by
  refine ⟨?_, fun h => ⟨g.codLift f hf fun e => h ⟨e, rfl⟩, comp_codLift ..⟩⟩
  rintro ⟨ℓ, rfl⟩
  exact range_comp_le_range ℓ f

/-- Two products of linear maps are equal exactly when their components are. -/
@[simp]
theorem prod_eq_prod_iff {f f' : N →ₗ[R] U} {g g' : N →ₗ[R] V} :
    f.prod g = f'.prod g' ↔ f = f' ∧ g = g' := by
  simp [LinearMap.ext_iff, Prod.ext_iff, forall_and]

/-- Along a jointly injective span `U ← N → V`, two maps `α : E → U` and `β : E → V` have a
common lift to `N` exactly when every pair `(α e, β e)` lies in the joint range of the span; the
common lift is then unique. -/
theorem existsUnique_comp_eq_and_comp_eq_iff {f : N →ₗ[R] U} {g : N →ₗ[R] V}
    (hfg : Function.Injective (f.prod g)) {α : E →ₗ[R] U} {β : E →ₗ[R] V} :
    (∃! ℓ : E →ₗ[R] N, f ∘ₗ ℓ = α ∧ g ∘ₗ ℓ = β) ↔ ∀ e, (α e, β e) ∈ range (f.prod g) := by
  simp_rw [← prod_eq_prod_iff, ← prod_comp]
  constructor
  · rintro ⟨ℓ, hℓ, -⟩ e
    exact ⟨ℓ e, by simpa using congr($hℓ e)⟩
  · intro h
    exact ⟨(α.prod β).codLift _ hfg fun e => h e, comp_codLift .., fun ℓ hℓ =>
      (cancel_left hfg).1 (hℓ.trans (comp_codLift ..).symm)⟩

/-- A common lift of one input through a jointly injective span extends uniquely
to a linear common lift on the cyclic submodule generated by that input. -/
theorem existsUnique_comp_eq_and_comp_eq_on_span_singleton
    {f : N →ₗ[R] U} {g : N →ₗ[R] V} (hfg : Function.Injective (f.prod g))
    {α : E →ₗ[R] U} {β : E →ₗ[R] V} (a : E)
    (ha : (α a, β a) ∈ range (f.prod g)) :
    ∃! ℓ : Submodule.span R {a} →ₗ[R] N,
      f.comp ℓ = α.comp (Submodule.span R {a}).subtype ∧
        g.comp ℓ = β.comp (Submodule.span R {a}).subtype := by
  apply (existsUnique_comp_eq_and_comp_eq_iff hfg).mpr
  have hspan : Submodule.span R {a} ≤ (range (f.prod g)).comap (α.prod β) :=
    (Submodule.span_singleton_le_iff_mem _ _).mpr ha
  exact fun z => hspan z.property

/-- Let `(n, u, v)` be a commuting morphism of spans, with `u` and `v`
injective and the source span `(f, g)` jointly injective. A target common lift
`ℓ'` of `u ∘ₗ α` and `v ∘ₗ β` whose values lie in `range n` reflects to a source
common lift `ℓ`, with `n ∘ₗ ℓ = ℓ'`. -/
theorem exists_comp_eq_and_comp_eq_of_injective_comp
    {N' U' V' : Type*} [AddCommMonoid N'] [Module R N']
    [AddCommMonoid U'] [Module R U'] [AddCommMonoid V'] [Module R V']
    {f : N →ₗ[R] U} {g : N →ₗ[R] V} {f' : N' →ₗ[R] U'} {g' : N' →ₗ[R] V'}
    (n : N →ₗ[R] N') (u : U →ₗ[R] U') (v : V →ₗ[R] V')
    (hf : f'.comp n = u.comp f) (hg : g'.comp n = v.comp g)
    (hu : Function.Injective u) (hv : Function.Injective v)
    (hfg : Function.Injective (f.prod g))
    {α : E →ₗ[R] U} {β : E →ₗ[R] V} (ℓ' : E →ₗ[R] N')
    (hα : f'.comp ℓ' = u.comp α) (hβ : g'.comp ℓ' = v.comp β)
    (hpre : ∀ a, ℓ' a ∈ range n) :
    ∃ ℓ : E →ₗ[R] N, f.comp ℓ = α ∧ g.comp ℓ = β ∧ n.comp ℓ = ℓ' := by
  have hn : Function.Injective n := by
    intro x y hxy
    apply hfg
    apply Prod.ext
    · apply hu
      exact (LinearMap.congr_fun hf x).symm.trans
        ((congrArg f' hxy).trans (LinearMap.congr_fun hf y))
    · apply hv
      exact (LinearMap.congr_fun hg x).symm.trans
        ((congrArg g' hxy).trans (LinearMap.congr_fun hg y))
  obtain ⟨ℓ, hℓ⟩ := (exists_comp_eq_iff_range_le hn).mpr (fun _ ⟨a, ha⟩ => ha ▸ hpre a)
  refine ⟨ℓ, (cancel_left hu).mp ?_, (cancel_left hv).mp ?_, hℓ⟩
  · rw [← comp_assoc, ← hf, comp_assoc, hℓ, hα]
  · rw [← comp_assoc, ← hg, comp_assoc, hℓ, hβ]

end LinearMap
