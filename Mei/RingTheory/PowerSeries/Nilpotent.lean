module

public import TauCeti.RingTheory.PowerSeries.Substitution
public import Mathlib.RingTheory.Adjoin.Singleton
public import Mathlib.Algebra.Group.Semiconj.Basic
import TauCeti.RingTheory.PowerSeries.Evaluation

/-!
# Power series evaluation at nilpotent elements

Scalar power series can be evaluated at a nilpotent element of an associative algebra.
The target need not be commutative: substitution takes place in the commutative subalgebra
generated by that element, then its value is included in the ambient algebra.

The construction reuses Mathlib's substitution algebra homomorphism and singleton adjoin,
and Tau Ceti's nilpotent-constant substitution and truncation formula. No topology is used.
-/

public section

namespace PowerSeries

variable {R A B : Type*} [CommRing R] [Ring A] [Ring B] [Algebra R A] [Algebra R B]

/-- Evaluate scalar power series at a nilpotent element of an associative algebra. -/
noncomputable def nilpotentAeval {x : A} (hx : IsNilpotent x) : R⟦X⟧ →ₐ[R] A := by
  let S := Algebra.adjoin R ({x} : Set A)
  let a : S := ⟨x, Algebra.subset_adjoin (by simp)⟩
  have ha : IsNilpotent a :=
    (IsNilpotent.map_iff (f := S.val) Subtype.val_injective).mp hx
  let ev : R⟦X⟧ →+* S := constantCoeff.comp (substAlgHom (HasSubst.C ha)).toRingHom
  exact
    { S.val.toRingHom.comp ev with
      commutes' r := by
        -- The structure extension stores the underlying function as a `toFun` field.
        -- Expose its two compositions; `RingHom.comp_apply` cannot rewrite that field.
        change S.val (constantCoeff ((substAlgHom (HasSubst.C ha))
          (algebraMap R R⟦X⟧ r))) = _
        rw [AlgHom.commutes]
        simp [MvPowerSeries.algebraMap_apply, constantCoeff_eq] }

/-- Evaluation at an element whose `n`th power vanishes uses the truncation below `n`. -/
theorem nilpotentAeval_eq_aeval_trunc {x : A} (hx : IsNilpotent x) {n : ℕ}
    (hn : x ^ n = 0) (f : R⟦X⟧) :
    nilpotentAeval hx f = Polynomial.aeval x (trunc n f) := by
  let S := Algebra.adjoin R ({x} : Set A)
  let a : S := ⟨x, Algebra.subset_adjoin (by simp)⟩
  have ha : a ^ n = 0 := Subtype.ext hn
  simp only [nilpotentAeval, AlgHom.coe_mk, RingHom.coe_comp, Function.comp_apply,
    AlgHom.toRingHom_eq_coe, RingHom.coe_coe, coe_substAlgHom]
  rw [subst_C_eq_C_aeval_trunc ha, constantCoeff_C]
  exact (Polynomial.aeval_algHom_apply S.val a (trunc n f)).symm

/-- Nilpotent evaluation is the finite sum of scalar coefficients times powers. -/
theorem nilpotentAeval_eq_sum {x : A} (hx : IsNilpotent x) {n : ℕ}
    (hn : x ^ n = 0) (f : R⟦X⟧) :
    nilpotentAeval hx f = ∑ i ∈ Finset.range n, coeff i f • x ^ i := by
  rw [nilpotentAeval_eq_aeval_trunc hx hn, Polynomial.aeval_def,
    eval₂_trunc_eq_sum_range]
  simp only [Algebra.smul_def]

/-- Algebra homomorphisms commute with evaluation at nilpotent elements. -/
theorem map_nilpotentAeval (φ : A →ₐ[R] B) {x : A} (hx : IsNilpotent x)
    (f : R⟦X⟧) :
    φ (nilpotentAeval hx f) = nilpotentAeval (hx.map φ) f := by
  let n := hx.choose
  have hn : x ^ n = 0 := hx.choose_spec
  have hφ : φ x ^ n = 0 := by rw [← map_pow, hn, map_zero]
  rw [nilpotentAeval_eq_aeval_trunc _ hn, nilpotentAeval_eq_aeval_trunc _ hφ]
  exact (Polynomial.aeval_algHom_apply φ x (trunc n f)).symm

/-- Constants evaluate to their scalar images. -/
@[simp]
theorem nilpotentAeval_C {x : A} (hx : IsNilpotent x) (r : R) :
    nilpotentAeval hx (C r) = algebraMap R A r :=
  (nilpotentAeval hx).commutes r

/-- The variable evaluates to the chosen nilpotent element. -/
@[simp]
theorem nilpotentAeval_X {x : A} (hx : IsNilpotent x) :
    nilpotentAeval (R := R) hx X = x := by
  let n := hx.choose
  have hn : x ^ n = 0 := hx.choose_spec
  have hn' : x ^ (n + 2) = 0 := by rw [pow_add, hn, zero_mul]
  rw [nilpotentAeval_eq_aeval_trunc _ hn']
  simp

/-- On polynomials, nilpotent evaluation is ordinary polynomial algebra evaluation. -/
@[simp]
theorem nilpotentAeval_coe {x : A} (hx : IsNilpotent x) (p : Polynomial R) :
    nilpotentAeval hx (p : R⟦X⟧) = Polynomial.aeval x p := by
  rw [algHom_coe_eq_aeval, nilpotentAeval_X]

/-- A scalar commutation factor rescales every series evaluated at a nilpotent element. -/
theorem nilpotentAeval_mul_of_semiconj {x : A} (hx : IsNilpotent x) (y : A) (a : R)
    (h : SemiconjBy y (a • x) x) (f : R⟦X⟧) :
    nilpotentAeval hx f * y = y * nilpotentAeval hx (rescale a f) := by
  let n := hx.choose
  have hn : x ^ n = 0 := hx.choose_spec
  rw [nilpotentAeval_eq_sum _ hn, nilpotentAeval_eq_sum _ hn,
    Finset.sum_mul, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  simpa only [coeff_rescale, smul_pow, smul_smul, smul_mul_assoc, mul_smul_comm,
    mul_comm (a ^ i)] using
    congrArg (fun z : A => coeff i f • z) (h.pow_right i).eq.symm

end PowerSeries
