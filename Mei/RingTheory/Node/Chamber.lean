module

public import Mei.RingTheory.Node.SlabMap
public import Mei.RingTheory.AdjoinRoot.Laurent

/-!
# Laurent realizations of truncated nodal chambers

When `t^(k+1) = 0`, the two Laurent maps of `R[x,y]/(xy-t)` descend to
the chambers truncated by `y^(k+1)` and `x^(k+1)`. They are injective if the
annihilator of each `t^i` is generated by `t^(k+1-i)`. We discharge this condition
for the parameter in `(K[t]/(t^(k+1)))[w,w⁻¹]` over any commutative ring `K`.
It need not hold for an arbitrary nilpotent element. The resulting maps commute
with coefficient change and cutoff reduction and identify the slab projections
with the usual Laurent maps.

We use `normalFormBasis`, `mem_span_coord_one_pow_iff` and
`mem_span_coord_zero_pow_iff` to read the kernels without dividing by `t`.
The chamber interpretation follows Gross–Siebert, *An Invitation to Toric
Degenerations*, §2.3 (arXiv:0808.2749v2).
-/

public noncomputable section

namespace Mei.NodeAlgebra

open TauCeti TauCeti.NodeAlgebra _root_.LaurentPolynomial

variable {R : Type*} [CommRing R] {t : R} {k : ℕ}

/-- The left chamber map `x ↦ T`, `y ↦ t T⁻¹`. -/
def leftChamberLaurentMap (ht : t ^ (k + 1) = 0) : LeftChamber t k →ₐ[R] R[T;T⁻¹] :=
  Ideal.Quotient.liftₐ _ (leftLaurentMap t) fun z hz => by
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    simp [mul_pow, ← map_pow C, ht]

/-- The right chamber map `x ↦ t T⁻¹`, `y ↦ T`. -/
def rightChamberLaurentMap (ht : t ^ (k + 1) = 0) : RightChamber t k →ₐ[R] R[T;T⁻¹] :=
  Ideal.Quotient.liftₐ _ (rightLaurentMap t) fun z hz => by
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    simp [mul_pow, ← map_pow C, ht]

@[simp]
theorem leftChamberLaurentMap_mk (ht : t ^ (k + 1) = 0) (z : NodeAlgebra R t) :
    leftChamberLaurentMap ht (Ideal.Quotient.mk _ z) = leftLaurentMap t z := (rfl)

@[simp]
theorem rightChamberLaurentMap_mk (ht : t ^ (k + 1) = 0) (z : NodeAlgebra R t) :
    rightChamberLaurentMap ht (Ideal.Quotient.mk _ z) = rightLaurentMap t z := (rfl)

/-- The left Laurent map is injective when powers of `t` have the expected
annihilators. This includes the truncated polynomial parameter over any base ring. -/
theorem leftChamberLaurentMap_injective (ht : t ^ (k + 1) = 0)
    (hann : ∀ (i : ℕ) (c : R), t ^ i * c = 0 → t ^ (k + 1 - i) ∣ c) :
    Function.Injective (leftChamberLaurentMap ht) := by
  unfold leftChamberLaurentMap
  refine RingHom.lift_injective_of_ker_le_ideal _ _ ?_
  intro z hz
  rw [RingHom.mem_ker, AlgHom.coe_toRingHom] at hz
  rw [mem_span_coord_one_pow_iff ht]
  refine ⟨fun n => by simp [hz], fun d => ?_⟩
  have h := congrArg (fun p : R[T;T⁻¹] => p.coeff (-(d + 1 : ℤ))) hz
  rw [coeff_leftLaurentMap_neg_succ] at h
  simpa only [Nat.add_sub_add_right] using hann (d + 1) _ h

/-- The right Laurent map is injective under the same annihilator condition. -/
theorem rightChamberLaurentMap_injective (ht : t ^ (k + 1) = 0)
    (hann : ∀ (i : ℕ) (c : R), t ^ i * c = 0 → t ^ (k + 1 - i) ∣ c) :
    Function.Injective (rightChamberLaurentMap ht) := by
  unfold rightChamberLaurentMap
  refine RingHom.lift_injective_of_ker_le_ideal _ _ ?_
  intro z hz
  rw [RingHom.mem_ker, AlgHom.coe_toRingHom] at hz
  rw [mem_span_coord_zero_pow_iff ht]
  refine ⟨fun d => by simp [hz], fun n => ?_⟩
  apply hann n
  have h := congrArg (fun p : R[T;T⁻¹] => p.coeff (-(n : ℤ))) hz
  simpa only [coeff_rightLaurentMap_neg, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply] using h

section Comparison

variable (f : R) (ht : t ^ (k + 1) = 0)

/-- The first slab projection followed by the chamber realization is the left
Laurent map of the node with parameter `tf`. -/
@[simp]
theorem leftChamberLaurentMap_toSlabAlgebra (z : NodeAlgebra R (t * f)) :
    leftChamberLaurentMap ht (toSlabAlgebra t f k z).val.1 =
      leftLaurentMap (t * f) z := by
  have h : (leftChamberLaurentMap ht).comp
      ((AlgHom.fst R _ _).comp ((slabAlgebra t f k).val.comp (toSlabAlgebra t f k))) =
      leftLaurentMap (t * f) := by
    apply TauCeti.NodeAlgebra.hom_ext <;>
      simp only [AlgHom.comp_apply, AlgHom.fst_apply, Subalgebra.val_apply,
        coe_toSlabAlgebra_coord_zero, coe_toSlabAlgebra_coord_one,
        leftChamberLaurentMap_mk, map_mul, AlgHom.commutes,
        leftLaurentMap_coord_zero, leftLaurentMap_coord_one, C_eq_algebraMap]; ring
  exact AlgHom.congr_fun h z

/-- The second slab projection followed by the chamber realization is the right
Laurent map of the node with parameter `tf`. -/
@[simp]
theorem rightChamberLaurentMap_toSlabAlgebra (z : NodeAlgebra R (t * f)) :
    rightChamberLaurentMap ht (toSlabAlgebra t f k z).val.2 =
      rightLaurentMap (t * f) z := by
  have h : (rightChamberLaurentMap ht).comp
      ((AlgHom.snd R _ _).comp ((slabAlgebra t f k).val.comp (toSlabAlgebra t f k))) =
      rightLaurentMap (t * f) := by
    apply TauCeti.NodeAlgebra.hom_ext <;>
      simp only [AlgHom.comp_apply, AlgHom.snd_apply, Subalgebra.val_apply,
        coe_toSlabAlgebra_coord_zero, coe_toSlabAlgebra_coord_one,
        rightChamberLaurentMap_mk, map_mul, AlgHom.commutes,
        rightLaurentMap_coord_zero, rightLaurentMap_coord_one, C_eq_algebraMap]; ring
  exact AlgHom.congr_fun h z

end Comparison

section Naturality

variable {R' : Type*} [CommRing R'] [Algebra R R'] {t' : R'} {k' : ℕ}
  (ht : algebraMap R R' t = t') (hk : k' ≤ k)
  (h₀ : t ^ (k + 1) = 0) (h₀' : t' ^ (k' + 1) = 0)

open scoped AlgebraMonoidAlgebra

/-- Left Laurent realization commutes with coefficient change and cutoff reduction. -/
@[simp]
theorem leftChamberLaurentMap_leftChamberMap (z : LeftChamber t k) :
    leftChamberLaurentMap h₀' (leftChamberMap t ht hk z) =
      AddMonoidAlgebra.mapAlgHom ℤ (Algebra.ofId R R') (leftChamberLaurentMap h₀ z) := by
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
  simp only [leftChamberMap_mk, leftChamberLaurentMap_mk]
  subst t'
  simpa only [mapOfEq_rfl, mapAlgHom_apply] using
    leftLaurentMap_map t z

/-- Right Laurent realization commutes with coefficient change and cutoff reduction. -/
@[simp]
theorem rightChamberLaurentMap_rightChamberMap (z : RightChamber t k) :
    rightChamberLaurentMap h₀' (rightChamberMap t ht hk z) =
      AddMonoidAlgebra.mapAlgHom ℤ (Algebra.ofId R R') (rightChamberLaurentMap h₀ z) := by
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
  simp only [rightChamberMap_mk, rightChamberLaurentMap_mk]
  subst t'
  simpa only [mapOfEq_rfl, mapAlgHom_apply] using
    rightLaurentMap_map t z

end Naturality

section TruncatedPolynomial

variable (K : Type*) [CommRing K] (k : ℕ)

local notation "S" => AdjoinRoot (Polynomial.X ^ (k + 1) : Polynomial K)
local notation "τ" => AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K)

/-- The left chamber over `(K[t]/(t^(k+1)))[w,w⁻¹]` embeds faithfully in its
Laurent model, including when `K` has zero divisors. -/
theorem leftChamberLaurentMap_injective_truncatedPolynomial :
    Function.Injective (leftChamberLaurentMap (t := (C τ : S[T;T⁻¹])) (k := k) (by
      rw [← map_pow, ← AdjoinRoot.mk_X, ← map_pow, AdjoinRoot.mk_self, map_zero])) := by
  apply leftChamberLaurentMap_injective
  intro i p h
  exact (C_root_X_pow_pow_mul_eq_zero_iff p).mp h

/-- The right chamber over `(K[t]/(t^(k+1)))[w,w⁻¹]` embeds faithfully in its
Laurent model. These two embeddings realize the truncated focus-focus chambers. -/
theorem rightChamberLaurentMap_injective_truncatedPolynomial :
    Function.Injective (rightChamberLaurentMap (t := (C τ : S[T;T⁻¹])) (k := k) (by
      rw [← map_pow, ← AdjoinRoot.mk_X, ← map_pow, AdjoinRoot.mk_self, map_zero])) := by
  apply rightChamberLaurentMap_injective
  intro i p h
  exact (C_root_X_pow_pow_mul_eq_zero_iff p).mp h

end TruncatedPolynomial

end Mei.NodeAlgebra
