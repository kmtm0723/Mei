public import Mei.RingTheory.AdjoinRoot.Basic
public import Mei.Algebra.Polynomial.Laurent

/-!
# Truncated polynomial parameters in Laurent algebras

In `(R[t]/(t^n))[w,w⁻¹]`, the annihilator of `t^i` is the principal ideal
generated by `t^(n-i)`. No domain hypothesis on `R` is needed.
This lets the Laurent coefficient algebra retain the exact annihilators used
to realize truncated nodal chambers faithfully.

We combine `AdjoinRoot.root_X_pow_pow_mul_eq_zero_iff` with the coefficientwise
divisibility criterion `Mei.LaurentPolynomial.C_dvd_iff_dvd_coeff`.

Coefficient homomorphisms and cutoff reductions also induce maps between these
Laurent algebras, using Mathlib's `AdjoinRoot.map` coefficientwise. Their rules on
constants and Laurent monomials, together with identity and composition laws,
let these coefficient algebras form quotient towers.
-/

public section

namespace LaurentPolynomial

open AddMonoidAlgebra

variable {R : Type*} [CommRing R] {n i : ℕ}

/-- Laurent extension preserves the vanishing power of the truncated polynomial parameter. -/
@[simp]
theorem C_root_X_pow_pow (R : Type*) [CommRing R] (n : ℕ) :
    (C (AdjoinRoot.root (Polynomial.X ^ n : Polynomial R)) :
      (AdjoinRoot (Polynomial.X ^ n : Polynomial R))[T;T⁻¹]) ^ n = 0 := by
  rw [← map_pow, AdjoinRoot.root_X_pow_pow, map_zero]

/-- Laurent extension preserves the annihilator of a power of the truncated
polynomial parameter. -/
theorem C_root_X_pow_pow_mul_eq_zero_iff
    (p : (AdjoinRoot (Polynomial.X ^ n : Polynomial R))[T;T⁻¹]) :
    C (AdjoinRoot.root (Polynomial.X ^ n : Polynomial R)) ^ i * p = 0 ↔
      C (AdjoinRoot.root (Polynomial.X ^ n : Polynomial R)) ^ (n - i) ∣ p := by
  by_cases hi : i ≤ n
  · rw [← map_pow C, ← map_pow C, Mei.LaurentPolynomial.C_dvd_iff_dvd_coeff]
    constructor
    · intro h j
      apply (AdjoinRoot.root_X_pow_pow_mul_eq_zero_iff hi _).mp
      have hcoeff := congrArg (fun q => q.coeff j) h
      simpa only [← single_eq_C, coeff_single_zero_mul, coeff_zero,
        Finsupp.zero_apply] using hcoeff
    · intro h
      apply LaurentPolynomial.ext
      intro j
      simp only [← single_eq_C, coeff_single_zero_mul, coeff_zero, Finsupp.zero_apply]
      exact (AdjoinRoot.root_X_pow_pow_mul_eq_zero_iff hi _).mpr (h j)
  · have hn : (C (AdjoinRoot.root (Polynomial.X ^ n : Polynomial R)) :
        (AdjoinRoot (Polynomial.X ^ n : Polynomial R))[T;T⁻¹]) ^ n = 0 := by
      exact C_root_X_pow_pow R n
    have hni : n ≤ i := by omega
    simp [pow_eq_zero_of_le hni hn, Nat.sub_eq_zero_of_le hni]

end LaurentPolynomial

namespace Mei.LaurentPolynomial

open AddMonoidAlgebra
open scoped _root_.LaurentPolynomial

variable {K K' K'' : Type*} [CommRing K] [CommRing K'] [CommRing K'']
  {k l m : ℕ} (φ : K →+* K') (hl : l ≤ k)

local notation "S" => AdjoinRoot (Polynomial.X ^ (k + 1) : Polynomial K)
local notation "S'" => AdjoinRoot (Polynomial.X ^ (l + 1) : Polynomial K')
local notation "τ" => AdjoinRoot.root (Polynomial.X ^ (k + 1) : Polynomial K)
local notation "τ'" => AdjoinRoot.root (Polynomial.X ^ (l + 1) : Polynomial K')

include hl in
private theorem X_pow_dvd_map_X_pow :
    (Polynomial.X ^ (l + 1) : Polynomial K') ∣ (Polynomial.X ^ (k + 1) : Polynomial K).map φ := by
  simpa using pow_dvd_pow _ (by omega)

/-- The truncated scalar reduction `S[ℤ] → S'[ℤ]`, applying `AdjoinRoot.map` coefficientwise. -/
noncomputable def truncatedScalarMap : S[ℤ] →+* S'[ℤ] :=
  mapRingHom ℤ (AdjoinRoot.map φ _ _ (X_pow_dvd_map_X_pow φ hl))

/-- Cutoff reduction of truncated Laurent rings as an algebra homomorphism over
the unchanged coefficient ring. -/
noncomputable def truncatedScalarAlgHom (K : Type*) [CommRing K] {k l : ℕ} (hl : l ≤ k) :
    (AdjoinRoot (Polynomial.X ^ (k + 1) : Polynomial K))[ℤ] →ₐ[K]
      (AdjoinRoot (Polynomial.X ^ (l + 1) : Polynomial K))[ℤ] :=
  mapAlgHom ℤ (AdjoinRoot.mapAlgHom (AlgHom.id K K) _ _
    (X_pow_dvd_map_X_pow (RingHom.id K) hl))

/-- The algebra cutoff reduction has the existing scalar reduction as its underlying ring map. -/
@[simp]
theorem truncatedScalarAlgHom_toRingHom :
    (truncatedScalarAlgHom K hl : _ →+* _) = truncatedScalarMap (RingHom.id K) hl := (rfl)

/-- The truncated scalar reduction sends the truncated parameter to the truncated parameter. -/
@[simp]
theorem truncatedScalarMap_C_root :
    truncatedScalarMap φ hl (_root_.LaurentPolynomial.C τ) = _root_.LaurentPolynomial.C τ' := by
  simp only [truncatedScalarMap, ← _root_.LaurentPolynomial.single_eq_C, mapRingHom_single,
    AdjoinRoot.map_root]

/-- The truncated scalar reduction changes constant scalars by `φ`. -/
@[simp]
theorem truncatedScalarMap_C_of (r : K) :
    truncatedScalarMap φ hl (_root_.LaurentPolynomial.C (AdjoinRoot.of _ r)) =
      _root_.LaurentPolynomial.C (AdjoinRoot.of _ (φ r)) := by
  simp only [truncatedScalarMap, ← _root_.LaurentPolynomial.single_eq_C, mapRingHom_single,
    AdjoinRoot.map_of]

/-- The truncated scalar reduction fixes the Laurent monomials. -/
@[simp]
theorem truncatedScalarMap_T (b : ℤ) :
    truncatedScalarMap φ hl (_root_.LaurentPolynomial.T b) = _root_.LaurentPolynomial.T b := by
  simp only [truncatedScalarMap, _root_.LaurentPolynomial.T, mapRingHom_single, map_one]

/-- Changing neither coefficients nor cutoff gives the identity scalar map. -/
@[simp]
theorem truncatedScalarMap_id :
    truncatedScalarMap (RingHom.id K) (k := k) le_rfl = RingHom.id _ := by
  rw [truncatedScalarMap, ← mapRingHom_id]
  congr 1
  ext <;> simp

/-- Truncated scalar reductions compose in the expected order. -/
theorem truncatedScalarMap_comp (ψ : K' →+* K'') (hm : m ≤ l) :
    (truncatedScalarMap ψ hm).comp (truncatedScalarMap φ hl) =
      truncatedScalarMap (ψ.comp φ) (hm.trans hl) := by
  simp only [truncatedScalarMap, ← mapRingHom_comp]
  congr 1
  ext <;> simp

end Mei.LaurentPolynomial
