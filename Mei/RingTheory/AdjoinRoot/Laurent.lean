module

public import TauCeti.RingTheory.AdjoinRoot.Basic
public import Mei.Algebra.Polynomial.Laurent

/-!
# Annihilators of truncated polynomial parameters in Laurent algebras

In `(R[t]/(t^n))[w,w⁻¹]`, the annihilator of `t^i` is the principal ideal
generated by `t^(n-i)`. No domain hypothesis on `R` is needed.
This lets the Laurent coefficient algebra retain the exact annihilators used
to realize truncated nodal chambers faithfully.

We combine `AdjoinRoot.root_X_pow_pow_mul_eq_zero_iff` with the coefficientwise
divisibility criterion `Mei.LaurentPolynomial.C_dvd_iff_dvd_coeff`.
-/

public section

namespace LaurentPolynomial

open AddMonoidAlgebra

variable {R : Type*} [CommRing R] {n i : ℕ}

/-- Laurent extension preserves the annihilator of a power of the truncated
polynomial parameter. -/
theorem C_root_X_pow_pow_mul_eq_zero_iff
    (p : (AdjoinRoot (Polynomial.X ^ n : Polynomial R))[T;T⁻¹]) :
    C (AdjoinRoot.root (Polynomial.X ^ n : Polynomial R)) ^ i * p = 0 ↔
      C (AdjoinRoot.root (Polynomial.X ^ n : Polynomial R)) ^ (n - i) ∣ p := by
  by_cases hi : i ≤ n
  · rw [← map_pow C, ← map_pow C, Mei.LaurentPolynomial.C_dvd_iff_dvd_coeff]
    constructor
    · intro h j
      apply (AdjoinRoot.root_X_pow_pow_mul_eq_zero_iff hi _).mp
      have hcoeff := congrArg (fun q => q.coeff j) h
      simpa only [← single_eq_C, coeff_single_zero_mul, coeff_zero,
        Finsupp.zero_apply] using hcoeff
    · intro h
      apply LaurentPolynomial.ext
      intro j
      simp only [← single_eq_C, coeff_single_zero_mul, coeff_zero, Finsupp.zero_apply]
      exact (AdjoinRoot.root_X_pow_pow_mul_eq_zero_iff hi _).mpr (h j)
  · have hn : (C (AdjoinRoot.root (Polynomial.X ^ n : Polynomial R)) :
        (AdjoinRoot (Polynomial.X ^ n : Polynomial R))[T;T⁻¹]) ^ n = 0 := by
      rw [← map_pow, ← AdjoinRoot.mk_X, ← map_pow, AdjoinRoot.mk_self, map_zero]
    have hni : n ≤ i := by omega
    simp [pow_eq_zero_of_le hni hn, Nat.sub_eq_zero_of_le hni]

end LaurentPolynomial
